<div class="searchable-select">
    <input type="search" class="form-control form-control-sm mb-1" aria-label="@($"Search {Label}")" data-helper="Filter choices by name or full path. Your current selection is retained until you choose another option."
           placeholder="@SearchPlaceholder" disabled="@Disabled" @bind="query" @bind:event="oninput" />
    <select id="@Id" class="form-select form-select-sm" aria-label="@Label" data-helper="Choose a matching entry. Use the search field above to narrow the list." disabled="@Disabled" value="@Value" @onchange="Changed">
        <option value="">@Placeholder</option>
        @if (!string.IsNullOrEmpty(Value) && !Visible.Contains(Value, StringComparer.OrdinalIgnoreCase))
        {
            <option value="@Value">@Value (current)</option>
        }
        @foreach (var option in Visible)
        {
            <option value="@option">@option</option>
        }
    </select>
    @if (matches > Limit)
    {
        <small class="text-muted" role="status">Showing @Limit of @matches matches. Refine your search.</small>
    }
    else if (matches == 0)
    {
        <small class="text-muted" role="status">No matching options.</small>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public IEnumerable<string> Options { get; set; } = [];
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Label { get; set; } = "Option";
    [Parameter] public string SearchPlaceholder { get; set; } = "Search by name or full path?";
    [Parameter] public string Placeholder { get; set; } = "Choose an option…";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> ValueChanged { get; set; }
    private const int Limit = 200;
    private string query = "";
    private int matches;
    private string[] Visible
    {
        get
        {
            var filtered = Options.Where(x => x.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase))
                .Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
            matches = filtered.Length;
            return filtered.Take(Limit).ToArray();
        }
    }
    private Task Changed(ChangeEventArgs args) => ValueChanged.InvokeAsync(args);
}
