    private async Task OnAnimTypeChanged(ChangeEventArgs e)
    {
        isOscillating = e.Value?.ToString() == "osc";
        if (isOscillating && minAngle == 0 && maxAngle == 0)
        {
            minAngle = -45;
            maxAngle = 45;
        }
        await OnKinematicChanged();
