    private async Task UploadIcon(InputFileChangeEventArgs e)
    {
        if (itemModel == null || e.File == null) return;

        var extension = Path.GetExtension(e.File.Name).ToLowerInvariant();
        if (extension is not ".jpg" and not ".jpeg" and not ".png" and not ".webp")
        {
            iconStatus = "Use a JPG, PNG or WebP image.";
            return;
        }

        if (e.File.Size > 2 * 1024 * 1024)
        {
            iconStatus = "Het pictogram mag maximaal 2 MB groot zijn.";
            return;
        }

        using var stream = new MemoryStream();
        await e.File.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024).CopyToAsync(stream);
        var normalized = await JS.InvokeAsync<NormalizedIcon>("normalizeIcon", stream.ToArray(), 64);
        ApplyIconPixels(normalized.Pixels, 64, 64);
        iconFileName = e.File.Name;
        itemModel.IconWebP = Convert.FromBase64String(normalized.WebPBase64);
        iconStatus = "Icon normalized to 64x64 and stored in the item model.";
        iconPreviewPending = true;
        StateHasChanged();
    }

    private async Task RenderIconPreview()
    {
        if (itemModel?.Icon == null) return;
        var pixels = new int[64 * 64 * 4];
        for (var y = 0; y < 64; y++)
        {
            for (var x = 0; x < 64; x++)
            {
                var color = itemModel.Icon[y, x];
                var offset = (y * 64 + x) * 4;
                pixels[offset] = (int)Math.Clamp(color.R, 0, 255);
                pixels[offset + 1] = (int)Math.Clamp(color.G, 0, 255);
                pixels[offset + 2] = (int)Math.Clamp(color.B, 0, 255);
                pixels[offset + 3] = (int)Math.Clamp(color.A, 0, 255);
            }
        }
        await JS.InvokeVoidAsync("renderIconPreview", "iconPreviewCanvas", pixels, 64, 64);
    }

    private void ApplyIconPixels(int[] pixels, int width, int height)
    {
        var icon = new GBX.NET.Color[width, height];
        for (var y = 0; y < height; y++)
        {
            for (var x = 0; x < width; x++)
            {
                var offset = (y * width + x) * 4;
                icon[y, x] = new GBX.NET.Color(
                    pixels[offset], pixels[offset + 1], pixels[offset + 2], pixels[offset + 3]);
            }
        }
        itemModel!.Icon = icon;
    }

