    private static string DescribeMeshFunction(ModelPart part, MeshPartConfig cfg)
    {
        if (!cfg.Enabled) return "Disabled in preview.";
        var roles = new List<string>();
        if (cfg.Visible) roles.Add("Visible mesh");
        if (cfg.Collidable) roles.Add("Collidable");
        if (cfg.Waypoint) roles.Add("Waypoint / trigger");
        if (cfg.Effect) roles.Add("Effect");
        if (cfg.Movable || part.IsMoving) roles.Add("Movable / kinematic");
        if (roles.Count == 0) roles.Add("Configured part");
        return string.Join(" · ", roles);
    }

    private void SyncMeshPartModes()
    {
        var valid = modelParts.Select(part => part.Path).ToHashSet(StringComparer.Ordinal);
        foreach (var key in meshPartModes.Keys.Where(key => !valid.Contains(key)).ToArray())
            meshPartModes.Remove(key);
        foreach (var key in meshPartConfigs.Keys.Where(key => !valid.Contains(key)).ToArray())
            meshPartConfigs.Remove(key);
        foreach (var part in modelParts)
        {
            if (!meshPartModes.ContainsKey(part.Path))
                meshPartModes[part.Path] = "auto";
            if (!meshPartConfigs.ContainsKey(part.Path))
                meshPartConfigs[part.Path] = new MeshPartConfig
                {
                    Enabled = true,
                    Visible = true,
                    Movable = part.IsMoving
                };
        }
        if (selectedMeshPartPath is not null && !valid.Contains(selectedMeshPartPath))
            selectedMeshPartPath = null;
    }

    private static string SolidPathFromVisualPath(string visualPath)
    {
        const string marker = "/visual:";
        var markerIndex = visualPath.LastIndexOf(marker, StringComparison.Ordinal);
        return markerIndex < 0 ? visualPath : visualPath[..markerIndex];
    }

    private static string SolidPathFromMaterialPath(string materialPath)
    {
        const string marker = "/material:";
        var markerIndex = materialPath.LastIndexOf(marker, StringComparison.Ordinal);
        return markerIndex < 0 ? materialPath : materialPath[..markerIndex];
    }

    private void UseAuthoredModelParts(ItemSceneResult selectedScene)
    {
        var movingPaths = AuthoredMotionPreview.Build(selectedScene).Tracks.Select(t => t.ChildPath).ToHashSet();
        var materialBySolidAndIndex = selectedScene.Preview.Materials
            .GroupBy(m => (SolidPathFromMaterialPath(m.Path), m.Index))
            .ToDictionary(g => g.Key, g => g.First());
        var fallbackMaterialByIndex = selectedScene.Preview.Materials
            .GroupBy(m => m.Index)
            .ToDictionary(g => g.Key, g => g.First());
        var renderGeometry = selectedScene.Preview.Geometry.Where(g => !g.IsCollision).ToArray();
        forcedRenderableGeometryPaths.Clear();
        if (renderGeometry.Length == 0)
        {
            renderGeometry = selectedScene.Preview.Geometry.ToArray();
            foreach (var geometry in renderGeometry)
                forcedRenderableGeometryPaths.Add(geometry.Path);
        }

        modelParts = renderGeometry.Select(g =>
        {
            var solidPath = SolidPathFromVisualPath(g.Path);
            return new ModelPart
            {
                Path = g.Path,
                Name = g.Path.Split('/').LastOrDefault() ?? g.Path,
                EntityPath = g.EntityPath,
                IsMoving = g.EntityPath is not null && movingPaths.Contains(g.EntityPath),
                MaterialSlotCount = selectedScene.Preview.Mappings.Where(mapping => mapping.SolidPath == solidPath)
                    .Select(mapping => mapping.MaterialIndex).Distinct().Count(),
                MaterialSummary = string.Join(", ", selectedScene.Preview.Mappings
                    .Where(mapping => mapping.SolidPath == solidPath)
                    .Select(mapping => mapping.MaterialIndex).Distinct()
                    .Select(index => (materialBySolidAndIndex.TryGetValue((solidPath, index), out var material)
                                   || fallbackMaterialByIndex.TryGetValue(index, out material))
                        ? (material.GameMaterialName ?? material.Name ?? $"Slot {index}")
                        : $"Slot {index}")),
                Positions = g.Positions,
                Indices = g.Indices
            };
        }).ToList();
        foreach (var part in modelParts)
            if (string.IsNullOrWhiteSpace(part.MaterialSummary))
                part.MaterialSummary = "None";
        SyncMeshPartModes();
    }

    private ItemSceneResult ReadSelectedScene()
    {
        return ReadSceneForSourceIndex(activeVariantIndex, variantSources.Select(s => s.GbxFile).Distinct().ToList().IndexOf(variantSources[activeVariantIndex].GbxFile));
    }

    private ItemSceneResult ReadSceneForSourceIndex(int sourceIndex, int documentOrdinal)
    {
        var source = variantSources[sourceIndex];
        var document = variantSources.Select(s => s.GbxFile).Distinct().ToList().IndexOf(source.GbxFile);
        int? variant = source.Model.EntityModel is NPlugItem_SVariantList { Variants: { } variants } && source.Variant is { } selected
            ? Array.IndexOf(variants, selected) : null;
        var doc = documentOrdinal >= 0 ? documentOrdinal : document;
        var result = ItemScene.Build(source.PreviewRoot, doc, variant, geometryCache, resolveExternal: true);
        if (source.TextureContext is { } context)
            result = result with { Preview = result.Preview with { Materials = result.Preview.Materials.Select(material =>
                material.Representation == "SkinMaterial" ? material with { GameMaterialLink = context + "/" + material.Name } : material).ToArray() } };
        return result;
    }

