    private async Task ConnectCompositePivotSelection()
    {
        if (compositeSelectionOrder.Count < 2)
            return;
        var leader = compositeSelectionOrder[0];
        var leaderRigid = BuildCompositeRigidTransform(leader);
        if (!Matrix4x4.Invert(leaderRigid, out var leaderInverse))
            return;

        foreach (var follower in compositeSelectionOrder.Skip(1))
        {
            if (follower == leader)
                continue;
            if (WouldCreatePivotCycle(leader, follower))
                continue;
            var followerRigid = BuildCompositeRigidTransform(follower);
            compositePivotLeaderByFollower[follower] = leader;
            compositePivotRelativeByFollower[follower] = leaderInverse * followerRigid;
        }

        ApplyCompositePivotLinks();
        await OnCompositeWorldOffsetChanged();
    }

    private bool WouldCreatePivotCycle(int leader, int follower)
    {
        var current = leader;
        var guard = 0;
        while (guard++ < 64 && compositePivotLeaderByFollower.TryGetValue(current, out var parent))
        {
            if (parent == follower)
                return true;
            current = parent;
        }
        return false;
    }

    private IReadOnlyList<(int GroupId, string Label, CompositeWorldTransform Transform)> CompositeGroups()
    {
        var labels = compositeGroupTransforms.Keys.OrderBy(id => id).Select(groupId =>
        {
            var members = compositeGroupBySourceIndex
                .Where(pair => pair.Value == groupId)
                .Select(pair => pair.Key)
                .Where(index => index >= 0 && index < variantSources.Count)
                .Select(index => variantSources[index].Name)
                .Distinct()
                .ToArray();
            var label = members.Length == 0
                ? $"Group {groupId + 1}"
                : $"Group {groupId + 1}: {string.Join(", ", members)}";
            return (GroupId: groupId, Label: label, Transform: compositeGroupTransforms[groupId]);
        }).ToArray();
        return labels;
    }

    private string CompositeGroupColor(int groupId)
    {
        var palette = new[]
        {
            "#f43f5e", "#f59e0b", "#10b981", "#22d3ee", "#6366f1", "#a855f7", "#e879f9", "#84cc16"
        };
        return palette[Math.Abs(groupId) % palette.Length];
    }

    private int CompositeGroupMembersCount(int groupId)
        => compositeGroupBySourceIndex.Count(pair => pair.Value == groupId);

    private Vector3 ComputeCompositeGroupPivotCenter(IEnumerable<int> sourceIndices)
    {
        var members = sourceIndices.Distinct().ToArray();
        if (members.Length == 0)
            return Vector3.Zero;
        var sum = Vector3.Zero;
        var count = 0;
        foreach (var sourceIndex in members)
        {
            if (sourceIndex < 0 || sourceIndex >= variantSources.Count)
                continue;
            var sourceRigid = BuildCompositeRigidTransform(sourceIndex);
            var sourcePivot = GetSourcePivotPosition(sourceIndex);
            var worldPivot = Vector3.Transform(sourcePivot, sourceRigid);
            sum += worldPivot;
            count++;
        }
        return count == 0 ? Vector3.Zero : sum / count;
    }

    private async Task CreateCompositeGroupFromSelection()
    {
        if (compositeSelectionOrder.Count < 2)
            return;
        var existingGroups = compositeSelectionOrder
            .Select(source => compositeGroupBySourceIndex.TryGetValue(source, out var groupId) ? groupId : (int?)null)
            .Where(groupId => groupId.HasValue)
            .Select(groupId => groupId!.Value)
            .Distinct()
            .ToArray();

        var targetGroup = existingGroups.Length == 1 ? existingGroups[0] : nextCompositeGroupId++;
        var transform = GetCompositeGroupTransform(targetGroup);
        if (existingGroups.Length > 1 || existingGroups.Length == 0)
        {
            transform.X = 0;
            transform.Y = 0;
            transform.Z = 0;
            transform.RotX = 0;
            transform.RotY = 0;
            transform.RotZ = 0;
            var center = ComputeCompositeGroupPivotCenter(compositeSelectionOrder);
            transform.PivotX = center.X;
            transform.PivotY = center.Y;
            transform.PivotZ = center.Z;
        }

        foreach (var sourceIndex in compositeSelectionOrder)
            compositeGroupBySourceIndex[sourceIndex] = targetGroup;
        RemoveEmptyCompositeGroups();

        await OnCompositeWorldOffsetChanged();
    }

    private async Task UngroupCompositeSelection()
    {
        if (compositeSelectionOrder.Count == 0)
            return;
        foreach (var sourceIndex in compositeSelectionOrder)
            compositeGroupBySourceIndex.Remove(sourceIndex);
        RemoveEmptyCompositeGroups();
        await OnCompositeWorldOffsetChanged();
    }

    private void RemoveEmptyCompositeGroups()
    {
        var used = compositeGroupBySourceIndex.Values.ToHashSet();
        foreach (var groupId in compositeGroupTransforms.Keys.Where(id => !used.Contains(id)).ToArray())
            compositeGroupTransforms.Remove(groupId);
        foreach (var groupId in compositeGroupMotions.Keys.Where(id => !used.Contains(id)).ToArray())
            compositeGroupMotions.Remove(groupId);
    }

