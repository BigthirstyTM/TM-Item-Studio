    private async Task ReadDrawPathCoordinates()
    {
        var points = await JS.InvokeAsync<DrawPathPointDto[]>("getDrawnPathPoints");
        drawPathCoordinates = string.Join("\n", points.Select(p => FormattableString.Invariant($"{p.X:0.###} {p.Y:0.###} {p.Z:0.###}")));
    }
    private async Task ApplyPathCoordinates()
    {
        var points = new List<DrawPathPointDto>();
        foreach (var line in drawPathCoordinates.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var values = line.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
            if (values.Length != 3 || !float.TryParse(values[0], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var x)
                || !float.TryParse(values[1], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var y)
                || !float.TryParse(values[2], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var z)
                || !float.IsFinite(x) || !float.IsFinite(y) || !float.IsFinite(z) || new Vector3(x,y,z).Length() > 10000)
            { errorMessage = "Enter finite X Y Z coordinates on each line, using a decimal point, within 10,000 m of the origin."; return; }
            points.Add(new() { X=x, Y=y, Z=z });
        }
        if (points.Count > ItemMotionPath.MaxLegs + 1) { errorMessage = "Use at most nine points."; return; }
        await JS.InvokeVoidAsync("setDrawnPathPoints", points);
        errorMessage = null;
        drawPathStatusMessage = $"{points.Count} points ready. Preview or apply the path.";
        await RefreshDrawPathPreview();
    }
