                                <span style="min-width: 190px;" class="text-truncate text-warning fw-semibold">@group.Label</span>
                                <span class="badge rounded-pill studio-group-badge" style="@($"--group-color:{groupColor}")">Members @CompositeGroupMembersCount(group.GroupId)</span>
                                <button class="btn btn-xs btn-outline-secondary" style="font-size:0.7em;"
                                        title="Select group gizmo in viewport"
                                        @onclick="@(() => SelectCompositeGroupGizmo(group.GroupId))">🎯</button>
                                <label class="mb-0" data-help-key="x">X</label>
                                <input type="number" class="form-control form-control-sm studio-transform-input" step="0.1"
                                       aria-label="@($"transform X {group.GroupId}")" @bind="transform.X" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                <label class="mb-0" data-help-key="y">Y</label>
                                <input type="number" class="form-control form-control-sm studio-transform-input" step="0.1"
                                       aria-label="@($"transform Y {group.GroupId}")" @bind="transform.Y" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                <label class="mb-0" data-help-key="z">Z</label>
                                <input type="number" class="form-control form-control-sm studio-transform-input" step="0.1"
                                       aria-label="@($"transform Z {group.GroupId}")" @bind="transform.Z" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                <label class="mb-0" data-help-key="rx">RX</label>
                                <input type="number" class="form-control form-control-sm studio-transform-input" step="1"
                                       aria-label="@($"transform RotX {group.GroupId}")" @bind="transform.RotX" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                <label class="mb-0" data-help-key="ry">RY</label>
                                <input type="number" class="form-control form-control-sm studio-transform-input" step="1"
                                       aria-label="@($"transform RotY {group.GroupId}")" @bind="transform.RotY" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                <label class="mb-0" data-help-key="rz">RZ</label>
                                <input type="number" class="form-control form-control-sm studio-transform-input" step="1"
                                       aria-label="@($"transform RotZ {group.GroupId}")" @bind="transform.RotZ" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                <label class="mb-0" data-help-key="px">PX</label>
                                <input type="number" class="form-control form-control-sm studio-transform-input" step="0.1"
                                       aria-label="@($"transform PivotX {group.GroupId}")" @bind="transform.PivotX" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                <label class="mb-0" data-help-key="py">PY</label>
                                <input type="number" class="form-control form-control-sm studio-transform-input" step="0.1"
                                       aria-label="@($"transform PivotY {group.GroupId}")" @bind="transform.PivotY" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                <label class="mb-0" data-help-key="pz">PZ</label>
