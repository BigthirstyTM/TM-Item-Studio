    private static bool TryExtractDocumentOrdinal(string path, out int ordinal)
    {
        ordinal = -1;
        if (string.IsNullOrWhiteSpace(path)) return false;
        const string prefix = "doc:";
        var index = path.IndexOf(prefix, StringComparison.Ordinal);
        if (index < 0) return false;
        index += prefix.Length;
        var end = path.IndexOf('/', index);
        if (end < 0) end = path.Length;
        return int.TryParse(path[index..end], NumberStyles.Integer, CultureInfo.InvariantCulture, out ordinal) && ordinal >= 0;
    }

