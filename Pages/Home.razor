    private async Task LoadVariant(int index)
    {
        drawPathOriginal = drawPathGenerated = null;
        drawPathBefore = null;
        drawPathPreviewActive = false;
        drawPathCaptureEnabled = false;
        drawPathCoordinates = "";
        drawPathStatusMessage = null;
        if (isViewerInitialized) { await UpdateDrawPlane(); await JS.InvokeVoidAsync("clearDrawnPath"); }
        activeVariantIndex = index;
        var source = variantSources[index];
        if (!ReferenceEquals(itemModel, source.Model))
        {
            iconPreviewPending = true;
            iconStatus = iconPreviewStatus = null;
            iconFileName = null;
        }
        itemModel = source.Model;
        gbxFile = source.GbxFile;
        fxNativeOffsetWritten = false;
        if (FxOpaqueExport.TryReadEmissionPoint(gbxFile, out var nativeEmission) && nativeEmission is not null)
        {
            fxEmitterX = nativeEmission.X;
            fxEmitterY = nativeEmission.Y;
            fxEmitterZ = nativeEmission.Z;
        }
        if (source.IsReadOnly) activeTab = "model";
        if (string.IsNullOrWhiteSpace(macroblockName))
            macroblockName = ItemMacroblock.DefaultName(itemModel);
        hasMesh = false;
        isMovingItem = false;
        hasBakedAnimation = false;
        modelParts.Clear();
        detectedPivots.Clear();
        detectedLights.Clear();
        detectedNodeTypes.Clear();
        detectedAxis = "y";
        isOscillating = false;
        minAngle = 0;
        maxAngle = 0;
        translationAxis = "y";
        translationDistance = 0;
        animationPeriodSeconds = 2;
        animationPhaseSeconds = 0;
        pivotOffsetX = pivotOffsetY = pivotOffsetZ = 0;
        if (!FxOpaqueExport.TryReadEmissionPoint(gbxFile, out _))
            fxEmitterX = fxEmitterY = fxEmitterZ = 0;
        harmonicEasing = false;
        invertMotion = false;
        hasTranslationMotion = false;
        translationMin = new float[3];
        translationMax = new float[3];
        activeKinematicConstraint = null;
        showOriginalMotion = false;
        originalConstraintType = "Not found";
        originalMotionSettings.Clear();
        originalMotionAvailable = false;

        identId = itemModel.Ident?.Id ?? "";
        identAuthor = itemModel.Ident?.Author ?? "";
        identCollection = itemModel.Ident?.Collection.ToString() ?? "";
        authoredMotionScene = ReadSelectedScene();
        hasBakedAnimation = authoredMotionScene.Preview.Geometry.Any(geometry => geometry.AnimationFrameCount > 1);
        detectedMaterials = authoredMotionScene.Preview.Materials;
        authoredConstraints.Clear();
        authoredConstraints.AddRange(authoredMotionScene.Handles.Sources.Values.OfType<NPlugDyna_SKinematicConstraint>());
        ExtractParts(source.PreviewRoot, includeGeometry: authoredConstraints.Count == 0);
        ExtractPivots(itemModel);
        ExtractPlacementAlternatives(itemModel);
        if (authoredConstraints.Count > 0) UseAuthoredModelParts(authoredMotionScene);
        isMovingItem = isMovingItem || authoredConstraints.Count > 0;
        motionDiagnostics = AuthoredMotionPreview.Build(authoredMotionScene).Diagnostics;

        var sceneHasGeometry = authoredMotionScene.Preview.Geometry.Count > 0;
        if (modelParts.Count > 0)
        {
            hasMesh = true;
            vertexCount = modelParts.Sum(p => p.Positions.Length / 3);
        }
        else if (sceneHasGeometry)
        {
            hasMesh = true;
            vertexCount = authoredMotionScene.Preview.Geometry
                .Sum(g => (g.Positions?.Length ?? 0) / 3);
        }

        if (isViewerInitialized)
            await UpdateScenePayload(authoredMotionScene);
        else
            StateHasChanged();
        await RefreshDebugDiagnostics();
    }

    private string BuildObjExport()
    {
        var sb = new StringBuilder();
        sb.AppendLine("# Trackmania Item Studio OBJ Export");
        var totalIndexOffset = 0;
        foreach (var part in modelParts)
        {
            sb.AppendLine($"o {part.Name}");
            for (var i = 0; i < part.Positions.Length; i += 3)
                sb.AppendLine(string.Format(CultureInfo.InvariantCulture, "v {0:F4} {1:F4} {2:F4}", part.Positions[i], part.Positions[i + 1], part.Positions[i + 2]));
            for (var i = 0; i + 2 < part.Indices.Length; i += 3)
                sb.AppendLine($"f {part.Indices[i] + totalIndexOffset + 1} {part.Indices[i + 1] + totalIndexOffset + 1} {part.Indices[i + 2] + totalIndexOffset + 1}");
            totalIndexOffset += part.Positions.Length / 3;
        }
        return sb.ToString();
    }

