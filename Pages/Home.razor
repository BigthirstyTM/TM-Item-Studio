        if (itemModel == null)
        {
            await JS.InvokeVoidAsync("enableItemDropZone", "item-dropzone", "empty-item-upload");
        }

        if (itemModel == null || isViewerInitialized)
        {
            if (itemModel != null && activeTab == "general")
            {
                iconPreviewPending = !await RenderIconPreview();
                await JS.InvokeVoidAsync("enableIconDropZone", "icon-dropzone", "icon-upload");
            }
            return;
        }

        await JS.InvokeVoidAsync("init3DViewer", "threeContainer", dotNetHelper);
        isViewerInitialized = true;
        await UpdateScenePayload(authoredMotionScene);
        if (activeTab == "general")
        {
            iconPreviewPending = !await RenderIconPreview();
            await JS.InvokeVoidAsync("enableIconDropZone", "icon-dropzone", "icon-upload");
        }
    }

