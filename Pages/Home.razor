@page "/"
@implements IAsyncDisposable
@using GBX.NET
@using GBX.NET.Engines.Game
@using GBX.NET.Engines.GameData
@using GBX.NET.Engines.Plug
@using GBX.NET.Engines.MwFoundations
@using GBX.NET.Engines.Meta
@using GBX.NET.Engines.MetaNotPersistent
@using System.IO
@using System.Text
@using System.Globalization
@using System.Reflection
@using TM_Item_Studio.Models
@inject IJSRuntime JS

<PageTitle>Trackmania 2020 Item Studio</PageTitle>

<header class="studio-header">
    <h3>Trackmania 2020 Item Studio</h3>
    <div class="studio-documents" aria-label="Loaded files">
        @foreach (var file in LoadedFiles())
        {
            <strong class="studio-variant-filename" title="@file.Label">@file.Label</strong>
        }
    </div>
    <div class="studio-header-tools">
        <details class="studio-diagnostics">
            <summary class="btn btn-sm btn-outline-secondary">Diagnostics (@modelDiagnostics.Count)</summary>
            <div class="studio-diagnostics-panel">
                <button class="btn btn-sm btn-outline-secondary mb-2" @onclick="DownloadDebugReport">Download debug report</button>
                <p class="small text-muted">Reports contain model names, authors and referenced filenames. Review before sharing; nothing is uploaded.</p>
                <ul class="small">
                    @foreach (var diagnostic in modelDiagnostics)
                    {
                        <li><code>@diagnostic.Code</code>: @diagnostic.Message</li>
                    }
                </ul>
            </div>
        </details>
        <div class="studio-upload">
            <label for="item-upload" class="btn btn-sm btn-outline-secondary">Open item files</label>
            <InputFile id="item-upload" OnChange="LoadFiles" multiple accept=".gbx" class="visually-hidden" />
        </div>
        <button class="btn btn-sm btn-outline-secondary" type="button" onclick="studioTheme.toggle()" aria-label="Switch light or dark theme">Light / dark</button>
    </div>
</header>

@if (isLoading)
{
    <div class="alert alert-info py-2">
        <em>Loading item, analysing geometry, PivotPositions, lights and metadata...</em>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger py-2">
        <strong>Error:</strong> @errorMessage
    </div>
}

@if (itemModel != null)
{
    <div class="studio-workspace">
        
        <!-- ================= 3D VIEWPORT ================= -->
        <div class="studio-viewport-column">
            <div class="studio-viewport">
                
                <!-- Viewport Toolbar -->
                <div class="studio-viewport-toolbar">
                    <!-- Layer toggles -->
                    <div class="btn-group btn-group-sm">
                        <button class="btn @(showMeshes ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleLayer("meshes"))">
                            Meshes
                        </button>
                        <button class="btn @(showPivots ? "btn-warning text-dark" : "btn-outline-secondary")" @onclick="@(() => ToggleLayer("pivots"))">
                            Pivots (@detectedPivots.Count)
                        </button>
                        <button class="btn @(showLights ? "btn-info text-dark" : "btn-outline-secondary")" @onclick="@(() => ToggleLayer("lights"))">
                            Lights (@detectedLights.Count)
                        </button>
                    </div>

                    <div class="studio-variants" role="group" aria-label="Item variants" aria-busy="@isSelectingVariant.ToString().ToLowerInvariant()">
                        @foreach (var file in LoadedFiles())
                        {
                            <div class="studio-variant-file" role="group" aria-label="@file.Label">
                                @if (CanCombineFiles) { <span class="studio-variant-group-label" title="@file.Label">@file.Label</span> }
                                <div class="studio-variant-buttons">
                                    @foreach (var entry in file.Entries)
                                    {
                                        var variantIndex = entry.Index;
                                        <button class="btn btn-sm @(variantIndex == activeVariantIndex ? "btn-primary" : "btn-outline-secondary")"
                                                aria-label="@($"{variantIndex + 1}. {entry.Source.Name}")" title="@($"{file.Label} — variant {entry.Source.VariantNumber}")"
                                                aria-pressed="@((variantIndex == activeVariantIndex).ToString().ToLowerInvariant())"
                                                aria-disabled="@isSelectingVariant.ToString().ToLowerInvariant()" @onclick="@(() => SelectVariant(variantIndex))">
                                            @entry.Source.VariantNumber
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        <span class="visually-hidden" role="status">@(isSelectingVariant ? "Loading variant…" : "Variant ready. Export preserves every variant in the selected file.")</span>
                    </div>

                    <!-- Animation and general controls -->
                    <div class="studio-view-controls">
                        @if (isMovingItem)
                        {
                            <button class="btn btn-sm @(isPlaying ? "btn-warning" : "btn-success")" @onclick="ToggleAnimation">
                                @(isPlaying ? "⏸" : "▶")
                            </button>
                            @if (authoredConstraints.Count == 0)
                            {
                                <select class="form-select form-select-sm" style="width: auto;" value="@detectedAxis" @onchange="OnAxisChanged">
                                    <option value="y">Y Axis</option>
                                    <option value="x">X Axis</option>
                                    <option value="z">Z Axis</option>
                                </select>
                            }
                        }
                        <button class="btn btn-sm btn-outline-light" @onclick="ToggleWireframe">Wire</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetCamera">Reset Camera</button>
                        @if (hasMesh)
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="DownloadObj">.OBJ</button>
                        }
                    </div>
                </div>
                
                <!-- 3D Canvas container -->
                <div id="threeContainer">
                </div>
            </div>
            @if (!hasMesh)
            {
                <p class="small mt-2" role="status">No mesh geometry available. See Model diagnostics for external or unsupported references.</p>
            }
            
            <div class="studio-viewport-caption text-muted small">
                <div>
                    <span><span style="color: #b8bdc6;">■</span> Mesh</span>
                    <span class="ms-2"><span style="color: #facc15;">●</span> Pivot</span>
                    <span class="ms-2"><span style="color: #fffbeb;">💡</span> Light</span>
                </div>
                <div>
                    <em>Tip: Select a pivot gizmo and move it with the transform arrows. Lights can be selected but not moved.</em>
                </div>
            </div>
            @if (hasMesh)
            {
                <p class="small text-muted mt-2">Neutral preview — textures are not loaded.</p>
            }
        </div>

        <!-- ================= RECHTERKOLOM: TABBED INSPECTOR ================= -->
        <div class="studio-inspector">
            
            <div class="studio-inspector-tabs p-2 bg-light border-bottom">
                <div>
                    <button aria-label="Item Identification & Collector Metadata" aria-expanded="@((activeTab == "general").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "general" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("general"))">
                        <span>Identity</span><span>@(activeTab == "general" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="Placement Parameters & PivotPositions" aria-expanded="@((activeTab == "placement").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "placement" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("placement"))">
                        <span>Placement & pivots</span><span>@(activeTab == "placement" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="WaypointType, Gameplay & Kinematics" aria-expanded="@((activeTab == "gameplay").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "gameplay" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("gameplay"))">
                        <span>Kinematics</span><span>@(activeTab == "gameplay" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="@($"Dynamic Real-Time Lights ({detectedLights.Count})")" aria-expanded="@((activeTab == "lights").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "lights" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("lights"))">
                        <span>Lights (@detectedLights.Count)</span><span>@(activeTab == "lights" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="Socket authoring capability (read-only)" aria-expanded="@((activeTab == "sockets").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "sockets" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("sockets"))">
                        <span>Sockets</span><span>@(activeTab == "sockets" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="PhyModel, CPlugSurface & Collision" aria-expanded="@((activeTab == "physics").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "physics" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("physics"))">
                        <span>Collision</span><span>@(activeTab == "physics" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="VisModel, Materials & LOD" aria-expanded="@((activeTab == "visual").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "visual" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("visual"))">
                        <span>Materials & LOD</span><span>@(activeTab == "visual" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="Audio, CPlugFx & MediaTracker Triggers" aria-expanded="@((activeTab == "extras").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "extras" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("extras"))">
                        <span>Audio & effects</span><span>@(activeTab == "extras" ? "−" : "+")</span>
                    </button>
                </div>
            </div>

            <div class="studio-inspector-content p-3" style="overflow-y: auto; flex-grow: 1; font-size: 0.9em;">
                
                @if (activeTab == "general")
                {
                    <h6 class="border-bottom pb-1 text-primary">1. Ident (Id, Author, Collection) <span class="text-muted" title="Defines the item's internal ID, author and context collection.">?</span></h6>
                    <div class="mb-2">
                        <label for="ident-id" class="form-label mb-0 fw-bold">Ident.Id / File name</label>
                        <input id="ident-id" type="text" class="form-control form-control-sm" @bind="identId" @bind:after="UpdateIdent" />
                    </div>
                    <div class="mb-2">
                        <label for="ident-author" class="form-label mb-0 fw-bold">Ident.Author</label>
                        <input id="ident-author" type="text" class="form-control form-control-sm" @bind="identAuthor" @bind:after="UpdateIdent" />
                    </div>
                    <div class="mb-2">
                        <label for="ident-collection" class="form-label mb-0 fw-bold">Ident.Collection</label>
                        <input id="ident-collection" type="text" class="form-control form-control-sm" aria-describedby="ident-collection-help" @bind="identCollection" @bind:after="UpdateIdent" />
                        <small id="ident-collection-help" class="text-muted">Unchanged values keep their encoding. Numeric edits use IDs 0–1073741823 (26 for TM2020); other edits stay strings.</small>
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-0 fw-bold">ItemType (EItemType)</label>
                        <select class="form-select form-select-sm" @bind="itemModel.ItemType">
                            @foreach (var type in Enum.GetValues<CGameItemModel.EItemType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-0 fw-bold">Archetype / Inventory Path</label>
                        <input type="text" class="form-control form-control-sm" value="@(itemModel.ArchetypeRef ?? "None")" readonly />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-8">
                            <label class="form-label mb-0 fw-bold">Internal item name</label>
                            <input type="text" class="form-control form-control-sm" @bind="itemModel.Name" />
                            <div class="form-text">Exports with an Ident.Id use that ID as the internal item name to avoid Trackmania catalog collisions.</div>
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 fw-bold">CopperPrice</label>
                            <input type="number" min="0" class="form-control form-control-sm" @bind="itemModel.CopperPrice" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-0 fw-bold">Description</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="itemModel.Description"></textarea>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label mb-0 small fw-bold">PageName</label>
                            <input type="text" class="form-control form-control-sm" @bind="itemModel.PageName" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-0 small fw-bold">CatalogPosition</label>
                            <input type="number" class="form-control form-control-sm" @bind="itemModel.CatalogPosition" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label mb-0 small fw-bold">NbAvailableMin</label>
                            <input type="number" min="0" class="form-control form-control-sm" @bind="itemModel.NbAvailableMin" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-0 small fw-bold">NbAvailableMax</label>
                            <input type="number" min="0" class="form-control form-control-sm" @bind="itemModel.NbAvailableMax" />
                        </div>
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="internalItem" @bind="itemModel.IsInternal" />
                        <label class="form-check-label small" for="internalItem">IsInternal</label>
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="needUnlock" @bind="itemModel.NeedUnlock" />
                        <label class="form-check-label small" for="needUnlock">NeedUnlock</label>
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="advancedItem" @bind="itemModel.IsAdvanced" />
                        <label class="form-check-label small" for="advancedItem">IsAdvanced</label>
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="autoIcon" @bind="itemModel.IconUseAutoRender" />
                        <label class="form-check-label small" for="autoIcon">IconUseAutoRender</label>
                    </div>
                    <div class="row g-2 mb-2 mt-1">
                        <div class="col-8">
                            <label class="form-label mb-0 small fw-bold">SkinDirectory</label>
                            <input type="text" class="form-control form-control-sm" @bind="itemModel.SkinDirectory" />
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 small fw-bold">IconQuarterRotationY</label>
                            <input type="number" min="0" max="3" class="form-control form-control-sm" @bind="itemModel.IconQuarterRotationY" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-8">
                            <label class="form-label mb-0 small fw-bold">DefaultWeaponName</label>
                            <input type="text" class="form-control form-control-sm" @bind="itemModel.DefaultWeaponName" />
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 small fw-bold">DefaultCamIndex</label>
                            <input type="number" min="0" class="form-control form-control-sm" @bind="itemModel.DefaultCamIndex" />
                        </div>
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="disableLightmap" @bind="itemModel.DisableLightmap" />
                        <label class="form-check-label small" for="disableLightmap">DisableLightmap</label>
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-0 fw-bold">Icon (CPlugBitmap / DXT buffer)</label>
                        <div class="mb-2 p-2 bg-dark rounded text-center">
                            <canvas id="iconPreviewCanvas" width="128" height="128" style="width:128px;height:128px;image-rendering:auto;background:#20242a;border:1px solid #495057;"></canvas>
                        </div>
                        <div class="input-group input-group-sm">
                            <InputFile OnChange="UploadIcon" accept="image/jpeg,image/png,image/webp" class="form-control" />
                            <span class="input-group-text" title="The image is center-cropped and resized to the 64x64 RGBA Icon format used by the item model.">?</span>
                        </div>
                        <small class="text-muted">JPG, PNG or WebP. The image is normalized to 64x64. @iconFileName</small>
                        @if (!string.IsNullOrWhiteSpace(iconStatus))
                        {
                            <small class="d-block text-info">@iconStatus</small>
                        }
                    </div>
                }

                @if (activeTab == "placement")
                {
                    <h6 class="border-bottom pb-1 text-primary">2. CGameItemPlacementParam <span class="text-muted" title="Controls placement, snapping and PivotPositions in the Trackmania editor.">?</span></h6>
                    @if (itemModel.DefaultPlacement != null)
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <label class="form-label mb-0 small fw-bold">GroundPoint X</label>
                                <input type="number" step="0.1" class="form-control form-control-sm" value="@itemModel.GroundPoint.X" @onchange="@(e => UpdateGroundPoint(0, e.Value))" />
                            </div>
                            <div class="col-4">
                                <label class="form-label mb-0 small fw-bold">GroundPoint Y</label>
                                <input type="number" step="0.1" class="form-control form-control-sm" value="@itemModel.GroundPoint.Y" @onchange="@(e => UpdateGroundPoint(1, e.Value))" />
                            </div>
                            <div class="col-4">
                                <label class="form-label mb-0 small fw-bold">GroundPoint Z</label>
                                <input type="number" step="0.1" class="form-control form-control-sm" value="@itemModel.GroundPoint.Z" @onchange="@(e => UpdateGroundPoint(2, e.Value))" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold">PainterGroundMargin (m)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="itemModel.PainterGroundMargin" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold">OrbitalCenterHeightFromGround (m)</label>
                                <input type="number" step="0.1" class="form-control form-control-sm" @bind="itemModel.OrbitalCenterHeightFromGround" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold">OrbitalRadiusBase (m)</label>
                                <input type="number" step="0.1" class="form-control form-control-sm" @bind="itemModel.OrbitalRadiusBase" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold">OrbitalPreviewAngle</label>
                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="itemModel.OrbitalPreviewAngle" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold">GridSnap H Step (m)</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="itemModel.DefaultPlacement.GridSnapHStep" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold">GridSnap V Step (m)</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="itemModel.DefaultPlacement.GridSnapVStep" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold">GridSnap H Offset</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="itemModel.DefaultPlacement.GridSnapHOffset" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold">GridSnap V Offset</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="itemModel.DefaultPlacement.GridSnapVOffset" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold">Fly V Step</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="itemModel.DefaultPlacement.FlyVStep" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold">Fly V Offset</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="itemModel.DefaultPlacement.FlyVOffset" />
                            </div>
                        </div>

                        <h6 class="border-bottom pb-1 mt-3 text-primary">Rotation placement flags</h6>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="yawOnly" @bind="itemModel.DefaultPlacement.YawOnly" />
                            <label class="form-check-label small" for="yawOnly">YawOnly</label>
                        </div>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="notOnObject" @bind="itemModel.DefaultPlacement.NotOnObject" />
                            <label class="form-check-label small" for="notOnObject">NotOnObject</label>
                        </div>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="autoRot" @bind="itemModel.DefaultPlacement.AutoRotation" />
                            <label class="form-check-label small" for="autoRot">AutoRotation</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="switchPivot" @bind="itemModel.DefaultPlacement.SwitchPivotManually" />
                            <label class="form-check-label small" for="switchPivot">SwitchPivotManually</label>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                            <h6 class="mb-0 text-primary">Pivots (@detectedPivots.Count)</h6>
                            <button class="btn btn-xs btn-outline-primary" style="font-size:0.75em; padding: 2px 6px;" @onclick="AddPivot">
                                + PivotPosition
                            </button>
                        </div>

                        @for (int i = 0; i < detectedPivots.Count; i++)
                        {
                            var p = detectedPivots[i];
                            int pIdx = i;
                            <div class="card p-2 bg-light mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small">PivotPosition @p.Index @(pIdx == 0 ? "(Default)" : "")</strong>
                                    <div>
                                        <button class="btn btn-xs btn-outline-secondary" style="font-size:0.7em;" @onclick="@(() => SelectGizmoIn3D("pivot", pIdx))">
                                            Select in 3D
                                        </button>
                                        @if (pIdx > 0)
                                        {
                                            <button class="btn btn-xs btn-outline-danger ms-1" style="font-size:0.7em;" @onclick="@(() => RemovePivot(pIdx))">✕</button>
                                        }
                                    </div>
                                </div>
                                <div class="row g-1">
                                    <div class="col-4">
                                        <input type="number" step="0.1" class="form-control form-control-sm" @bind="p.X" @bind:after="@(() => OnPivotChanged(pIdx))" />
                                    </div>
                                    <div class="col-4">
                                        <input type="number" step="0.1" class="form-control form-control-sm" @bind="p.Y" @bind:after="@(() => OnPivotChanged(pIdx))" />
                                    </div>
                                    <div class="col-4">
                                        <input type="number" step="0.1" class="form-control form-control-sm" @bind="p.Z" @bind:after="@(() => OnPivotChanged(pIdx))" />
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }

                @if (activeTab == "gameplay")
                {
                    <div class="mb-2">
                        <label class="form-label mb-0 fw-bold">Waypoint Type</label>
                        <select class="form-select form-select-sm" @bind="itemModel.WaypointType">
                            @foreach (var wp in Enum.GetValues<CGameItemModel.EWaypointType>())
                            {
                                <option value="@wp">@wp</option>
                            }
                        </select>
                    </div>

                    <h6 class="border-bottom pb-1 text-primary">@(authoredConstraints.Count > 0 ? "Kinematic controls" : "Motion capability")</h6>
                    <div class="@(authoredConstraints.Count > 0 ? "authored-motion-shell" : "card p-3 bg-light mb-3")">
                        @if (!isMovingItem)
                        {
                            <p class="small text-muted mb-2">
                                This item is a <strong>static object</strong>. Changing <code>ItemType</code> alone does not author the
                                <code>NPlugDyna*</code> objects and constraints a moving item needs, so this editor cannot convert it.
                            </p>
                            <button class="btn btn-sm btn-outline-secondary" disabled aria-disabled="true"
                                    title="Conversion is unsupported: the dynamic object/constraint graph must be authored by an external tool.">
                                ⚙️ Convert to KinematicObject (unsupported)
                            </button>
                            <p class="small text-muted mt-2 mb-0">
                                Author moving items with an external tool; the kinematic graph must already exist in the file.
                            </p>
                        }
                        else if (authoredConstraints.Count > 0)
                        {
                            <p role="status" class="small text-muted mb-2" title="Only explicit edits change the file. A shared constraint affects all its instances.">Using authored motion settings</p>
                            @foreach (var diagnostic in motionDiagnostics)
                            {
                                <p role="status" class="small text-warning">Preview unavailable: @diagnostic</p>
                            }
                            @for (var i = 0; i < authoredConstraints.Count; i++)
                            {
                                <AuthoredMotionEditor @key="authoredConstraints[i]" Name="@($"Constraint {i + 1}")" Source="authoredConstraints[i]" Changed="UpdateScenePayload" />
                            }
                        }
                        else
                        {
                            <p class="small text-muted mb-2">
                                This item is currently <strong>KinematicObject / DynamicalObject</strong>.
                            </p>
                            <button class="btn btn-sm @(showOriginalMotion ? "btn-info" : "btn-outline-info") mb-2" @onclick="ToggleOriginalMotion">
                                @(showOriginalMotion ? "Original motion active" : "Show original motion in viewport")
                            </button>
                            @if (showOriginalMotion)
                            {
                                <div class="card border-info bg-white mb-3">
                                    <div class="card-header py-1 text-info fw-bold">Original engine settings</div>
                                    <div class="card-body p-2">
                                        <div class="small text-muted mb-2">Constraint: @originalConstraintType</div>
                                        @if (originalMotionSettings.Count == 0)
                                        {
                                            <div class="small text-muted">No readable kinematic properties found.</div>
                                        }
                                        else
                                        {
                                            @foreach (var setting in originalMotionSettings)
                                            {
                                                <div class="d-flex justify-content-between gap-2 border-bottom py-1 small">
                                                    <span class="fw-bold">@setting.Name</span>
                                                    <span class="text-break text-end">@setting.Value</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label mb-0 small fw-bold">Animation type</label>
                                    <select class="form-select form-select-sm" value="@(isOscillating ? "osc" : "spin")" @onchange="OnAnimTypeChanged">
                                        <option value="spin">Continuous rotation</option>
                                        <option value="osc">PingPong / oscillation</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label mb-0 small fw-bold">RotAxis</label>
                                    <select class="form-select form-select-sm" value="@detectedAxis" @onchange="OnAxisChanged">
                                        <option value="y">Y Axis</option>
                                        <option value="x">X Axis</option>
                                        <option value="z">Z Axis</option>
                                    </select>
                                </div>
                            </div>
                            @if (isOscillating)
                            {
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label mb-0 small">AngleMinDeg (°)</label>
                                        <input type="number" step="5" class="form-control form-control-sm" @bind="minAngle" @bind:after="OnKinematicChanged" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label mb-0 small">AngleMaxDeg (°)</label>
                                        <input type="number" step="5" class="form-control form-control-sm" @bind="maxAngle" @bind:after="OnKinematicChanged" />
                                    </div>
                                </div>
                            }
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label mb-0 small">Period / Duration (sec)</label>
                                    <input type="number" min="0.01" step="0.05" class="form-control form-control-sm" @bind="animationPeriodSeconds" @bind:after="OnKinematicChanged" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label mb-0 small">Phase offset (sec)</label>
                                    <input type="number" step="0.05" class="form-control form-control-sm" @bind="animationPhaseSeconds" @bind:after="OnKinematicChanged" />
                                </div>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label mb-0 small">TransAxis</label>
                                    <select class="form-select form-select-sm" @bind="translationAxis" @bind:after="OnKinematicChanged">
                                        <option value="x">X Axis</option>
                                        <option value="y">Y Axis</option>
                                        <option value="z">Z Axis</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label mb-0 small">Translation distance (m)</label>
                                    <input type="number" step="0.05" class="form-control form-control-sm" @bind="translationDistance" @bind:after="OnKinematicChanged" />
                                </div>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="harmonicMotion" @bind="harmonicEasing" @bind:after="OnKinematicChanged" />
                                <label class="form-check-label small" for="harmonicMotion">Harmonic easing</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="invertMotion" @bind="invertMotion" @bind:after="OnKinematicChanged" />
                                <label class="form-check-label small" for="invertMotion">Invert direction</label>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-4">
                                    <label class="form-label mb-0 small">Pivot offset X</label>
                                    <input type="number" step="0.05" class="form-control form-control-sm" @bind="pivotOffsetX" @bind:after="OnKinematicChanged" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label mb-0 small">Pivot offset Y</label>
                                    <input type="number" step="0.05" class="form-control form-control-sm" @bind="pivotOffsetY" @bind:after="OnKinematicChanged" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label mb-0 small">Pivot offset Z</label>
                                    <input type="number" step="0.05" class="form-control form-control-sm" @bind="pivotOffsetZ" @bind:after="OnKinematicChanged" />
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary mt-2" disabled aria-disabled="true"
                                    title="Conversion is unsupported: removing the dynamic object/constraint graph is not implemented.">
                                ⏹ Convert to StaticObject (unsupported)
                            </button>
                            <p class="small text-muted mt-2 mb-0">
                                Removing the dynamic graph is not supported; export keeps the item's kinematic data unchanged.
                            </p>
                        }
                    </div>
                }

                @if (activeTab == "lights")
                {
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                            <h6 class="mb-0 text-primary">Lights (@detectedLights.Count) <span class="text-muted" title="Color, intensity and radius are written to each existing CPlugLightUserModel on export. Light position is not serialized by this editor.">?</span></h6>
                        <span class="small text-muted">Existing serialized lights only</span>
                    </div>
                    <p class="small text-muted">
                        Color, intensity and radius are saved to the light's own GBX data on export.
                        Position is owned by skeleton socket data the bundled GBX.NET parser does not expose, so it is read-only here.
                        This editor cannot add or remove lights.
                    </p>

                    @if (detectedLights.Count > 0)
                    {
                        @for (int i = 0; i < detectedLights.Count; i++)
                        {
                            var light = detectedLights[i];
                            int lIdx = i;
                            <div class="card p-2 mb-2 bg-light small">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong>Light @(lIdx + 1) (@light.Type)</strong>
                                    <button class="btn btn-xs btn-outline-secondary" style="font-size:0.7em;" @onclick="@(() => SelectGizmoIn3D("light", lIdx))">
                                        Select in 3D
                                    </button>
                                </div>

                                <div class="row g-1 mb-1">
                                    <div class="col-4">
                                        <label class="form-label mb-0" style="font-size: 0.75em;">X (read-only)</label>
                                        <input type="number" step="0.2" class="form-control form-control-sm" value="@light.X.ToString(CultureInfo.InvariantCulture)" readonly aria-readonly="true" aria-label="@($"Light {lIdx + 1} X (read-only)")" title="Light position is not serialized by this editor." />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label mb-0" style="font-size: 0.75em;">Y (read-only)</label>
                                        <input type="number" step="0.2" class="form-control form-control-sm" value="@light.Y.ToString(CultureInfo.InvariantCulture)" readonly aria-readonly="true" aria-label="@($"Light {lIdx + 1} Y (read-only)")" title="Light position is not serialized by this editor." />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label mb-0" style="font-size: 0.75em;">Z (read-only)</label>
                                        <input type="number" step="0.2" class="form-control form-control-sm" value="@light.Z.ToString(CultureInfo.InvariantCulture)" readonly aria-readonly="true" aria-label="@($"Light {lIdx + 1} Z (read-only)")" title="Light position is not serialized by this editor." />
                                    </div>
                                </div>

                                <div class="row g-1 align-items-center">
                                    <div class="col-4">
                                        <label class="form-label mb-0" style="font-size: 0.75em;">Color</label>
                                        <input type="color" class="form-control form-control-color w-100 p-0" style="height: 28px;" aria-label="@($"Light {lIdx + 1} color")" @bind="light.ColorHtml" @bind:after="@(() => OnLightColorChanged(lIdx))" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label mb-0" style="font-size: 0.75em;">Intensity</label>
                                        <input type="number" step="0.5" class="form-control form-control-sm" aria-label="@($"Light {lIdx + 1} intensity")" @bind="light.Intensity" @bind:after="@(() => OnLightChanged(lIdx))" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label mb-0" style="font-size: 0.75em;">Radius (m)</label>
                                        <input type="number" step="1.0" class="form-control form-control-sm" aria-label="@($"Light {lIdx + 1} radius")" @bind="light.Radius" @bind:after="@(() => OnLightChanged(lIdx))" />
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small">No light emitters found. Adding lights is not supported by this editor.</p>
                    }
                }

                @if (activeTab == "sockets")
                {
                    <h6 class="border-bottom pb-1 text-primary">Sockets</h6>
                    <div class="alert alert-secondary small">
                        <strong>Socket authoring is not supported.</strong>
                        Item sockets are owned by skeleton data inside the model; the bundled GBX.NET parser does not
                        expose them (<code>DefaultPlacement.Sockets</code> does not exist in this build), so socket
                        positions and tags cannot be listed, added, removed or moved here.
                    </div>
                    <p class="small text-muted mb-0">
                        This panel is a read-only capability note. Author sockets with an external item-authoring tool.
                        Nothing in this editor claims to change socket behavior in the game.
                    </p>
                }

                @if (activeTab == "physics")
                {
                    <h6 class="border-bottom pb-1 text-primary">PhyModel, CPlugSurface & Collision <span class="text-muted" title="These nodes define collision, physics surfaces and vehicle interaction.">?</span></h6>
                    <div class="alert @(CollisionInventory.Count > 0 ? "alert-success" : "alert-secondary") small">
                        @(CollisionInventory.Count > 0
                            ? $"Collision inventory: {CollisionInventory.Count} entr{(CollisionInventory.Count == 1 ? "y" : "ies")} found in this item."
                            : "No collision entries were found in this item.")
                    </div>
                    @if (CollisionInventory.Count > 0)
                    {
                        <div class="list-group small mb-2">
                            @foreach (var collision in CollisionInventory)
                            {
                                <div class="list-group-item">
                                    <strong>@collision.Representation</strong>
                                    <span class="badge bg-secondary ms-1">@collision.State</span>
                                    <div class="text-muted text-break">@collision.Path</div>
                                </div>
                            }
                        </div>
                    }
                    <p class="small text-muted mb-0">
                        Read-only diagnostic. Enabling or disabling collision is not supported: that would require
                        authoring or removing native collision shapes, which this editor does not do. No claim is made
                        about how the game treats these entries.
                    </p>
                }

                @if (activeTab == "visual")
                {
                    <h6 class="border-bottom pb-1 text-primary">VisModel, Materials & LOD <span class="text-muted" title="Visual geometry, materials, UV data and LOD nodes belong to the visual model.">?</span></h6>
                    <div class="row g-2 mb-2">
                        <div class="col-6"><div class="card bg-light p-2 small"><strong>Visual geometry</strong><br />@vertexCount vertices</div></div>
                        <div class="col-6"><div class="card bg-light p-2 small"><strong>LOD</strong><br />@(HasNode("LOD", "Lod") ? "Present" : "Not found")</div></div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="small">Authored materials (@detectedMaterials.Count)</strong>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="SelectTextureDirectory">Choose local texture folder</button>
                    </div>
                    @if (!string.IsNullOrEmpty(textureDirectoryStatus))
                    {
                        <p class="small text-muted">@textureDirectoryStatus</p>
                    }
                    @if (detectedMaterials.Count > 0)
                    {
                        <div class="list-group small mb-2">
                            @foreach (var material in detectedMaterials)
                            {
                                <div class="list-group-item">
                                    <strong>Slot @material.Index:</strong> @(material.GameMaterialName ?? material.Name ?? "Unnamed material")
                                    <div class="text-muted text-break">@((material.GameMaterialLink ?? material.Path).Replace('\\', '/'))</div>
                                </div>
                            }
                        </div>
                        <p class="small text-muted">Texture preview is local and read-only. Studio maps Trackmania PBR texture sets by native material link: <code>_D</code> base color, <code>_N</code> normal, <code>_R</code> roughness/metallic and <code>_I</code> self-illumination. It does not modify material, UV, collision, or export data.</p>
                    }
                    else
                    {
                        <p class="small text-muted">No authored material slots were found.</p>
                    }
                }

                @if (activeTab == "extras")
                {
                    <h6 class="border-bottom pb-1 text-primary">Audio, CPlugFx & MediaTracker Triggers <span class="text-muted" title="Audio, particle systems and MediaTracker zones are optional GBX nodes.">?</span></h6>
                    <div class="list-group small">
                        <div class="list-group-item d-flex justify-content-between"><span>WaypointType</span><strong>@itemModel.WaypointType</strong></div>
                        <div class="list-group-item d-flex justify-content-between"><span>Audio</span><strong>@(HasNode("CPlugSound", "CAudioSound") ? "Present" : "Not found")</strong></div>
                        <div class="list-group-item d-flex justify-content-between"><span>Particle system / CPlugFx</span><strong>@(HasNode("Particle", "CPlugFx") ? "Present" : "Not found")</strong></div>
                        <div class="list-group-item d-flex justify-content-between"><span>CGameCtnZone / MediaClip</span><strong>@(HasNode("CGameCtnZone", "MediaClip") ? "Present" : "Not found")</strong></div>
                    </div>
                    <p class="small text-muted mt-2">Trigger functions require the corresponding collision or zone node in the GBX file.</p>
                }

            </div>
            
            <div class="p-2 border-top bg-light d-flex justify-content-between align-items-center">
                <small class="text-muted">Item Studio v1.5</small>
                <button class="btn btn-sm btn-primary" disabled="@(!CanExportSelectedFile)" @onclick="@(() => ExportGbx())">
                    💾 Export selected file
                </button>
            </div>
            @if (SelectedSourceRequiresReencodingAcknowledgement)
            {
                <div class="p-2 border-top bg-light">
                    <div class="alert alert-warning small py-2 mb-2">
                        <strong>Compatibility check required.</strong> This source is re-encoded on export. A verified Blendermania pivot item remained inventory-visible and placeable after this writer, but other sources can still fail Trackmania discovery.
                    </div>
                    <div class="form-check">
                        <input id="acknowledge-reencoded-export" class="form-check-input" type="checkbox" @bind="acknowledgeReencodedExport" />
                        <label class="form-check-label small" for="acknowledge-reencoded-export">I will verify this source's exported item in a fresh Trackmania map editor session.</label>
                    </div>
                </div>
            }
            @if (CanCombineFiles)
            {
                <div class="p-2 border-top bg-light">
                    <button class="btn btn-sm btn-outline-primary" disabled="@(!CanExportCombinedFiles)" @onclick="@(() => ExportGbx(combineFiles: true))">Combine loaded files as variants</button>
                    <small class="d-block text-muted">Uses item metadata, icon and placement from @variantSources[0].Name.</small>
                </div>
            }
        </div>
    </div>
}

@code {
    private IEnumerable<(string Label, (ItemVariantSource Source, int Index)[] Entries)> LoadedFiles()
    {
        var files = variantSources.Select((source, index) => (Source: source, Index: index)).GroupBy(v => v.Source.GbxFile).ToArray();
        for (var i = 0; i < files.Length; i++)
        {
            var filename = files[i].First().Source.FileName;
            var label = files.Count(f => string.Equals(f.First().Source.FileName, filename, StringComparison.OrdinalIgnoreCase)) > 1
                ? $"{filename} (file {i + 1})" : filename;
            yield return (label, files[i].ToArray());
        }
    }

    private CGameItemModel? itemModel;
    private Gbx<CGameItemModel>? gbxFile;
    private bool isLoading = false;
    private string? errorMessage;
    private bool hasMesh = false;
    private bool isMovingItem = false;
    private bool isPlaying = true;
    private int vertexCount = 0;
    private bool isSelectingVariant;
    private bool isViewerInitialized = false;
    private string activeTab = "general";
    private DotNetObjectReference<Home>? dotNetHelper;
    private readonly List<ItemVariantSource> variantSources = new();
    private bool CanCombineFiles => variantSources.Select(source => source.GbxFile).Distinct().Take(2).Count() > 1;
    private int activeVariantIndex;
    private bool acknowledgeReencodedExport;
    private ItemVariantSource? SelectedSource => activeVariantIndex >= 0 && activeVariantIndex < variantSources.Count ? variantSources[activeVariantIndex] : null;
    private bool SelectedSourceRequiresReencodingAcknowledgement => SelectedSource?.RequiresReencodingAcknowledgement == true;
    private bool CanExportSelectedFile => !SelectedSourceRequiresReencodingAcknowledgement || acknowledgeReencodedExport;
    private bool CanExportCombinedFiles => !variantSources.Any(source => source.RequiresReencodingAcknowledgement) || acknowledgeReencodedExport;
    private string? iconFileName;
    private string? iconStatus;
    private bool iconPreviewPending;
    private IReadOnlyList<ItemSceneMaterial> detectedMaterials = Array.Empty<ItemSceneMaterial>();
    private string? textureDirectoryStatus;
    // Editable identification fields.
    private string identId = "";
    private string identAuthor = "";
    private string identCollection = "";

    // Viewport layer status
    private bool showMeshes = true;
    private bool showPivots = true;
    private bool showLights = true;

    // Animation.
    private string detectedAxis = "y";
    private bool isOscillating = false;
    private float minAngle = 0;
    private float maxAngle = 0;
    private string translationAxis = "y";
    private float translationDistance = 0;
    private float animationPeriodSeconds = 2;
    private float animationPhaseSeconds = 0;
    private float pivotOffsetX;
    private float pivotOffsetY;
    private float pivotOffsetZ;
    private bool harmonicEasing;
    private bool invertMotion;
    private bool hasTranslationMotion;
    private float[] translationMin = new float[3];
    private float[] translationMax = new float[3];
    private object? activeKinematicConstraint;
    private ItemSceneResult? authoredMotionScene;
    private readonly ItemSceneGeometryCache geometryCache = new();
    private readonly HashSet<int> uploadedGeometry = new();
    private readonly List<NPlugDyna_SKinematicConstraint> authoredConstraints = new();
    private IReadOnlyList<string> motionDiagnostics = Array.Empty<string>();
    private bool showOriginalMotion;
    private string originalConstraintType = "Not found";
    private readonly List<OriginalMotionSetting> originalMotionSettings = new();
    private bool originalMotionAvailable;
    private string originalAnimAxis = "y";
    private bool originalIsOscillating;
    private float originalMinAngle;
    private float originalMaxAngle;
    private string originalTranslationAxis = "y";
    private float originalTranslationDistance;
    private float originalAnimationPeriodSeconds = 2;
    private float originalAnimationPhaseSeconds;
    private bool originalHasTranslationMotion;
    private float[] originalTranslationMin = new float[3];
    private float[] originalTranslationMax = new float[3];
    private float[] originalPivotOffset = new float[3];

    public class ModelPart
    {
        public string Name { get; set; } = "";
        public bool IsMoving { get; set; }
        public float[] Positions { get; set; } = Array.Empty<float>();
        public int[] Indices { get; set; } = Array.Empty<int>();
    }

    public class PivotDto
    {
        public int Index { get; set; }
        public float X { get; set; }
        public float Y { get; set; }
        public float Z { get; set; }
    }

    public class LightDto
    {
        public string Type { get; set; } = "PointLight";
        public float X { get; set; }
        public float Y { get; set; }
        public float Z { get; set; }
        public string ColorHtml { get; set; } = "#fffbeb";
        public int ColorHex { get; set; } = 0xfffbeb;
        public float Intensity { get; set; } = 2.0f;
        public float Radius { get; set; } = 15.0f;
        public object? SourceNode { get; set; }
        // Position is display-only: the owner transform is not serialized by this editor,
        // so light gizmos never attach drag handles in the viewer.
        public bool Editable => false;
    }

    private sealed class OriginalMotionSetting
    {
        public string Name { get; init; } = "";
        public string Value { get; init; } = "";
    }

    private sealed class NormalizedIcon
    {
        public int[] Pixels { get; set; } = Array.Empty<int>();
        public string WebPBase64 { get; set; } = "";
    }

    private List<ModelPart> modelParts = new();
    private List<PivotDto> detectedPivots = new();
    private List<LightDto> detectedLights = new();
    private List<string> debugLog = new();
    private readonly HashSet<string> detectedNodeTypes = new(StringComparer.OrdinalIgnoreCase);
    // Collision capability is a read-only scene inventory; there is no toggle to persist.
    private IReadOnlyList<ItemSceneCollision> CollisionInventory =>
        authoredMotionScene?.Preview.Collisions ?? Array.Empty<ItemSceneCollision>();

    protected override void OnInitialized()
    {
        dotNetHelper = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("registerStudioDebug", dotNetHelper);
        if (itemModel == null || isViewerInitialized)
        {
            if (iconPreviewPending && itemModel != null)
            {
                await RenderIconPreview();
                iconPreviewPending = false;
            }
            return;
        }

        await JS.InvokeVoidAsync("init3DViewer", "threeContainer", dotNetHelper);
        isViewerInitialized = true;
        await UpdateScenePayload(authoredMotionScene);
        if (iconPreviewPending)
        {
            await RenderIconPreview();
            iconPreviewPending = false;
        }
    }

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        isLoading = true;
        errorMessage = null;
        variantSources.Clear();
        geometryCache.Clear();
        uploadedGeometry.Clear();
        activeVariantIndex = 0;
        acknowledgeReencodedExport = false;
        itemModel = null;
        hasMesh = false;
        isMovingItem = false;
        modelParts.Clear();
        detectedMaterials = Array.Empty<ItemSceneMaterial>();
        detectedPivots.Clear();
        detectedLights.Clear();
        detectedNodeTypes.Clear();
        debugLog.Clear();
        modelDiagnostics.Clear();
        detectedAxis = "y";
        isOscillating = false;
        minAngle = 0;
        maxAngle = 0;
        translationAxis = "y";
        translationDistance = 0;
        animationPeriodSeconds = 2;
        animationPhaseSeconds = 0;
        pivotOffsetX = pivotOffsetY = pivotOffsetZ = 0;
        harmonicEasing = false;
        invertMotion = false;
        hasTranslationMotion = false;
        translationMin = new float[3];
        translationMax = new float[3];
        activeKinematicConstraint = null;
        authoredMotionScene = null;
        authoredConstraints.Clear();
        motionDiagnostics = Array.Empty<string>();
        showOriginalMotion = false;
        originalConstraintType = "Not found";
        originalMotionSettings.Clear();
        originalMotionAvailable = false;
        StateHasChanged();

        try
        {
            if (isViewerInitialized)
            {
                isViewerInitialized = false;
                await JS.InvokeVoidAsync("dispose3DViewer");
            }

            foreach (var file in e.GetMultipleFiles(maximumFileCount: 16))
            {
                using var memoryStream = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(memoryStream);
                var originalBytes = memoryStream.ToArray();
                var parsedGbx = Gbx.Parse<CGameItemModel>(new MemoryStream(originalBytes));
                var parsedModel = parsedGbx.Node;
                if (parsedModel == null) continue;

                variantSources.AddRange(ItemVariantSource.FromFile(Path.GetFileNameWithoutExtension(file.Name), parsedGbx, originalBytes));
            }

            if (variantSources.Count > 0)
            {
                await SelectVariant(0);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error while processing the file: " + ex.Message;
        }
        finally
        {
            isLoading = false;
            if (itemModel is null) await RefreshDebugDiagnostics();
            StateHasChanged();
        }
    }

    private async Task SelectVariant(int index)
    {
        if (isSelectingVariant || index < 0 || index >= variantSources.Count) return;
        isSelectingVariant = true;
        errorMessage = null;
        try
        {
            StateHasChanged();
            await Task.Yield();
            await LoadVariant(index);
            StateHasChanged();
            await Task.Yield();
            await JS.InvokeVoidAsync("scrollSelectedVariantIntoView");
        }
        catch (Exception ex) { errorMessage = "Error while loading variant: " + ex.Message; }
        finally { isSelectingVariant = false; }
    }

    private async Task LoadVariant(int index)
    {
        activeVariantIndex = index;
        var source = variantSources[index];
        iconPreviewPending |= !ReferenceEquals(itemModel, source.Model);
        itemModel = source.Model;
        gbxFile = source.GbxFile;
        hasMesh = false;
        isMovingItem = false;
        modelParts.Clear();
        detectedPivots.Clear();
        detectedLights.Clear();
        detectedNodeTypes.Clear();
        detectedAxis = "y";
        isOscillating = false;
        minAngle = 0;
        maxAngle = 0;
        translationAxis = "y";
        translationDistance = 0;
        animationPeriodSeconds = 2;
        animationPhaseSeconds = 0;
        pivotOffsetX = pivotOffsetY = pivotOffsetZ = 0;
        harmonicEasing = false;
        invertMotion = false;
        hasTranslationMotion = false;
        translationMin = new float[3];
        translationMax = new float[3];
        activeKinematicConstraint = null;
        showOriginalMotion = false;
        originalConstraintType = "Not found";
        originalMotionSettings.Clear();
        originalMotionAvailable = false;

        identId = itemModel.Ident?.Id ?? "";
        identAuthor = itemModel.Ident?.Author ?? "";
        identCollection = itemModel.Ident?.Collection.ToString() ?? "";
        authoredMotionScene = ReadSelectedScene();
        detectedMaterials = authoredMotionScene.Preview.Materials;
        authoredConstraints.Clear();
        authoredConstraints.AddRange(authoredMotionScene.Handles.Sources.Values.OfType<NPlugDyna_SKinematicConstraint>());
        ExtractParts(source.PreviewRoot, includeGeometry: authoredConstraints.Count == 0);
        ExtractPivots(itemModel);
        if (authoredConstraints.Count > 0) UseAuthoredModelParts(authoredMotionScene);
        isMovingItem = isMovingItem || authoredConstraints.Count > 0;
        motionDiagnostics = AuthoredMotionPreview.Build(authoredMotionScene).Diagnostics;

        if (modelParts.Count > 0)
        {
            hasMesh = true;
            vertexCount = modelParts.Sum(p => p.Positions.Length / 3);
        }

        if (isViewerInitialized)
            await UpdateScenePayload(authoredMotionScene);
        else
            StateHasChanged();
        await RefreshDebugDiagnostics();
    }

    private string BuildObjExport()
    {
        var sb = new StringBuilder();
        sb.AppendLine("# Trackmania Item Studio OBJ Export");
        var totalIndexOffset = 0;
        foreach (var part in modelParts)
        {
            sb.AppendLine($"o {part.Name}");
            for (var i = 0; i < part.Positions.Length; i += 3)
                sb.AppendLine(string.Format(CultureInfo.InvariantCulture, "v {0:F4} {1:F4} {2:F4}", part.Positions[i], part.Positions[i + 1], part.Positions[i + 2]));
            for (var i = 0; i + 2 < part.Indices.Length; i += 3)
                sb.AppendLine($"f {part.Indices[i] + totalIndexOffset + 1} {part.Indices[i + 1] + totalIndexOffset + 1} {part.Indices[i + 2] + totalIndexOffset + 1}");
            totalIndexOffset += part.Positions.Length / 3;
        }
        return sb.ToString();
    }

    private void UseAuthoredModelParts(ItemSceneResult selectedScene)
    {
        var movingPaths = AuthoredMotionPreview.Build(selectedScene).Tracks.Select(t => t.ChildPath).ToHashSet();
        modelParts = selectedScene.Preview.Geometry.Where(g => !g.IsCollision).Select(g => new ModelPart
        {
            Name = g.Path, IsMoving = g.EntityPath is not null && movingPaths.Contains(g.EntityPath),
            Positions = g.Positions, Indices = g.Indices
        }).ToList();
    }

    private ItemSceneResult ReadSelectedScene()
    {
        var source = variantSources[activeVariantIndex];
        var document = variantSources.Select(s => s.GbxFile).Distinct().ToList().IndexOf(source.GbxFile);
        int? variant = source.Model.EntityModel is NPlugItem_SVariantList { Variants: { } variants } && source.Variant is { } selected
            ? Array.IndexOf(variants, selected) : null;
        return ItemScene.Build(source.PreviewRoot, document, variant, geometryCache);
    }

    private Task UpdateScenePayload()
    {
        // All edit callbacks enter here. Invalidate shared sources across every variant,
        // including in-place array edits; selection alone keeps the document's geometry.
        geometryCache.Clear();
        uploadedGeometry.Clear();
        return UpdateScenePayload(null);
    }

    private async Task UpdateScenePayload(ItemSceneResult? selectedScene)
    {
        if (authoredMotionScene is { } authoredScene)
        {
            // Traversal and motion stay fresh; immutable geometry survives selection.
            authoredScene = selectedScene ?? ReadSelectedScene();
            authoredMotionScene = authoredScene;
            UseAuthoredModelParts(authoredScene);
            var motion = AuthoredMotionPreview.Build(authoredScene);
            motionDiagnostics = motion.Diagnostics;
            var definitions = authoredScene.Preview.Geometry.Where(g => g.GeometryId.HasValue && !uploadedGeometry.Contains(g.GeometryId.Value))
                .GroupBy(g => g.GeometryId!.Value).Select(group => group.First()).ToArray();
            var epoch = geometryCache.Epoch;
            await JS.InvokeVoidAsync("renderStudioScene", new
            {
                geometryEpoch = epoch,
                geometryDefinitions = definitions.Select(g => new { geometryId = g.GeometryId,
                    positionsBytes = ViewerBuffers.Pack(g.LocalPositions), indicesBytes = ViewerBuffers.Pack(g.Indices),
                    normalsBytes = g.LocalNormals is null ? null : ViewerBuffers.Pack(g.LocalNormals) }),
                parts = authoredScene.Preview.Geometry.Select(g => new
                {
                    path = g.Path, entityPath = g.EntityPath, geometryId = g.GeometryId, worldTransform = g.WorldTransform,
                    positionsBytes = g.GeometryId.HasValue ? null : ViewerBuffers.Pack(g.Positions),
                    indicesBytes = g.GeometryId.HasValue ? null : ViewerBuffers.Pack(g.Indices),
                    normalsBytes = g.GeometryId.HasValue || g.Normals is null ? null : ViewerBuffers.Pack(g.Normals),
                    isCollision = g.IsCollision,
                    mappings = MappingsForVisual(authoredScene.Preview, g.Path)
                }),
                materials = authoredScene.Preview.Materials.Select(material => new
                {
                    material.Path, material.GameMaterialName, material.GameMaterialLink
                }),
                motions = motion.Tracks,
                pivots = detectedPivots, lights = detectedLights,
                playing = isPlaying
            });
            if (geometryCache.Epoch == epoch)
                foreach (var definition in definitions) uploadedGeometry.Add(definition.GeometryId!.Value);
            return;
        }
        var scenePayload = new
        {
            geometryEpoch = geometryCache.Epoch,
            parts = modelParts.Select(p => new { p.Name, p.IsMoving,
                positionsBytes = ViewerBuffers.Pack(p.Positions), indicesBytes = ViewerBuffers.Pack(p.Indices),
                mappings = authoredMotionScene is null ? [] : MappingsForVisual(authoredMotionScene.Preview, p.Name) }),
            materials = authoredMotionScene?.Preview.Materials.Select(material => new
            {
                material.Path, material.GameMaterialName, material.GameMaterialLink
            }),
            pivots = detectedPivots,
            lights = detectedLights,
            animAxis = detectedAxis,
            isOscillating = isOscillating,
            minAngle = minAngle,
            maxAngle = maxAngle,
            translationAxis = translationAxis,
            translationDistance = translationDistance,
            hasTranslationMotion = hasTranslationMotion,
            translationMin = translationMin,
            translationMax = translationMax,
            animationPeriodSeconds = animationPeriodSeconds,
            animationPhaseSeconds = animationPhaseSeconds,
            pivotOffset = new[] { pivotOffsetX, pivotOffsetY, pivotOffsetZ },
            harmonicEasing = harmonicEasing,
            invertMotion = invertMotion,
            playing = isPlaying
        };

        await JS.InvokeVoidAsync("renderStudioScene", scenePayload);
    }

    private static object[] MappingsForVisual(ItemScenePreview scene, string visualPath)
    {
        const string visualMarker = "/visual:";
        var marker = visualPath.LastIndexOf(visualMarker, StringComparison.Ordinal);
        if (marker < 0) return [];
        var solidPath = visualPath[..marker];
        return scene.Mappings.Where(mapping => mapping.SolidPath == solidPath).Select(mapping => (object)new
        {
            materialIndex = mapping.MaterialIndex,
            materialPath = $"{mapping.SolidPath}/material:{mapping.MaterialIndex}",
            lodMask = mapping.LodMask
        }).ToArray();
    }

