        isMovingItem = authoredConstraints.Count > 0;
        await UpdateScenePayload(authoredMotionScene);
        await RefreshDebugDiagnostics();
    }

    private async Task ApplyPathPreset()
    {
        if (authoredConstraints.Count == 0 || authoredMotionScene is null)
            return;

        var firstConstraint = authoredConstraints[0];
        var entry = authoredMotionScene.Handles.Entries.FirstOrDefault(handle => ReferenceEquals(handle.Entry.Model, firstConstraint));
        if (entry is null) return;

        var axis1 = pathSegment1Axis.ToLowerInvariant() switch
        {
            "x" => KC.EAxis.X,
            "y" => KC.EAxis.Y,
            "z" => KC.EAxis.Z,
            _ => KC.EAxis.X
        };
        var axis2 = pathSegment2Axis.ToLowerInvariant() switch
        {
            "x" => KC.EAxis.X,
            "y" => KC.EAxis.Y,
            "z" => KC.EAxis.Z,
            _ => KC.EAxis.Y
        };
        var dur1Ms = Math.Max(50, (int)(pathSegment1Duration * 1000));
        var dur2Ms = Math.Max(50, (int)(pathSegment2Duration * 1000));

        switch (pathPresetMode)
        {
            case "relay":
            {
                var result = ItemKinematicEntityTemplate.ConfigureRelayCollisionPath(
                    entry.Prefab, firstConstraint, entry.PrefabPath,
                    axis1, pathSegment1Distance, dur1Ms,
                    axis2, pathSegment2Distance, dur2Ms);
                if (result.Success)
                    pathStatusMessage = "A ➔ B ➔ C relay path generated. Native motion and vehicle contact are not yet verified.";
                else
                    errorMessage = "Error generating relay path: " + result.Reason;
                break;
            }
            case "single_axis":
            {
                var result = ItemKinematicEntityTemplate.ConfigureSingleAxisMotion(
                    firstConstraint, axis1, pathSegment1Distance, dur1Ms, pathIsPingPong);
                if (result.Success)
                    pathStatusMessage = "1-axis linear motion configured. Native motion and vehicle contact are not yet verified.";
                break;
            }
            case "rotation":
            {
                var result = ItemKinematicEntityTemplate.ConfigureRotationMotion(
                    firstConstraint, axis1, 0, 360, dur1Ms, isOscillating: false);
                if (result.Success)
                    pathStatusMessage = "Rotation motion configured. Native motion and vehicle contact are not yet verified.";
                break;
            }
        }

        geometryCache.Clear();
        uploadedGeometry.Clear();
        authoredMotionScene = ReadSelectedScene();
        authoredConstraints.Clear();
        authoredConstraints.AddRange(authoredMotionScene.Handles.Sources.Values.OfType<KC>());
        await UpdateScenePayload(authoredMotionScene);
        await RefreshDebugDiagnostics();
        StateHasChanged();
    }

    private bool IsRootConstraint(NPlugDyna_SKinematicConstraint source)
    {
        if (authoredMotionScene is null) return true;
        var entry = authoredMotionScene.Handles.Entries.FirstOrDefault(handle => ReferenceEquals(handle.Entry.Model, source));
        if (entry?.Entry.Params is not NPlugDyna_SPrefabConstraintParams parameters) return true;
        return parameters.Ent1 == -1;
    }

    private NPlugDyna_SPrefabConstraintParams? GetConstraintParameters(NPlugDyna_SKinematicConstraint source)
    {
        if (authoredMotionScene is null) return null;
        var entry = authoredMotionScene.Handles.Entries.FirstOrDefault(handle => ReferenceEquals(handle.Entry.Model, source));
        return entry?.Entry.Params as NPlugDyna_SPrefabConstraintParams;
    }

    private string? GetBindingDescription(NPlugDyna_SKinematicConstraint source)
    {
        if (authoredMotionScene is null) return null;
        var entry = authoredMotionScene.Handles.Entries.FirstOrDefault(handle => ReferenceEquals(handle.Entry.Model, source));
        if (entry?.Entry.Params is not NPlugDyna_SPrefabConstraintParams parameters) return null;
        var parentLabel = parameters.Ent1 == -1 ? "World (fixed ground)" : $"Carrier / Parent (Body {parameters.Ent1})";
        var childLabel = $"Body {parameters.Ent2}";
        return $"{parentLabel} ➔ {childLabel}";
    }

    private async Task UploadMovingTemplate(InputFileChangeEventArgs e)
    {
        if (e.File is null)
            return;
        try
        {
            using var stream = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024).CopyToAsync(stream);
            var parsed = Gbx.Parse<CGameItemModel>(new MemoryStream(stream.ToArray()));
            uploadedMovingTemplate = parsed.Node;
            movingTemplateStatus = $"Loaded moving template: {e.File.Name}";
            errorMessage = null;
        }
        catch (Exception ex)
        {
            uploadedMovingTemplate = null;
            movingTemplateStatus = null;
            errorMessage = "Could not load moving template item: " + ex.Message;
        }
    }

    private async Task UploadConstraintTemplate(InputFileChangeEventArgs e)
    {
        if (e.File is null)
            return;
        try
        {
            using var stream = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(stream);
            var parsed = Gbx.Parse<NPlugDyna_SKinematicConstraint>(new MemoryStream(stream.ToArray()));
            uploadedConstraintTemplate = parsed.Node;
            constraintTemplateStatus = $"Loaded constraint template: {e.File.Name}";
            errorMessage = null;
        }
        catch (Exception ex)
        {
            uploadedConstraintTemplate = null;
            constraintTemplateStatus = null;
            errorMessage = "Could not load constraint template: " + ex.Message;
        }
    }

    private CGameItemModel? FindMovingTemplateVariant()
    {
        for (var index = 0; index < variantSources.Count; index++)
        {
            if (index == activeVariantIndex)
                continue;

            var candidate = variantSources[index].Model;
            if (candidate.EntityModel is CPlugPrefab { Ents: { Length: > 0 } entries }
                && entries.Any(static entry => entry.Model is NPlugDyna_SKinematicConstraint))
            {
                return candidate;
            }
        }

        return null;
    }

    private bool IsInvisibleDriverConstraint(NPlugDyna_SKinematicConstraint source)
    {
        if (authoredMotionScene is null) return false;
        var entry = authoredMotionScene.Handles.Entries.FirstOrDefault(handle => ReferenceEquals(handle.Entry.Model, source));
        if (entry?.Entry.Params is not NPlugDyna_SPrefabConstraintParams parameters) return false;
        var binding = AuthoredMotionPreview.Resolve(source, authoredMotionScene, parameters);
        return binding.Status == ItemMotionStatus.Supported
            && binding.Child.SourceEntry?.Model is CPlugDynaObjectModel
            {
                Mesh: null,
                StaticShape: null,
                DynaShape: null
            };
    }

    private bool IsVisiblePathProxyConstraint(NPlugDyna_SKinematicConstraint source)
    {
        if (visualPathProxies.Contains(source)) return true;
        if (authoredMotionScene is null) return false;
        var entry = authoredMotionScene.Handles.Entries.FirstOrDefault(handle => ReferenceEquals(handle.Entry.Model, source));
        if (entry?.Entry.Params is not NPlugDyna_SPrefabConstraintParams parameters) return false;
        var binding = AuthoredMotionPreview.Resolve(source, authoredMotionScene, parameters);
        if (binding.Status != ItemMotionStatus.Supported || binding.Child.SourceEntry?.Model is not CPlugDynaObjectModel { Mesh: not null })
            return false;

        // A visible body's world-relative constraint becomes a path proxy when
        // another local constraint names its filtered slot as the parent.
        return authoredMotionScene.Handles.Entries.Any(candidate =>
            candidate.Prefab == entry.Prefab
            && candidate.Entry.Params is NPlugDyna_SPrefabConstraintParams candidateParameters
            && !ReferenceEquals(candidate.Entry.Model, source)
            && candidateParameters.Ent1 == binding.Child.RawSlot);
    }

    private sealed record CompositeSceneEntry(int SourceIndex, int DocumentOrdinal, ItemVariantSource Source, ItemSceneResult Scene);

    private IReadOnlyList<CompositeSceneEntry> BuildCompositeScenes()
    {
        var selected = CompositeViewportSources();
        var scenes = new List<CompositeSceneEntry>(selected.Count);
        compositeDocToSourceIndex.Clear();
        foreach (var part in selected)
        {
            var scene = ReadSceneForSourceIndex(part.SourceIndex, part.DocumentOrdinal);
            scenes.Add(new CompositeSceneEntry(part.SourceIndex, part.DocumentOrdinal, part.Source, scene));
            compositeDocToSourceIndex[part.DocumentOrdinal] = part.SourceIndex;
        }
        return scenes;
    }

    private async Task UpdateScenePayload(ItemSceneResult? selectedScene)
    {
        if (authoredMotionScene is { } authoredScene)
        {
            // Traversal and motion stay fresh; immutable geometry survives selection.
            var useComposite = compositeViewportMode && CanCombineFiles;
            var composite = useComposite ? BuildCompositeScenes() : Array.Empty<CompositeSceneEntry>();
            var selectedComposite = useComposite
                ? composite.FirstOrDefault(entry => entry.SourceIndex == activeVariantIndex) ?? composite.First()
                : null;

            authoredScene = selectedScene ?? selectedComposite?.Scene ?? ReadSelectedScene();
            authoredMotionScene = authoredScene;
            if (selectedComposite is not null && selectedComposite.SourceIndex != activeVariantIndex)
            {
                activeVariantIndex = selectedComposite.SourceIndex;
                itemModel = selectedComposite.Source.Model;
                gbxFile = selectedComposite.Source.GbxFile;
            }

            UseAuthoredModelParts(authoredScene);
            var selectedMotion = AuthoredMotionPreview.Build(authoredScene);
            motionDiagnostics = selectedMotion.Diagnostics;
            var epoch = geometryCache.Epoch;

            var allScenes = useComposite ? composite.Select(entry => entry.Scene).ToArray() : new[] { authoredScene };
            var definitions = allScenes.SelectMany(scene => scene.Preview.Geometry)
                .Where(geometry => geometry.GeometryId.HasValue && !uploadedGeometry.Contains(geometry.GeometryId.Value))
                .GroupBy(geometry => geometry.GeometryId!.Value)
                .Select(group => group.First())
                .ToArray();

            var rawTracks = (useComposite ? composite : [new CompositeSceneEntry(activeVariantIndex, 0, variantSources[activeVariantIndex], authoredScene)])
                .SelectMany(entry =>
                {
                    var motion = AuthoredMotionPreview.Build(entry.Scene);
                    return motion.Tracks.Select(track =>
                    {
                        var handle = entry.Scene.Handles.Entries.FirstOrDefault(e => e.Path == track.Path);
                        var constraint = handle?.Entry.Model as NPlugDyna_SKinematicConstraint;
                        var index = entry.SourceIndex == activeVariantIndex && constraint is not null
                            ? authoredConstraints.IndexOf(constraint)
                            : -1;
                        return new
                        {
                            entry.SourceIndex,
                            Track = track,
                            ConstraintIndex = index >= 0 ? index : (int?)null
                        };
                    });
                })
                .ToArray();

            var adjustedChildRestByPath = new Dictionary<string, float[]>(StringComparer.Ordinal);
            foreach (var row in rawTracks)
            {
                var adjustedChild = ApplyCompositeOffsetToMotionRest(row.Track.ChildRest, row.SourceIndex, useComposite);
                adjustedChildRestByPath[row.Track.ChildPath] = adjustedChild ?? row.Track.ChildRest;
            }

            var tracksPayload = rawTracks.Select(row =>
            {
                var parentRest = row.Track.ParentPath is not null
                    && adjustedChildRestByPath.TryGetValue(row.Track.ParentPath, out var parentChildRest)
                    ? parentChildRest
                    : row.Track.ParentRest;
                return new
                {
                    sourceIndex = row.SourceIndex,
                    row.Track.Path,
                    row.Track.ChildPath,
                    row.Track.ParentPath,
                    ChildRest = adjustedChildRestByPath[row.Track.ChildPath],
                    ParentRest = parentRest,
                    row.Track.Pos1,
                    row.Track.Pos2,
                    row.Track.Fields,
                    constraintIndex = row.ConstraintIndex
                };
            });
            static int AxisToIndex(string? axis)
                => axis?.ToUpperInvariant() switch { "X" => 0, "Z" => 2, _ => 1 };
            static int EaseToInt(string? ease)
                => ease?.ToLowerInvariant() switch
                {
                    "constant" => 0,
                    "linear" => 1,
                    "quadin" => 2,
                    "quadout" => 3,
                    "quadinout" => 4,
                    _ => 1
                };
            var groupMotionsPayload = useComposite
                ? compositeGroupBySourceIndex.Values
                    .Distinct()
                    .Where(groupId =>
                        compositeGroupMotions.TryGetValue(groupId, out var motion)
                        && motion.Enabled
                        && compositeGroupBySourceIndex.Any(pair => pair.Value == groupId))
                    .Select(groupId =>
                    {
                        var motion = GetCompositeGroupMotion(groupId);
                        var groupTransform = GetCompositeGroupTransform(groupId);
                        return new
                        {
                            groupId,
                            pivotX = groupTransform.PivotX,
                            pivotY = groupTransform.PivotY,
                            pivotZ = groupTransform.PivotZ,
                            fields = new
                            {
                                translationAxis = AxisToIndex(motion.TransAxis),
                                translationMin = motion.TransMin,
                                translationMax = motion.TransMax,
                                angleMinDegrees = motion.RotMinDeg,
                                angleMaxDegrees = motion.RotMaxDeg,
                                rotationAxis = AxisToIndex(motion.RotAxis),
                                translation = new
                                {
                                    isDuration = true,
                                    keys = new[]
                                    {
                                        new { ease = EaseToInt(motion.TransEaseA), reverse = motion.TransReverseA, durationMilliseconds = Math.Max(50, motion.TransDurationA) },
                                        new { ease = EaseToInt(motion.TransEaseB), reverse = motion.TransReverseB, durationMilliseconds = Math.Max(50, motion.TransDurationB) },
                                        new { ease = EaseToInt(motion.TransEaseC), reverse = motion.TransReverseC, durationMilliseconds = Math.Max(50, motion.TransDurationC) },
                                        new { ease = EaseToInt(motion.TransEaseD), reverse = motion.TransReverseD, durationMilliseconds = Math.Max(50, motion.TransDurationD) }
                                    }
                                },
                                rotation = new
                                {
                                    isDuration = true,
                                    keys = new[]
                                    {
                                        new { ease = EaseToInt(motion.RotEaseA), reverse = motion.RotReverseA, durationMilliseconds = Math.Max(50, motion.RotDurationA) },
                                        new { ease = EaseToInt(motion.RotEaseB), reverse = motion.RotReverseB, durationMilliseconds = Math.Max(50, motion.RotDurationB) },
                                        new { ease = EaseToInt(motion.RotEaseC), reverse = motion.RotReverseC, durationMilliseconds = Math.Max(50, motion.RotDurationC) },
                                        new { ease = EaseToInt(motion.RotEaseD), reverse = motion.RotReverseD, durationMilliseconds = Math.Max(50, motion.RotDurationD) }
                                    }
                                }
                            }
                        };
                    })
                    .Select(entry => (object)entry)
                    .ToArray()
                : Array.Empty<object>();

            var allParts = (useComposite ? composite : [new CompositeSceneEntry(activeVariantIndex, 0, variantSources[activeVariantIndex], authoredScene)])
                .SelectMany(entry => entry.Scene.Preview.Geometry.Select(geometry => new { entry, geometry }))
                .ToArray();

            // Every macroblock copy is one more part that reuses the item's shared geometry and
            // only carries a placement, so the viewport shows the instances where they are placed.
            var instanceParts = BuildMacroblockInstanceParts(authoredScene, activeVariantIndex);

            await JS.InvokeVoidAsync("renderStudioScene", new
            {
                geometryEpoch = epoch,
                geometryDefinitions = definitions.Select(g => new
                {
                    geometryId = g.GeometryId,
                    positionsBytes = ViewerBuffers.Pack(g.LocalPositions),
                    indicesBytes = ViewerBuffers.Pack(g.Indices),
                    normalsBytes = g.LocalNormals is null ? null : ViewerBuffers.Pack(g.LocalNormals),
                    uvsBytes = PrimaryUvBytes(g),
                    animationPositionsBytes = g.AnimationLocalPositions is null ? null : ViewerBuffers.Pack(g.AnimationLocalPositions),
                    animationNormalsBytes = g.AnimationLocalNormals is null ? null : ViewerBuffers.Pack(g.AnimationLocalNormals),
                    animationFrameCount = g.AnimationFrameCount,
                    animationPeriodSeconds = g.AnimationPeriodSeconds
                }),
                parts = allParts.Select(part => (object)new
                {
                    path = part.geometry.Path,
                    entityPath = part.geometry.EntityPath,
                    sourceIndex = part.entry.SourceIndex,
                    groupId = useComposite && compositeGroupBySourceIndex.TryGetValue(part.entry.SourceIndex, out var sourceGroupId)
                        ? sourceGroupId
                        : (int?)null,
                    geometryId = part.geometry.GeometryId,
                    worldTransform = ApplyCompositeWorldOffset(part.geometry.WorldTransform, part.entry.SourceIndex, useComposite),
                     positionsBytes = part.geometry.GeometryId.HasValue ? null : ViewerBuffers.Pack(part.geometry.Positions),
                     indicesBytes = part.geometry.GeometryId.HasValue ? null : ViewerBuffers.Pack(part.geometry.Indices),
                     normalsBytes = part.geometry.GeometryId.HasValue || part.geometry.Normals is null ? null : ViewerBuffers.Pack(part.geometry.Normals),
                     uvsBytes = part.geometry.GeometryId.HasValue ? null : PrimaryUvBytes(part.geometry),
                     animationPositionsBytes = part.geometry.GeometryId.HasValue || part.geometry.AnimationPositions is null ? null : ViewerBuffers.Pack(part.geometry.AnimationPositions),
                     animationNormalsBytes = part.geometry.GeometryId.HasValue || part.geometry.AnimationNormals is null ? null : ViewerBuffers.Pack(part.geometry.AnimationNormals),
                     animationFrameCount = part.geometry.AnimationFrameCount,
                     animationPeriodSeconds = part.geometry.AnimationPeriodSeconds,
                     isCollision = part.geometry.IsCollision && !forcedRenderableGeometryPaths.Contains(part.geometry.Path),
                    meshMode = GetMeshPartMode(part.geometry.Path),
                    enabled = GetMeshPartConfig(part.geometry.Path).Enabled,
                    visible = GetMeshPartConfig(part.geometry.Path).Visible,
                    collidable = GetMeshPartConfig(part.geometry.Path).Collidable,
                    effect = GetMeshPartConfig(part.geometry.Path).Effect,
                    waypoint = GetMeshPartConfig(part.geometry.Path).Waypoint,
                    movable = GetMeshPartConfig(part.geometry.Path).Movable,
                    mappings = MappingsForVisual(part.entry.Scene.Preview, part.geometry.Path)
                }).Concat(instanceParts).ToArray(),
                materials = authoredScene.Preview.Materials.Select(material => new
                {
                    material.Path, material.GameMaterialName, material.GameMaterialLink, material.Color, material.TexturePaths
                }),
                compositeOffsets = useComposite
                    ? composite.Select(part =>
                    {
                        var offset = GetCompositeWorldOffset(part.SourceIndex);
                        return (object)new
                        {
                            index = part.SourceIndex,
                            x = offset.X,
                            y = offset.Y,
                            z = offset.Z,
                            rotX = offset.RotX,
                            rotY = offset.RotY,
                            rotZ = offset.RotZ,
                            editable = true
                        };
                    })
                    : Array.Empty<object>(),
                compositeGroups = useComposite
                    ? compositeGroupTransforms
                        .Where(group => compositeGroupBySourceIndex.Values.Contains(group.Key))
                        .OrderBy(group => group.Key)
                        .Select(group => (object)new
                        {
                            index = group.Key,
                            x = group.Value.X,
                            y = group.Value.Y,
                            z = group.Value.Z,
                            rotX = group.Value.RotX,
                            rotY = group.Value.RotY,
                            rotZ = group.Value.RotZ,
                            pivotX = group.Value.PivotX,
                            pivotY = group.Value.PivotY,
                            pivotZ = group.Value.PivotZ,
                            editable = true
                        })
                    : Array.Empty<object>(),
                motions = tracksPayload,
                groupMotions = groupMotionsPayload,
                activeConstraintIndex = selectedConstraintIndex,
                selectedMeshPath = selectedMeshPartPath,
                compositeSelection = useComposite
                    ? new
                    {
                        selectedSourceIndices = compositeSelectionOrder.ToArray(),
                        leaderSourceIndex = compositeSelectionOrder.Count > 0 ? compositeSelectionOrder[0] : -1,
                        sourceGroups = compositeGroupBySourceIndex
                            .Select(pair => new { sourceIndex = pair.Key, groupId = pair.Value })
                            .ToArray()
                    }
                    : null,
                pivots = detectedPivots, lights = detectedLights,
                fxEmitter = HasFxCarrier
                    ? new { index = 0, x = fxEmitterX, y = fxEmitterY, z = fxEmitterZ, editable = IsOpaqueFxCarrier }
                    : null,
                playing = isPlaying
            });
            if (geometryCache.Epoch == epoch)
                foreach (var definition in definitions) uploadedGeometry.Add(definition.GeometryId!.Value);
            return;
        }
        var scenePayload = new
        {
            geometryEpoch = geometryCache.Epoch,
            parts = modelParts.Select(p => (object)new { path = p.Path, name = p.Name, p.IsMoving,
                positionsBytes = ViewerBuffers.Pack(p.Positions), indicesBytes = ViewerBuffers.Pack(p.Indices),
                meshMode = GetMeshPartMode(p.Path),
                enabled = GetMeshPartConfig(p.Path).Enabled,
                visible = GetMeshPartConfig(p.Path).Visible,
                collidable = GetMeshPartConfig(p.Path).Collidable,
                effect = GetMeshPartConfig(p.Path).Effect,
                waypoint = GetMeshPartConfig(p.Path).Waypoint,
                movable = GetMeshPartConfig(p.Path).Movable,
                mappings = authoredMotionScene is null ? [] : MappingsForVisual(authoredMotionScene.Preview, p.Path) })
                .Concat(BuildPlainInstanceParts()).ToArray(),
            materials = authoredMotionScene?.Preview.Materials.Select(material => new
            {
                material.Path, material.GameMaterialName, material.GameMaterialLink, material.Color, material.TexturePaths
            }),
            selectedMeshPath = selectedMeshPartPath,
            pivots = detectedPivots,
            lights = detectedLights,
            fxEmitter = HasFxCarrier
                ? new { index = 0, x = fxEmitterX, y = fxEmitterY, z = fxEmitterZ, editable = IsOpaqueFxCarrier }
                : null,
            animAxis = detectedAxis,
            isOscillating = isOscillating,
            minAngle = minAngle,
            maxAngle = maxAngle,
            translationAxis = translationAxis,
            translationDistance = translationDistance,
            hasTranslationMotion = hasTranslationMotion,
            translationMin = translationMin,
            translationMax = translationMax,
            animationPeriodSeconds = animationPeriodSeconds,
            animationPhaseSeconds = animationPhaseSeconds,
            pivotOffset = new[] { pivotOffsetX, pivotOffsetY, pivotOffsetZ },
            harmonicEasing = harmonicEasing,
            invertMotion = invertMotion,
            playing = isPlaying
        };

        await JS.InvokeVoidAsync("renderStudioScene", scenePayload);
    }

    private static object[] MappingsForVisual(ItemScenePreview scene, string visualPath)
    {
        const string visualMarker = "/visual:";
        var marker = visualPath.LastIndexOf(visualMarker, StringComparison.Ordinal);
        if (marker < 0) return [];
        var solidPath = visualPath[..marker];
        if (!int.TryParse(visualPath[(marker + visualMarker.Length)..], NumberStyles.Integer, CultureInfo.InvariantCulture, out var visualIndex))
            return [];
        return scene.Mappings.Where(mapping => mapping.SolidPath == solidPath && mapping.VisualIndex == visualIndex).Select(mapping => (object)new
        {
            materialIndex = mapping.MaterialIndex,
            materialPath = $"{mapping.SolidPath}/material:{mapping.MaterialIndex}",
            lodMask = mapping.LodMask
        }).ToArray();
    }

    private static byte[]? PrimaryUvBytes(ItemSceneGeometry geometry)
        => geometry.UVs.TryGetValue(0, out var uvs) ? ViewerBuffers.Pack(uvs) : null;

    private string MaterialEditorId(string materialPath)
        => "material-link-" + Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(materialPath))).ToLowerInvariant()[..12];

    private string MaterialLinkValue(ItemSceneMaterial material)
        => material.GameMaterialLink ?? material.Name ?? string.Empty;

    private IEnumerable<string> MaterialOptionsFor(ItemSceneMaterial material)
    {
        var current = MaterialLinkValue(material);
        if (!string.IsNullOrWhiteSpace(current) && !materialLibrary.Any(entry => entry.Path.Equals(current, StringComparison.OrdinalIgnoreCase)))
            yield return current;
        foreach (var entry in materialLibrary)
            yield return entry.Path;
    }

    private bool CanEditMaterial(ItemSceneMaterial material)
        => material.SourceId is int id && authoredMotionScene is not null
            && authoredMotionScene.Handles.Sources.TryGetValue(id, out var source)
            && source is CPlugSolid2Model.Material or CPlugCrystal.Material;

    private async Task OnMaterialLinkChanged(string materialPath, ChangeEventArgs args)
    {
        var link = args.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(link) || authoredMotionScene is null)
            return;
        var descriptor = authoredMotionScene.Preview.Materials.FirstOrDefault(material => material.Path == materialPath);
        if (descriptor is null || descriptor.SourceId is not int sourceId
            || !authoredMotionScene.Handles.Sources.TryGetValue(sourceId, out var source)
            || source is not (CPlugSolid2Model.Material or CPlugCrystal.Material))
        {
            errorMessage = "This material slot is read-only because its authored material instance is not exposed by the GBX data.";
            return;
        }

        ItemMaterialEdits.SetGameMaterialLink(source, link);
        authoredMotionScene = ReadSelectedScene();
        detectedMaterials = authoredMotionScene.Preview.Materials;
        statusMessage = $"Updated material slot {descriptor.Index} to {link}. The live preview and the next GBX export use this link.";
        errorMessage = null;
        await UpdateScenePayload(authoredMotionScene);
    }

