    private async Task ConvertStaticItemToKinematic()
    {
        if (itemModel is null)
            return;

        var movingTemplate = uploadedMovingTemplate ?? FindMovingTemplateVariant() ?? ItemKinematicEntityTemplate.GetDefaultMovingTemplate();
        var constraintTemplate = uploadedConstraintTemplate;
        var result = ItemKinematicEntityTemplate.ConvertStaticToKinematic(itemModel, movingTemplate, constraintTemplate);
        if (!result.Success)
        {
            errorMessage = "Could not convert this static item: " + result.Reason;
            return;
        }

        var converted = result.Value!;
        itemModel.EntityModel = converted.EntityModel;
        itemModel.ItemType = converted.ItemType;
        itemModel.ItemTypeE = converted.ItemTypeE;
        itemModel.DefaultPlacement = converted.DefaultPlacement;
        itemModel.GroundPoint = converted.GroundPoint;
        itemModel.Name = converted.Name;
        itemModel.Ident = converted.Ident;
        itemModel.Icon = converted.Icon;
        itemModel.IconWebP = converted.IconWebP;
        itemModel.OrbitalCenterHeightFromGround = converted.OrbitalCenterHeightFromGround;
        itemModel.OrbitalPreviewAngle = converted.OrbitalPreviewAngle;
        itemModel.OrbitalRadiusBase = converted.OrbitalRadiusBase;

        isMovingItem = true;
        authoredMotionScene = ReadSelectedScene();
        authoredConstraints.Clear();
        authoredConstraints.AddRange(authoredMotionScene.Handles.Sources.Values.OfType<NPlugDyna_SKinematicConstraint>());
        errorMessage = null;
        kinematicTemplateStatus = uploadedMovingTemplate is null && FindMovingTemplateVariant() is null
            ? "Converted to KinematicObject with built-in template and accurate collision mesh."
            : (uploadedConstraintTemplate is null
                ? "Converted the static mesh into a kinematic prefab graph and copied body/constraint settings from the loaded kinematic template."
                : "Converted the static mesh into a kinematic prefab graph using the uploaded moving-item and constraint templates.");
        geometryCache.Clear();
        uploadedGeometry.Clear();
        await UpdateScenePayload(authoredMotionScene);
        await RefreshDebugDiagnostics();
    }

