    private async Task AddKinematicEntity(NPlugDyna_SKinematicConstraint source)
    {
        if (!acknowledgeKinematicTemplate || authoredMotionScene is null)
            return;

        var entry = authoredMotionScene.Handles.Entries.FirstOrDefault(handle => ReferenceEquals(handle.Entry.Model, source));
        if (entry is null)
        {
            errorMessage = "The selected constraint is no longer attached to a local prefab entry.";
            return;
        }

        var result = ItemKinematicEntityTemplate.AppendFromConstraint(entry.Prefab, source, entry.PrefabPath);
        if (!result.Success)
        {
            errorMessage = "Could not add a kinematic entity: " + result.Reason;
            return;
        }

        errorMessage = null;
        kinematicTemplateStatus = $"Added kinematic entity in slot {result.Value + 1}. It inherits Constraint {authoredConstraints.IndexOf(source) + 1}'s world/parent binding.";
        geometryCache.Clear();
        uploadedGeometry.Clear();
        authoredMotionScene = ReadSelectedScene();
        authoredConstraints.Clear();
        authoredConstraints.AddRange(authoredMotionScene.Handles.Sources.Values.OfType<NPlugDyna_SKinematicConstraint>());
        await UpdateScenePayload(authoredMotionScene);
        await RefreshDebugDiagnostics();
    }

