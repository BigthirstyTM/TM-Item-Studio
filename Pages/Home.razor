                                        <label class="small text-muted mb-0" data-help-key="to">To</label>
                                        <select class="form-select form-select-sm" aria-label="@($"Group {group.GroupId + 1} TransAxis")" data-help-key="axis" @bind="motion.TransAxis" @bind:after="OnCompositeWorldOffsetChanged">
