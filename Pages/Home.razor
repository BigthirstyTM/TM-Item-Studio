    private async Task LoadVanillaFolder(InputFileChangeEventArgs e)
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var selection = await JS.InvokeAsync<TextureDirectorySelection>("indexStudioGameData", "vanilla-folder-upload", true);
            gameDataIndexed = true;
            textureDirectoryStatus = $"Using GameData {selection.Name} ({selection.FileCount:N0} local files).";
            var count = 0;
            var missing = new HashSet<string>();
            foreach (var source in variantSources.GroupBy(source => source.Document).Select(group => group.First()))
            {
                var result = await GbxDependencyLoader.HydrateAsync(source.Document, ResolveGameData);
                count += result.LoadedCount;
                foreach (var reference in result.Missing) missing.Add(reference);
                await PrepareAssetPreview(source);
            }
            geometryCache.Clear(); uploadedGeometry.Clear(); authoredMotionScene = null;
            if (variantSources.Count > 0) await LoadVariant(activeVariantIndex);
            statusMessage = $"Vanilla dependencies loaded: {count} model/material GBX files. Textures and moods indexed from {selection.Name}.";
            if (missing.Count > 0) statusMessage += $" Unresolved references: {missing.Count}.";
        }
        catch (Exception ex) { errorMessage = "Error while loading GameData: " + ex.Message; }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task LoadFileSet(IReadOnlyList<IBrowserFile> files)
    {
        isLoading = true;
        errorMessage = null;
        variantSources.Clear();
        assetLoadErrors.Clear();
        compositeVariantSelection.Clear();
        compositeDocToSourceIndex.Clear();
        compositeWorldOffsets.Clear();
        compositeGroupTransforms.Clear();
        compositeGroupMotions.Clear();
        compositeGroupBySourceIndex.Clear();
        compositeSelectionOrder.Clear();
        compositePivotLeaderByFollower.Clear();
        compositePivotRelativeByFollower.Clear();
        nextCompositeGroupId = 0;
        compositeTransformMode = "translate";
        statusMessage = null;
        geometryCache.Clear();
        uploadedGeometry.Clear();
        activeVariantIndex = 0;
        itemModel = null;
        hasMesh = false;
        isMovingItem = false;
        hasBakedAnimation = false;
        modelParts.Clear();
        detectedMaterials = Array.Empty<ItemSceneMaterial>();
        detectedPivots.Clear();
        detectedLights.Clear();
        detectedNodeTypes.Clear();
        debugLog.Clear();
        modelDiagnostics.Clear();
        detectedAxis = "y";
        isOscillating = false;
        minAngle = 0;
        maxAngle = 0;
        translationAxis = "y";
        translationDistance = 0;
        animationPeriodSeconds = 2;
        animationPhaseSeconds = 0;
        pivotOffsetX = pivotOffsetY = pivotOffsetZ = 0;
        fxEmitterX = fxEmitterY = fxEmitterZ = 0;
        harmonicEasing = false;
        invertMotion = false;
        hasTranslationMotion = false;
        translationMin = new float[3];
        translationMax = new float[3];
        activeKinematicConstraint = null;
        authoredMotionScene = null;
        authoredConstraints.Clear();
        visualPathProxies.Clear();
        motionDiagnostics = Array.Empty<string>();
        showOriginalMotion = false;
        originalConstraintType = "Not found";
        originalMotionSettings.Clear();
        originalMotionAvailable = false;
        try
        {
            if (isViewerInitialized)
            {
                isViewerInitialized = false;
                await JS.InvokeVoidAsync("dispose3DViewer");
            }

            var candidates = files.Where(file => file.Name.EndsWith(".gbx", StringComparison.OrdinalIgnoreCase))
                .GroupBy(file => NormalizeDependencyPath(file.Name), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(group => group.Key, group => group.ToArray(), StringComparer.OrdinalIgnoreCase);
            var bytesCache = new Dictionary<IBrowserFile, byte[]>(ReferenceEqualityComparer.Instance);
            var externalCount = 0;
            var externalMissing = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var externalFailed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var file in files)
            {
                try
                {
                using var memoryStream = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(memoryStream);
                var originalBytes = memoryStream.ToArray();
                if (ItemMacroblock.IsMacroblock(originalBytes))
                {
                    await LoadMacroblock(originalBytes, file.Name);
                    continue;
                }

                Gbx parsedDocument;
                Gbx<CGameItemModel>? opaqueFxDocument = null;
                string? previewReason = null;
                try { parsedDocument = Gbx.Parse(new MemoryStream(originalBytes), new GbxReadSettings { SafeSkippableChunks = true }); }
                catch (Exception parseError)
                {
                    // Preserve unsupported native records and still expose their declared skin model.
                    try
                    {
                        // An embedded CPlugFxSystem is an unknown body node in the
                        // bundled parser, but the item root and raw body can still
                        // be edited safely through FxOpaqueExport.
                        opaqueFxDocument = FxOpaqueExport.Parse(originalBytes);
                        parsedDocument = opaqueFxDocument;
                    }
                    catch { parsedDocument = Gbx.ParseHeader(new MemoryStream(originalBytes)); }
                    previewReason = $"Native model parser: {parseError.Message}. Header and referenced skin preview.";
                }
                var parsedGbx = parsedDocument as Gbx<CGameItemModel>;
                // Keep the exact uploaded bytes for native FX editing even when
                // GBX.NET returned a partial CGameItemModel without throwing.
                // Mesh Modeler items legitimately have no runtime EntityModel: their authored
                // mesh lives in EntityModelEdition.MeshCrystal and must stay on the normal
                // parsed document. Only use the opaque FX fallback when neither representation
                // is available; FxOpaqueExport.Parse intentionally reads a raw body and does
                // not expose Mesh Modeler edition data.
                if (parsedGbx is not null && parsedGbx.Node.EntityModel is null
                    && parsedGbx.Node.EntityModelEdition is null)
                {
                    try
                    {
                        opaqueFxDocument = FxOpaqueExport.Parse(originalBytes);
                        parsedGbx = opaqueFxDocument;
                        parsedDocument = opaqueFxDocument;
                    }
                    catch { /* the normal preview path below remains read-only */ }
                }
                var opaqueFx = opaqueFxDocument is not null && FxOpaqueExport.IsOpaqueFxCarrier(opaqueFxDocument);
                var previewOnly = parsedGbx is null || parsedGbx.Node.EntityModel is CGameVehicleModel
                    || (previewReason is not null && !opaqueFx);

                var dependencies = await GbxDependencyLoader.HydrateAsync(parsedDocument, async referencePath =>
                {
                    var dependencyFile = FindDependencyFile(referencePath, candidates);
                    if (dependencyFile is null) return await ResolveGameData(referencePath);
                    if (!bytesCache.TryGetValue(dependencyFile, out var dependencyBytes))
                    {
                        using var dependencyStream = new MemoryStream();
                        await dependencyFile.OpenReadStream(maxAllowedSize: 256 * 1024 * 1024).CopyToAsync(dependencyStream);
                        dependencyBytes = dependencyStream.ToArray();
                        bytesCache[dependencyFile] = dependencyBytes;
                    }
                    return new GbxDependencyLoader.ResolvedFile(dependencyFile.Name, dependencyBytes);
                });
                externalCount += dependencies.LoadedCount;
                foreach (var missing in dependencies.Missing) externalMissing.Add(missing);
                foreach (var failed in dependencies.Failed) externalFailed.Add(failed);

                if (previewOnly)
                {
                    var asset = ItemVariantSource.FromAsset(Path.GetFileNameWithoutExtension(file.Name), parsedDocument, originalBytes, previewReason);
                    await PrepareAssetPreview(asset);
                    variantSources.Add(asset);
                }
                else
                {
                    var sources = ItemVariantSource.FromFile(Path.GetFileNameWithoutExtension(file.Name), parsedGbx!, originalBytes);
                    if (opaqueFx && FxMeshPreview.TryRead(originalBytes, out var meshPreview, out _) && meshPreview is not null)
                        foreach (var source in sources) source.PreviewOverride = meshPreview.PreviewRoot;
                    variantSources.AddRange(sources);
                }
                }
                catch (Exception fileError) { assetLoadErrors.Add($"{file.Name}: {fileError.Message}"); }
            }

            if (variantSources.Count > 0)
            {
                compositeViewportMode = CanCombineFiles;
                foreach (var selected in CompositeViewportSources())
                    compositeVariantSelection[selected.Source.GbxFile] = selected.SourceIndex;
                await SelectVariant(0);
                if (externalCount > 0)
                {
                    statusMessage = $"Loaded {externalCount} external GBX dependencies.";
                    if (externalMissing.Count > 0 || externalFailed.Count > 0)
                        statusMessage += $" Unresolved: {externalMissing.Count + externalFailed.Count}.";
                }
            }
            if (assetLoadErrors.Count > 0) errorMessage = string.Join("; ", assetLoadErrors);
        }
        catch (Exception ex)
        {
            errorMessage = "Error while processing the file: " + ex.Message;
        }
        finally
        {
            isLoading = false;
            if (itemModel is null) await RefreshDebugDiagnostics();
            StateHasChanged();
        }
    }

    private static string NormalizeDependencyPath(string value)
        => value.Replace('/', '\\').TrimStart('\\').ToLowerInvariant();

    private static IBrowserFile? FindDependencyFile(string referencePath,
        IReadOnlyDictionary<string, IBrowserFile[]> candidates)
    {
        var normalized = NormalizeDependencyPath(referencePath);
        if (candidates.TryGetValue(normalized, out var exact) && exact.Length == 1)
            return exact[0];

        var separator = normalized.LastIndexOf('\\');
        var basename = separator >= 0 ? normalized[(separator + 1)..] : normalized;
        if (candidates.TryGetValue(basename, out var byName) && byName.Length == 1)
            return byName[0];

        // Some browsers expose a relative path as IBrowserFile.Name. Use a
        // unique suffix match when the exact directory prefix differs.
        var suffix = candidates.Where(pair => pair.Key.EndsWith("\\" + normalized, StringComparison.OrdinalIgnoreCase))
            .SelectMany(pair => pair.Value).ToArray();
        return suffix.Length == 1 ? suffix[0] : null;
    }

    private async Task SelectVariant(int index)
    {
        if (isSelectingVariant || index < 0 || index >= variantSources.Count) return;
        var file = variantSources[index].GbxFile;
        if (compositeVariantSelection.TryGetValue(file, out var previousIndex)
            && previousIndex != index
            && compositeWorldOffsets.TryGetValue(previousIndex, out var previousOffset)
            && !compositeWorldOffsets.ContainsKey(index))
        {
            compositeWorldOffsets[index] = new CompositeWorldTransform
            {
                X = previousOffset.X,
                Y = previousOffset.Y,
                Z = previousOffset.Z,
                RotX = previousOffset.RotX,
                RotY = previousOffset.RotY,
                RotZ = previousOffset.RotZ
            };
        }
        compositeVariantSelection[file] = index;
        isSelectingVariant = true;
        errorMessage = null;
        try
        {
            StateHasChanged();
            await Task.Yield();
            await LoadVariant(index);
            StateHasChanged();
            await Task.Yield();
            await JS.InvokeVoidAsync("scrollSelectedVariantIntoView");
        }
        catch (Exception ex) { errorMessage = "Error while loading variant: " + ex.Message; }
        finally { isSelectingVariant = false; }
    }

