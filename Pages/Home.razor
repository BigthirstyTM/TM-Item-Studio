                                            <option value="Y">Y</option>
                                            <option value="Z">Z</option>
                                        </select>
                                        <input type="number" class="form-control form-control-sm" step="0.1" aria-label="@($"Group {group.GroupId + 1} TransMin")" data-help-key="from" @bind="motion.TransMin" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                        <input type="number" class="form-control form-control-sm" step="0.1" aria-label="@($"Group {group.GroupId + 1} TransMax")" data-help-key="to" @bind="motion.TransMax" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                    </div>
