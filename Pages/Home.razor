    private async Task DownloadObj()
    {
        if (!string.IsNullOrEmpty(rawObj))
        {
            string filename = (itemModel?.Ident?.Id ?? "item") + ".obj";
            await JS.InvokeVoidAsync("downloadObjFile", filename, rawObj);
        }
    }

    private async Task ExportGbx()
    {
        if (gbxFile != null && itemModel != null)
        {
            try
            {
                UpdateIdent();
                SyncPivotsToGbx();
                for (int i = 0; i < detectedLights.Count; i++) SyncLightsToGbx(i);

                using var memoryStream = new MemoryStream();
                gbxFile.Save(memoryStream);
                var bytes = memoryStream.ToArray();

                string filename = (string.IsNullOrEmpty(identId) ? "CustomItem" : identId) + ".Item.Gbx";
                await JS.InvokeVoidAsync("downloadBinaryGbx", filename, Convert.ToBase64String(bytes));
            }
            catch (Exception ex)
            {
                errorMessage = "Fout bij exporteren van .Item.Gbx: " + ex.Message;
            }
        }
    }

