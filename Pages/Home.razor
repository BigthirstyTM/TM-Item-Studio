                                    <input aria-label="@($"Instance {index + 1} scale")" type="number" step="any" min="0.01" class="form-control form-control-sm" style="width:4.6rem" @bind="instance.Scale" @bind:after="RefreshMacroblockViewport" />
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Remove this copy" @onclick="@(() => RemoveMacroblockInstance(index))">✕</button>
                                </div>
                            }
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DuplicateLastMacroblockInstance">⧉ Duplicate last copy</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearMacroblockInstances">Clear all</button>
