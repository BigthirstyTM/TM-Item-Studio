                                    </div>
                                    <div class="motion-segment-grid">
                                        <span class="motion-segment-number">1</span>
                                        <input type="number" class="form-control form-control-sm" min="50" step="50" aria-label="@($"Group {group.GroupId + 1} TransDurationA")" data-help-key="duration" @bind="motion.TransDurationA" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                        <select class="form-select form-select-sm" aria-label="@($"Group {group.GroupId + 1} TransEaseA")" data-help-key="easing" @bind="motion.TransEaseA" @bind:after="OnCompositeWorldOffsetChanged">
                                            <option>Linear</option><option>QuadInOut</option><option>QuadIn</option><option>QuadOut</option><option>Constant</option>
                                        </select>
                                        <input type="checkbox" aria-label="@($"Group {group.GroupId + 1} TransReverseA")" data-help-key="reverse" @bind="motion.TransReverseA" @bind:after="OnCompositeWorldOffsetChanged" />
                                    </div>
                                    <div class="motion-segment-grid">
                                        <span class="motion-segment-number">2</span>
                                        <input type="number" class="form-control form-control-sm" min="50" step="50" aria-label="@($"Group {group.GroupId + 1} TransDurationB")" data-help-key="duration" @bind="motion.TransDurationB" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                        <select class="form-select form-select-sm" aria-label="@($"Group {group.GroupId + 1} TransEaseB")" data-help-key="easing" @bind="motion.TransEaseB" @bind:after="OnCompositeWorldOffsetChanged">
                                            <option>Linear</option><option>QuadInOut</option><option>QuadIn</option><option>QuadOut</option><option>Constant</option>
                                        </select>
                                        <input type="checkbox" aria-label="@($"Group {group.GroupId + 1} TransReverseB")" data-help-key="reverse" @bind="motion.TransReverseB" @bind:after="OnCompositeWorldOffsetChanged" />
                                    </div>
                                    <div class="motion-segment-grid">
                                        <span class="motion-segment-number">3</span>
                                        <input type="number" class="form-control form-control-sm" min="50" step="50" aria-label="@($"Group {group.GroupId + 1} TransDurationC")" data-help-key="duration" @bind="motion.TransDurationC" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                        <select class="form-select form-select-sm" aria-label="@($"Group {group.GroupId + 1} TransEaseC")" data-help-key="easing" @bind="motion.TransEaseC" @bind:after="OnCompositeWorldOffsetChanged">
                                            <option>Linear</option><option>QuadInOut</option><option>QuadIn</option><option>QuadOut</option><option>Constant</option>
                                        </select>
                                        <input type="checkbox" aria-label="@($"Group {group.GroupId + 1} TransReverseC")" data-help-key="reverse" @bind="motion.TransReverseC" @bind:after="OnCompositeWorldOffsetChanged" />
                                    </div>
                                    <div class="motion-segment-grid">
                                        <span class="motion-segment-number">4</span>
                                        <input type="number" class="form-control form-control-sm" min="50" step="50" aria-label="@($"Group {group.GroupId + 1} TransDurationD")" data-help-key="duration" @bind="motion.TransDurationD" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                        <select class="form-select form-select-sm" aria-label="@($"Group {group.GroupId + 1} TransEaseD")" data-help-key="easing" @bind="motion.TransEaseD" @bind:after="OnCompositeWorldOffsetChanged">
                                            <option>Linear</option><option>QuadInOut</option><option>QuadIn</option><option>QuadOut</option><option>Constant</option>
                                        </select>
                                        <input type="checkbox" aria-label="@($"Group {group.GroupId + 1} TransReverseD")" data-help-key="reverse" @bind="motion.TransReverseD" @bind:after="OnCompositeWorldOffsetChanged" />
                                    </div>
                                </div>
                                <div class="motion-channel">
                                    <h6>Rotation °</h6>
                                    <div class="motion-range">
                                        <label class="small text-muted mb-0" data-help-key="axis">Axis</label>
                                        <label class="small text-muted mb-0" data-help-key="from">From</label>
                                        <label class="small text-muted mb-0" data-help-key="to">To</label>
                                        <select class="form-select form-select-sm" aria-label="@($"Group {group.GroupId + 1} RotAxis")" data-help-key="axis" @bind="motion.RotAxis" @bind:after="OnCompositeWorldOffsetChanged">
                                            <option value="X">X</option>
                                            <option value="Y">Y</option>
                                            <option value="Z">Z</option>
                                        </select>
                                        <input type="number" class="form-control form-control-sm" step="1" aria-label="@($"Group {group.GroupId + 1} RotMinDeg")" data-help-key="active" @bind="motion.RotMinDeg" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                        <input type="number" class="form-control form-control-sm" step="1" aria-label="@($"Group {group.GroupId + 1} RotMaxDeg")" data-help-key="active" @bind="motion.RotMaxDeg" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                                    </div>
                                    <div class="motion-segment-grid motion-segment-labels">
                                        <span>#</span><span>Duration ms</span><span>Easing</span><span>Reverse</span>
                                    </div>
