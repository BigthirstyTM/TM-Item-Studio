        itemModel.EntityModel = drawPathBefore ?? drawPathOriginal;
        drawPathOriginal = drawPathGenerated = null;
        drawPathBefore = null;
        drawPathStatusMessage = "Restored the motion from before path generation.";
        await RefreshPathMotion();
    }
