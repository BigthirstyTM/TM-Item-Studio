    private MeshPartConfig GetMeshPartConfig(string path)
    {
        if (!meshPartConfigs.TryGetValue(path, out var config))
        {
            var part = modelParts.FirstOrDefault(part => part.Path == path);
            config = new MeshPartConfig
            {
                Enabled = true,
                Visible = true,
                Movable = part?.IsMoving == true
            };
            meshPartConfigs[path] = config;
        }
        return config;
    }

