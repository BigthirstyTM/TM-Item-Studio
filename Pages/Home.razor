    private async Task ExportMergedCompositeGbx()
    {
        if (!CanExportCompositeMerged || itemModel is null)
            return;

        try
        {
            UpdateIdent();
            var selectedParts = CompositeViewportSources();
            var selected = selectedParts.Select(part => part.Source).ToArray();
            ItemExportValidator.EnsureGameReady(selected[0].Model, $"{(string.IsNullOrWhiteSpace(identId) ? "CustomItem" : identId)}_Merged");
            var worldOffsets = selectedParts
                .Select(part =>
                {
                    var rigid = compositeGroupBySourceIndex.ContainsKey(part.SourceIndex)
                        ? BuildCompositeRigidTransform(part.SourceIndex)
                        : BuildCompositeEffectiveRigidTransform(part.SourceIndex);
                    var rotation = Quaternion.Normalize(Quaternion.CreateFromRotationMatrix(rigid));
                    if (!float.IsFinite(rotation.X) || !float.IsFinite(rotation.Y) || !float.IsFinite(rotation.Z) || !float.IsFinite(rotation.W))
                        throw new InvalidOperationException("Merged transform rotation contains invalid values.");
                    var position = new Vec3(rigid.M41, rigid.M42, rigid.M43);
                    if (!float.IsFinite(position.X) || !float.IsFinite(position.Y) || !float.IsFinite(position.Z))
                        throw new InvalidOperationException("Merged transform translation contains invalid values.");
                    return new ItemVariantSource.MergeRootTransform(
                        position,
                        new Quat(rotation.X, rotation.Y, rotation.Z, rotation.W));
                })
                .ToArray();
            var selectedPositionBySource = selectedParts
                .Select((part, position) => (part.SourceIndex, position))
                .ToDictionary(entry => entry.SourceIndex, entry => entry.position);
            var groupedMergeDefinitions = compositeGroupBySourceIndex
                .Where(pair => selectedPositionBySource.ContainsKey(pair.Key))
                .GroupBy(pair => pair.Value)
                .Select(group =>
                {
                    var members = group
                        .Select(pair => selectedPositionBySource[pair.Key])
                        .Distinct()
                        .OrderBy(position => position)
                        .ToArray();
                    if (members.Length < 2)
                        return (ItemVariantSource.GroupMergeDefinition?)null;
                    compositeGroupTransforms.TryGetValue(group.Key, out var transform);
                    var motion = GetCompositeGroupMotion(group.Key);
                    var motionExport = motion.Enabled
                        ? new ItemVariantSource.GroupKinematicMotion(
                            motion.TransAxis?.ToUpperInvariant() switch
                            {
                                "X" => KC.EAxis.X,
                                "Z" => KC.EAxis.Z,
                                _ => KC.EAxis.Y
                            },
                            motion.TransMin,
                            motion.TransMax,
                            new ItemVariantSource.GroupAnimKey[]
                            {
                                new(ParseAnimEase(motion.TransEaseA, KC.AnimEase.Linear), motion.TransReverseA, Math.Max(50, motion.TransDurationA)),
                                new(ParseAnimEase(motion.TransEaseB, KC.AnimEase.Linear), motion.TransReverseB, Math.Max(50, motion.TransDurationB)),
                                new(ParseAnimEase(motion.TransEaseC, KC.AnimEase.Linear), motion.TransReverseC, Math.Max(50, motion.TransDurationC)),
                                new(ParseAnimEase(motion.TransEaseD, KC.AnimEase.Linear), motion.TransReverseD, Math.Max(50, motion.TransDurationD))
                            },
                            motion.RotAxis?.ToUpperInvariant() switch
                            {
                                "X" => KC.EAxis.X,
                                "Z" => KC.EAxis.Z,
                                _ => KC.EAxis.Y
                            },
                            motion.RotMinDeg,
                            motion.RotMaxDeg,
                            new ItemVariantSource.GroupAnimKey[]
                            {
                                new(ParseAnimEase(motion.RotEaseA, KC.AnimEase.Linear), motion.RotReverseA, Math.Max(50, motion.RotDurationA)),
                                new(ParseAnimEase(motion.RotEaseB, KC.AnimEase.QuadInOut), motion.RotReverseB, Math.Max(50, motion.RotDurationB)),
                                new(ParseAnimEase(motion.RotEaseC, KC.AnimEase.Linear), motion.RotReverseC, Math.Max(50, motion.RotDurationC)),
                                new(ParseAnimEase(motion.RotEaseD, KC.AnimEase.QuadInOut), motion.RotReverseD, Math.Max(50, motion.RotDurationD))
                            })
                        : (ItemVariantSource.GroupKinematicMotion?)null;
                    var groupTransform = transform is null
                        ? new ItemVariantSource.MergeRootTransform(new Vec3(0, 0, 0), new Quat(0, 0, 0, 1))
                        : BuildGroupRootTransform(transform);
                    return new ItemVariantSource.GroupMergeDefinition(group.Key, members, groupTransform, motionExport);
                })
                .Where(definition => definition.HasValue)
                .Select(definition => definition!.Value)
                .ToArray();
            using var memoryStream = new MemoryStream();
            ItemVariantSource.SaveMergedPrefab(selected, memoryStream, worldOffsets, groupedMergeDefinitions);
            var bytes = memoryStream.ToArray();
            _ = Gbx.Parse<CGameItemModel>(new MemoryStream(bytes));
            var exportId = itemModel.Ident?.Id;
            var filename = (string.IsNullOrEmpty(exportId) ? "CustomItem" : exportId) + "_Merged.Item.Gbx";
            await JS.InvokeVoidAsync("downloadBinaryGbx", filename, Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            errorMessage = "Error while merging files into one item: " + ex.Message;
        }
    }

    private static ItemVariantSource.MergeRootTransform BuildGroupRootTransform(CompositeWorldTransform transform)
    {
        var rotation = QuaternionFromDegrees(transform.RotX, transform.RotY, transform.RotZ);
        var pivot = new Vector3(transform.PivotX, transform.PivotY, transform.PivotZ);
        var rotatedPivot = Vector3.Transform(pivot, rotation);
        var translation = new Vector3(transform.X, transform.Y, transform.Z) + pivot - rotatedPivot;
        return new ItemVariantSource.MergeRootTransform(
            new Vec3(translation.X, translation.Y, translation.Z),
            new Quat(rotation.X, rotation.Y, rotation.Z, rotation.W));
    }

    private static KC.AnimEase ParseAnimEase(string? value, KC.AnimEase fallback)
        => Enum.TryParse<KC.AnimEase>(value, ignoreCase: true, out var ease) ? ease : fallback;

    private void ApplyMeshPartConfigurationToVariant()
    {
        if (authoredMotionScene is null || meshPartModes.Count == 0)
            return;

        var root = authoredMotionScene.Handles.Prefabs.FirstOrDefault(handle => !handle.Path.Contains("/ent:", StringComparison.Ordinal))
            ?? authoredMotionScene.Handles.Prefabs.FirstOrDefault();
        if (root is null)
            return;
        var slots = ItemMotionBindings.CollectSlots(root.Source, root.Path).Slots;
        var slotByPath = slots.ToDictionary(slot => slot.Path, slot => slot.Slot, StringComparer.Ordinal);

        var configured = authoredMotionScene.Preview.Geometry
            .Where(part => !part.IsCollision)
            .Select(part => new
            {
                PartPath = part.Path,
                part.EntityPath,
                Mode = meshPartModes.TryGetValue(part.Path, out var mode) && mode is "static" or "kinematic"
                    ? mode
                    : (meshPartConfigs.TryGetValue(part.Path, out var cfg) && cfg.Movable ? "kinematic" : "auto")
            })
            .Where(part => !string.IsNullOrWhiteSpace(part.EntityPath) && part.Mode is "static" or "kinematic")
            .GroupBy(part => part.EntityPath!, StringComparer.Ordinal);

        foreach (var entryGroup in configured)
        {
            var distinctModes = entryGroup.Select(part => part.Mode).Distinct(StringComparer.Ordinal).ToArray();
            if (distinctModes.Length != 1)
            {
                errorMessage = $"Mesh config not applied for {entryGroup.Key}: one entity contains both static and kinematic parts. Split the mesh into separate entities first.";
                continue;
            }

            var mode = distinctModes[0];
            if (mode == "static" && slotByPath.TryGetValue(entryGroup.Key, out var slot)
                && authoredMotionScene.Handles.Entries.Any(handle =>
                    handle.Entry.Params is NPlugDyna_SPrefabConstraintParams parameters && (parameters.Ent1 == slot || parameters.Ent2 == slot)))
            {
                errorMessage = $"Mesh config not applied for {entryGroup.Key}: this entity is part of a kinematic constraint chain.";
                continue;
            }

            var entry = authoredMotionScene.Handles.Entries.FirstOrDefault(handle => handle.Path == entryGroup.Key);
            if (entry?.Entry.Model is not CPlugDynaObjectModel dyna || entry.Entry.Params is not NPlugDynaObjectModel_SInstanceParams instance)
                continue;

            if (mode == "static")
            {
                dyna.IsStatic = true;
                instance.IsKinematic = false;
            }
            else if (mode == "kinematic")
            {
                dyna.IsStatic = false;
                instance.IsKinematic = true;
            }
        }
    }

    private async Task AddMacroblockInstance()
    {
        var last = macroblockInstances.Count > 0 ? macroblockInstances[^1] : null;
        macroblockInstances.Add(new ItemMacroblockInstance
        {
            Label = $"Copy {macroblockInstances.Count + 1}",
            PosX = last is null ? 0f : last.PosX + macroblockGridSpacing,
            PosY = last?.PosY ?? 0f,
            PosZ = last?.PosZ ?? 0f,
            YawDeg = last?.YawDeg ?? 0f,
            Scale = last?.Scale ?? 1f
        });
        await RefreshMacroblockViewport();
    }

    private async Task DuplicateLastMacroblockInstance()
    {
        if (macroblockInstances.Count == 0)
        {
            await AddMacroblockInstance();
            return;
        }

        var copy = macroblockInstances[^1].Copy();
        copy.Label = $"Copy {macroblockInstances.Count + 1}";
        copy.PosX += macroblockGridSpacing;
        macroblockInstances.Add(copy);
        await RefreshMacroblockViewport();
    }

    private async Task FillMacroblockGrid()
    {
        var count = Math.Max(1, macroblockGridCount);
        var columns = Math.Max(1, macroblockGridColumns);
        var spacing = macroblockGridSpacing <= 0f ? 8f : macroblockGridSpacing;
        var start = macroblockInstances.Count;
        // New rows continue below the copies that are already placed.
        var offsetZ = (start + columns - 1) / columns * spacing;
        foreach (var instance in ItemMacroblock.Grid(count, columns, spacing, spacing))
        {
            var copy = instance.Copy();
            copy.PosZ += offsetZ;
            macroblockInstances.Add(copy);
        }

        RelabelMacroblockInstances();
        await RefreshMacroblockViewport();
    }

    private async Task RemoveMacroblockInstance(int index)
    {
        if (index < 0 || index >= macroblockInstances.Count) return;
        macroblockInstances.RemoveAt(index);
        RelabelMacroblockInstances();
        await RefreshMacroblockViewport();
    }

    private async Task ClearMacroblockInstances()
    {
        macroblockInstances.Clear();
        await RefreshMacroblockViewport();
    }

    private void RelabelMacroblockInstances()
    {
        for (var i = 0; i < macroblockInstances.Count; i++)
        {
            // Loaded spawns are labelled with their item ident; only editor copies get renumbered.
            var label = macroblockInstances[i].Label;
            if (string.IsNullOrWhiteSpace(label) || label.StartsWith("Copy ", StringComparison.Ordinal))
                macroblockInstances[i].Label = $"Copy {i + 1}";
        }
    }

    /// <summary>Instances are plain parts of the scene payload, so every edit redraws the copies.</summary>
    private async Task RefreshMacroblockViewport()
    {
        if (authoredMotionScene is not null && isViewerInitialized)
            await UpdateScenePayload(authoredMotionScene);
        StateHasChanged();
    }

    /// <summary>One scene part per macroblock copy per item mesh: the same shared geometry the item
    /// already uploaded, moved by the copy's placement. The viewport therefore shows the instances
    /// where they are placed without duplicating a single vertex buffer. Copies are detached
    /// references (no entity path), so they stay still instead of inheriting the item's motion.</summary>
    private object[] BuildMacroblockInstanceParts(ItemSceneResult scene, int sourceIndex)
    {
        if (macroblockInstances.Count == 0) return Array.Empty<object>();

        var geometry = scene.Preview.Geometry.Where(part => !part.IsCollision).ToArray();
        if (geometry.Length == 0) geometry = scene.Preview.Geometry.ToArray();

        var parts = new List<object>(geometry.Length * macroblockInstances.Count);
        foreach (var instance in macroblockInstances)
        {
            var placed = ItemMacroblock.Placement(instance);
            foreach (var part in geometry)
            {
                // Shared geometry is placed by worldTransform; without an id the buffers are
                // rebuilt with the placement baked in, which is what the viewer then reads.
                var world = part.WorldTransform is { Length: 16 } packed
                    ? PackMatrix(MatrixFromPacked(packed) * placed)
                    : PackMatrix(placed);
                var shared = part.GeometryId.HasValue;
                parts.Add(new
                {
                    path = part.Path,
                    entityPath = (string?)null,
                    sourceIndex,
                    groupId = (int?)null,
                    geometryId = part.GeometryId,
                    worldTransform = shared ? world : null,
                    positionsBytes = shared ? null : ViewerBuffers.Pack(TransformPositions(part.Positions, placed)),
                    indicesBytes = shared ? null : ViewerBuffers.Pack(part.Indices),
                    normalsBytes = (byte[]?)null,
                    isCollision = part.IsCollision && !forcedRenderableGeometryPaths.Contains(part.Path),
                    meshMode = GetMeshPartMode(part.Path),
                    enabled = GetMeshPartConfig(part.Path).Enabled,
                    visible = GetMeshPartConfig(part.Path).Visible,
                    collidable = GetMeshPartConfig(part.Path).Collidable,
                    effect = GetMeshPartConfig(part.Path).Effect,
                    waypoint = GetMeshPartConfig(part.Path).Waypoint,
                    movable = GetMeshPartConfig(part.Path).Movable,
                    mappings = MappingsForVisual(scene.Preview, part.Path)
                });
            }
        }

        return parts.ToArray();
    }

    /// <summary>Copies for the plain payload branch, where parts carry their own buffers instead
    /// of shared geometry: the placement is baked into the vertices.</summary>
    private object[] BuildPlainInstanceParts()
    {
        if (macroblockInstances.Count == 0 || modelParts.Count == 0) return Array.Empty<object>();

        var parts = new List<object>(modelParts.Count * macroblockInstances.Count);
        foreach (var instance in macroblockInstances)
        {
            var placed = ItemMacroblock.Placement(instance);
            foreach (var part in modelParts)
            {
                parts.Add(new
                {
                    path = part.Path,
                    name = part.Name,
                    isMoving = false,
                    positionsBytes = ViewerBuffers.Pack(TransformPositions(part.Positions, placed)),
                    indicesBytes = ViewerBuffers.Pack(part.Indices),
                    meshMode = GetMeshPartMode(part.Path),
                    enabled = GetMeshPartConfig(part.Path).Enabled,
                    visible = GetMeshPartConfig(part.Path).Visible,
                    collidable = GetMeshPartConfig(part.Path).Collidable,
                    effect = GetMeshPartConfig(part.Path).Effect,
                    waypoint = GetMeshPartConfig(part.Path).Waypoint,
                    movable = GetMeshPartConfig(part.Path).Movable,
                    mappings = authoredMotionScene is null
                        ? Array.Empty<object>()
                        : MappingsForVisual(authoredMotionScene.Preview, part.Path)
                });
            }
        }

        return parts.ToArray();
    }

    private static float[] TransformPositions(float[] positions, Matrix4x4 matrix)
    {
        var transformed = new float[positions.Length];
        for (var i = 0; i + 2 < positions.Length; i += 3)
        {
            var vertex = Vector3.Transform(new Vector3(positions[i], positions[i + 1], positions[i + 2]), matrix);
            transformed[i] = vertex.X;
            transformed[i + 1] = vertex.Y;
            transformed[i + 2] = vertex.Z;
        }
        return transformed;
    }

    /// <summary>Loads a .Macroblock.Gbx into the instance table instead of casting it to an item.</summary>
    private async Task LoadMacroblock(byte[] bytes, string fileName)
    {
        try
        {
            var parsed = Gbx.Parse<CGameCtnMacroBlockInfo>(new MemoryStream(bytes));
            var node = parsed.Node ?? throw new InvalidOperationException("The macroblock has no readable node.");
            ApplyMacroblock(node, fileName);
            await RefreshMacroblockViewport();
        }
        catch (Exception ex)
        {
            errorMessage = "Error while processing the file: " + ex.Message;
        }
    }

    /// <summary>Fills the instance table from an already parsed macroblock node.</summary>
    private void ApplyMacroblock(CGameCtnMacroBlockInfo node, string fileName)
    {
        var loaded = ItemMacroblock.ReadInstances(node);
        macroblockInstances.Clear();
        foreach (var instance in loaded)
            macroblockInstances.Add(instance);
        RelabelMacroblockInstances();
        macroblockName = string.IsNullOrWhiteSpace(node.Name)
            ? Path.GetFileNameWithoutExtension(fileName)
            : node.Name;
        statusMessage = $"Loaded macroblock \"{macroblockName}\" with {loaded.Count} instance(s)."
            + (itemModel is null
                ? " Open the referenced .Item.Gbx to see the copies in the viewport."
                : " The copies are shown in the viewport.");
    }

    private async Task ExportMacroblockGbx()
    {
        if (itemModel is null || macroblockInstances.Count == 0) return;
        try
        {
            UpdateIdent();
            ItemExportValidator.EnsureGameReady(itemModel, identId);
            var export = ItemMacroblock.Export(itemModel, macroblockInstances, macroblockName);
            await JS.InvokeVoidAsync("downloadBinaryGbx", export.FileName, Convert.ToBase64String(export.Bytes));
            errorMessage = null;
            statusMessage = $"Exported {export.FileName} with {export.InstanceCount} instance(s) ({export.Bytes.Length} bytes).";
        }
        catch (Exception ex)
        {
            errorMessage = "Error while exporting .Macroblock.Gbx: " + ex.Message;
        }
    }

    /// <summary>Exports the copies as one self-contained item: a root prefab with one entry per
    /// copy, all pointing at the same embedded mesh instead of at the item ident.</summary>
    private async Task ExportMultiInstanceItemGbx()
    {
        if (itemModel is null || macroblockInstances.Count == 0) return;
        try
        {
            UpdateIdent();
            ItemExportValidator.EnsureGameReady(itemModel, identId);
            SyncPivotsToGbx();
            for (var i = 0; i < detectedLights.Count; i++) SyncLightsToGbx(i);
            ApplyMeshPartConfigurationToVariant();

            var source = variantSources[activeVariantIndex];
            // The export snapshots the document itself, so the item being edited stays untouched.
            var export = ItemMultiInstance.Export(source.GbxFile, source.VariantNumber, macroblockInstances, identId);
            await JS.InvokeVoidAsync("downloadBinaryGbx", export.FileName, Convert.ToBase64String(export.Bytes));
            errorMessage = null;
            statusMessage = $"Exported {export.FileName}: {export.InstanceCount} copies in "
                + $"{export.EntryCount} prefab entries, mesh stored once ({export.Bytes.Length} bytes)."
                + (export.Warnings.Count > 0 ? " " + string.Join(" ", export.Warnings) : string.Empty);
        }
        catch (Exception ex)
        {
            errorMessage = "Error while exporting the multi-instance item: " + ex.Message;
        }
    }

    private async Task ExportGbx(bool combineFiles = false)
    {
        if (gbxFile != null && itemModel != null)
        {
            try
            {
                UpdateIdent();
                ItemExportValidator.EnsureGameReady(combineFiles ? variantSources[0].Model : itemModel, identId);
                SyncPivotsToGbx();
                for (int i = 0; i < detectedLights.Count; i++) SyncLightsToGbx(i);
                ApplyMeshPartConfigurationToVariant();

                using var memoryStream = new MemoryStream();
                if (combineFiles)
                    ItemVariantSource.SaveCombined(variantSources, memoryStream);
                else
                    variantSources[activeVariantIndex].Save(memoryStream);
                var bytes = memoryStream.ToArray();

                // Refuse to download an archive that cannot be reopened by the
                // same parser used for import. This catches serializer damage
                // before the file reaches the game/editor.
                _ = Gbx.Parse<CGameItemModel>(new MemoryStream(bytes));

                var exportId = combineFiles ? variantSources[0].Model.Ident?.Id : identId;
                string filename = (string.IsNullOrEmpty(exportId) ? "CustomItem" : exportId) + (combineFiles ? "_Variants" : "") + ".Item.Gbx";
                await JS.InvokeVoidAsync("downloadBinaryGbx", filename, Convert.ToBase64String(bytes));
            }
            catch (Exception ex)
            {
                errorMessage = "Error while exporting .Item.Gbx: " + ex.Message;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("unregisterStudioDebug");
            if (isViewerInitialized)
                await JS.InvokeVoidAsync("dispose3DViewer");
        }
        catch (JSDisconnectedException) { }
        finally
        {
            isViewerInitialized = false;
            dotNetHelper?.Dispose();
        }
    }
}
