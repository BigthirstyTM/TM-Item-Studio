    private void UpdateIdent()
    {
        if (itemModel is null) return;
        // ToString resolves numeric collection IDs to display names. Preserve the
        // original typed value unless the user deliberately changes this field.
        var collection = itemModel.Ident?.Collection ?? Id.Empty;
        if (identCollection != collection.ToString())
        {
            // The upper two bits are reserved for GBX lookback markers.
            collection = int.TryParse(identCollection, NumberStyles.None, CultureInfo.InvariantCulture, out var number)
                && number < 0x40000000
                ? new Id(number)
                : new Id(identCollection);
        }
        itemModel.Ident = new Ident(identId, collection, identAuthor);
    }

    private void SyncPivotsToGbx()
    {
        if (itemModel?.DefaultPlacement != null)
        {
            var vecs = detectedPivots.Select(p => new Vec3(p.X, p.Y, p.Z)).ToArray();
            itemModel.DefaultPlacement.PivotPositions = vecs;
        }
    }

    private void UpdateGroundPoint(int axis, object? value)
    {
        if (itemModel == null || !float.TryParse(value?.ToString(), CultureInfo.InvariantCulture, out var number))
            return;

        var point = itemModel.GroundPoint;
        itemModel.GroundPoint = axis switch
        {
            0 => new Vec3(number, point.Y, point.Z),
            1 => new Vec3(point.X, number, point.Z),
            _ => new Vec3(point.X, point.Y, number)
        };
    }

    private void SyncLightsToGbx(int idx)
    {
        if (idx >= 0 && idx < detectedLights.Count)
        {
            var lightDto = detectedLights[idx];
            if (lightDto.SourceNode is CPlugLightUserModel lightModel)
            {
                float r = ((lightDto.ColorHex >> 16) & 0xFF) / 255.0f;
                float g = ((lightDto.ColorHex >> 8) & 0xFF) / 255.0f;
                float b = (lightDto.ColorHex & 0xFF) / 255.0f;
                lightModel.Color = new Vec3(r, g, b);
                lightModel.Intensity = lightDto.Intensity;
                lightModel.Distance = lightDto.Radius;
            }
        }
    }

    // Sockets are intentionally not extracted: DefaultPlacement.Sockets does not exist in
    // the bundled GBX.NET build, so any socket list would be DTO-only fiction.
    private void ExtractPivots(CGameItemModel item)
    {
        if (item.DefaultPlacement == null) return;

        if (item.DefaultPlacement.PivotPositions != null && item.DefaultPlacement.PivotPositions.Length > 0)
        {
            int pIndex = 0;
            foreach (var p in item.DefaultPlacement.PivotPositions)
            {
                detectedPivots.Add(new PivotDto { Index = pIndex++, X = p.X, Y = p.Y, Z = p.Z });
            }
        }
        else
        {
            detectedPivots.Add(new PivotDto { Index = 0, X = 0, Y = 0, Z = 0 });
        }
    }

    private void ExtractParts(CMwNod? previewRoot, bool includeGeometry = true)
    {
        CPlugPrefab? prefab = null;
        FindPrefab(previewRoot, ref prefab, new HashSet<object>(), 0);

        if (prefab != null && prefab.Ents != null)
        {
            isMovingItem = true;
            int modelEntityIndex = 0;
            bool constraintSeen = prefab.Ents.Any(ent => ent.Model?.GetType().Name.Contains("KinematicConstraint", StringComparison.OrdinalIgnoreCase) == true);

            foreach (var ent in prefab.Ents)
            {
                if (ent.Model?.GetType().Name.Contains("KinematicConstraint", StringComparison.OrdinalIgnoreCase) == true)
                {
                    pivotOffsetX = ent.Position.X;
                    pivotOffsetY = ent.Position.Y;
                    pivotOffsetZ = ent.Position.Z;
                    InspectConstraint(ent.Model);
                    break;
                }
            }

            foreach (var ent in prefab.Ents)
            {
                if (ent.Model != null)
                {
                    var positions = new List<float>();
                    var indices = new List<int>();
                    var visited = new HashSet<object>();

                    CrawlNode(ent.Model, positions, indices, visited, 0, ent.Position, ent.Rotation, includeGeometry);

                    if (positions.Count > 0)
                    {
                        // A CPlugDynaObjectModel can still be authored as a static
                        // body. Do not classify it as moving solely because its
                        // CLR type contains "Dyna"; IsStatic is the authoritative
                        // flag for the serialized model.
                        bool isMoving = ent.Model is CPlugDynaObjectModel dyna
                            ? !dyna.IsStatic && (constraintSeen || modelEntityIndex > 0)
                            : modelEntityIndex > 0 || (constraintSeen && ent.Model.GetType().Name.Contains("Dyna", StringComparison.OrdinalIgnoreCase));
                        var name = isMoving ? $"Moving Part {modelEntityIndex}" : "Static Base";
                        modelParts.Add(new ModelPart
                        {
                            Path = name,
                            Name = name,
                            IsMoving = isMoving,
                            MaterialSummary = "Unknown",
                            Positions = positions.ToArray(),
                            Indices = indices.ToArray()
                        });
                        modelEntityIndex++;
                    }
                }
            }
        }

        if (modelParts.Count == 0 && (includeGeometry || prefab is null))
        {
            var positions = new List<float>();
            var indices = new List<int>();
            var visited = new HashSet<object>();

            CrawlNode(previewRoot, positions, indices, visited, 0, null, null, includeGeometry);

            if (positions.Count > 0)
            {
                modelParts.Add(new ModelPart
                {
                    Path = "Static Model",
                    Name = "Static Model",
                    IsMoving = false,
                    MaterialSummary = "Unknown",
                    Positions = positions.ToArray(),
                    Indices = indices.ToArray()
                });
            }
        }
        SyncMeshPartModes();
    }

    private void InspectConstraint(object constraint)
    {
        try
        {
            activeKinematicConstraint = constraint;
            originalConstraintType = constraint.GetType().FullName ?? constraint.GetType().Name;
            originalMotionSettings.Clear();
            foreach (var property in constraint.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance))
            {
                if (!property.CanRead || property.GetIndexParameters().Length > 0 || !IsMotionProperty(property.Name))
                    continue;

                try
                {
                    var value = property.GetValue(constraint);
                    originalMotionSettings.Add(new OriginalMotionSetting
                    {
                        Name = property.Name,
                        Value = value?.ToString() ?? "null"
                    });
                }
                catch { }
            }

            var rotAxisProp = constraint.GetType().GetProperty("RotAxis");
            var minAngleProp = constraint.GetType().GetProperty("AngleMinDeg");
            var maxAngleProp = constraint.GetType().GetProperty("AngleMaxDeg");
            var transAxisProp = constraint.GetType().GetProperty("TransAxis");
            var periodProp = FindProperty(constraint, "RotPeriod", "Period", "Duration", "CycleDuration");
            var translationPeriodProp = FindProperty(constraint, "TransPeriod", "TranslationPeriod", "TransDuration");
            var phaseProp = FindProperty(constraint, "Phase", "PhaseOffset", "AnimPhaseOffset");
            var distanceProp = FindProperty(constraint, "TransDist", "TranslationDistance", "Distance");
            var transMinProp = constraint.GetType().GetProperty("TransMin");
            var transMaxProp = constraint.GetType().GetProperty("TransMax");

            if (rotAxisProp != null)
            {
                var val = rotAxisProp.GetValue(constraint)?.ToString();
                if (val != null) detectedAxis = val.ToLower();
            }

            if (minAngleProp != null && maxAngleProp != null)
            {
                minAngle = Convert.ToSingle(minAngleProp.GetValue(constraint));
                maxAngle = Convert.ToSingle(maxAngleProp.GetValue(constraint));
                isOscillating = Math.Abs(minAngle - maxAngle) > 0.01f && !(minAngle == 0 && maxAngle == 360);
            }

            if (transAxisProp != null)
            {
                translationAxis = NormalizeAxis(transAxisProp.GetValue(constraint)?.ToString(), translationAxis);
                hasTranslationMotion = true;
            }
            if (translationPeriodProp != null)
            {
                hasTranslationMotion = true;
                if (periodProp == null)
                    periodProp = translationPeriodProp;
            }
            if (periodProp != null)
                animationPeriodSeconds = NormalizePeriod(Convert.ToSingle(periodProp.GetValue(constraint)));
            if (phaseProp != null)
                animationPhaseSeconds = Convert.ToSingle(phaseProp.GetValue(constraint));
            if (distanceProp != null)
            {
                translationDistance = Convert.ToSingle(distanceProp.GetValue(constraint));
                hasTranslationMotion = hasTranslationMotion || Math.Abs(translationDistance) > 0.0001f;
            }
            if (transMinProp != null && transMaxProp != null
                && TryReadVec3(transMinProp.GetValue(constraint), out var min)
                && TryReadVec3(transMaxProp.GetValue(constraint), out var max))
            {
                translationMin = new[] { min.X, min.Y, min.Z };
                translationMax = new[] { max.X, max.Y, max.Z };
                hasTranslationMotion = true;
                translationDistance = Math.Max(
                    Math.Abs(max.X - min.X),
                    Math.Max(Math.Abs(max.Y - min.Y), Math.Abs(max.Z - min.Z)));
                translationAxis = Math.Abs(max.X - min.X) >= Math.Abs(max.Y - min.Y) && Math.Abs(max.X - min.X) >= Math.Abs(max.Z - min.Z)
                    ? "x"
                    : Math.Abs(max.Z - min.Z) >= Math.Abs(max.Y - min.Y) ? "z" : "y";
                if (translationPeriodProp != null)
                    animationPeriodSeconds = NormalizePeriod(Convert.ToSingle(translationPeriodProp.GetValue(constraint)));
            }

            originalAnimAxis = detectedAxis;
            originalIsOscillating = isOscillating;
            originalMinAngle = minAngle;
            originalMaxAngle = maxAngle;
            originalTranslationAxis = translationAxis;
            originalTranslationDistance = translationDistance;
            originalAnimationPeriodSeconds = animationPeriodSeconds;
            originalAnimationPhaseSeconds = animationPhaseSeconds;
            originalHasTranslationMotion = hasTranslationMotion;
            originalTranslationMin = (float[])translationMin.Clone();
            originalTranslationMax = (float[])translationMax.Clone();
            originalPivotOffset = new[] { pivotOffsetX, pivotOffsetY, pivotOffsetZ };
            originalMotionAvailable = true;
            showOriginalMotion = true;
        }
        catch { }
    }

    private static bool TryReadVec3(object? value, out Vec3 vector)
    {
        if (value is Vec3 typed)
        {
            vector = typed;
            return true;
        }

        vector = default;
        return false;
    }

    private static bool IsMotionProperty(string name)
    {
        return name.Contains("Axis", StringComparison.OrdinalIgnoreCase)
            || name.Contains("Angle", StringComparison.OrdinalIgnoreCase)
            || name.Contains("Period", StringComparison.OrdinalIgnoreCase)
            || name.Contains("Duration", StringComparison.OrdinalIgnoreCase)
            || name.Contains("Phase", StringComparison.OrdinalIgnoreCase)
            || name.Contains("Trans", StringComparison.OrdinalIgnoreCase)
            || name.Contains("Rot", StringComparison.OrdinalIgnoreCase)
            || name.Contains("Offset", StringComparison.OrdinalIgnoreCase)
            || name.Contains("Distance", StringComparison.OrdinalIgnoreCase)
            || name.Contains("Easing", StringComparison.OrdinalIgnoreCase)
            || name.Contains("Loop", StringComparison.OrdinalIgnoreCase);
    }

    private static PropertyInfo? FindProperty(object value, params string[] names)
    {
        return names.Select(value.GetType().GetProperty).FirstOrDefault(property => property != null && property.CanRead);
    }

    private static string NormalizeAxis(string? value, string fallback)
    {
        if (string.IsNullOrWhiteSpace(value)) return fallback;
        var axis = value.Trim().ToLowerInvariant();
        return axis.Contains('x') ? "x" : axis.Contains('z') ? "z" : "y";
    }

    private static float NormalizePeriod(float value)
    {
        return value > 20 ? value / 1000f : Math.Max(0.01f, value);
    }

    private async Task OnKinematicChanged()
    {
        if (authoredConstraints.Count > 0) return;
        ApplyKinematicProperty("AngleMinDeg", minAngle);
        ApplyKinematicProperty("AngleMaxDeg", maxAngle);
        ApplyKinematicProperty("TransDist", translationDistance);
        ApplyKinematicProperty("TranslationDistance", translationDistance);
        ApplyKinematicProperty("Period", animationPeriodSeconds);
        ApplyKinematicProperty("Duration", animationPeriodSeconds);
        ApplyKinematicProperty("Phase", animationPhaseSeconds);
        ApplyKinematicProperty("PhaseOffset", animationPhaseSeconds);
        ApplyKinematicAxis("RotAxis", detectedAxis);
        ApplyKinematicAxis("TransAxis", translationAxis);
        await UpdateScenePayload();
    }

    private void ApplyKinematicProperty(string name, float value)
    {
        var property = activeKinematicConstraint?.GetType().GetProperty(name);
        if (property?.CanWrite == true)
        {
            try { property.SetValue(activeKinematicConstraint, Convert.ChangeType(value, property.PropertyType)); }
            catch { }
        }
    }

    private void ApplyKinematicAxis(string name, string value)
    {
        var property = activeKinematicConstraint?.GetType().GetProperty(name);
        if (property?.CanWrite != true) return;
        try
        {
            var axisName = value.ToUpperInvariant();
            var axisValue = property.PropertyType.IsEnum
                ? Enum.Parse(property.PropertyType, axisName, true)
                : Convert.ChangeType(axisName, property.PropertyType);
            property.SetValue(activeKinematicConstraint, axisValue);
        }
        catch { }
    }

    private void FindPrefab(object? obj, ref CPlugPrefab? found, HashSet<object> visited, int depth)
    {
        if (obj == null || depth > 8 || visited.Contains(obj) || found != null) return;
        visited.Add(obj);

        if (obj is CPlugPrefab prefab)
        {
            found = prefab;
            return;
        }

        foreach (var prop in obj.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            if (prop.GetIndexParameters().Length > 0) continue;
            if (typeof(CMwNod).IsAssignableFrom(prop.PropertyType))
            {
                try
                {
                    var child = prop.GetValue(obj);
                    FindPrefab(child, ref found, visited, depth + 1);
                }
                catch { }
            }
        }
    }

    private void CrawlNode(object? obj, List<float> positions, List<int> indices, HashSet<object> visited, int depth, Vec3? offsetPos, Quat? offsetRot, bool includeGeometry = true)
    {
        if (obj == null || depth > 12 || visited.Contains(obj)) return;
        visited.Add(obj);
        detectedNodeTypes.Add(obj.GetType().Name);

        if (obj is CPlugLightUserModel lightModel)
        {
            int r = (int)Math.Clamp(lightModel.Color.X * 255, 0, 255);
            int g = (int)Math.Clamp(lightModel.Color.Y * 255, 0, 255);
            int b = (int)Math.Clamp(lightModel.Color.Z * 255, 0, 255);
            string hexColor = $"#{r:X2}{g:X2}{b:X2}";
            int colorInt = (r << 16) | (g << 8) | b;

            detectedLights.Add(new LightDto
            {
                Type = "PointLight",
                X = offsetPos?.X ?? 0,
                Y = (offsetPos?.Y ?? 0) + 1.2f,
                Z = offsetPos?.Z ?? 0,
                ColorHtml = hexColor,
                ColorHex = colorInt,
                Intensity = lightModel.Intensity > 0 ? lightModel.Intensity : 2.0f,
                Radius = lightModel.Distance > 0 ? lightModel.Distance : 15.0f,
                SourceNode = lightModel
            });
            return;
        }

        if (obj is CPlugPrefab prefab)
        {
            if (prefab.Ents != null)
            {
                foreach (var ent in prefab.Ents)
                {
                    if (ent.Model != null)
                        CrawlNode(ent.Model, positions, indices, visited, depth + 1, ent.Position, ent.Rotation, includeGeometry);
                }
            }
            return;
        }

        if (obj is CPlugVisualIndexedTriangles mesh)
        {
            if (includeGeometry) ExtractMeshFromVisual(mesh, positions, indices, offsetPos, offsetRot);
            return;
        }

        if (obj is CPlugTree tree)
        {
            if (tree.Visual != null)
                CrawlNode(tree.Visual, positions, indices, visited, depth + 1, offsetPos, offsetRot, includeGeometry);

            if (tree.Children != null)
            {
                foreach (var child in tree.Children)
                    CrawlNode(child, positions, indices, visited, depth + 1, offsetPos, offsetRot, includeGeometry);
            }
            return;
        }

        var props = obj.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance);
        foreach (var prop in props)
        {
            if (prop.GetIndexParameters().Length > 0) continue;

            if (typeof(CMwNod).IsAssignableFrom(prop.PropertyType))
            {
                try
                {
                    var child = prop.GetValue(obj);
                    CrawlNode(child, positions, indices, visited, depth + 1, offsetPos, offsetRot, includeGeometry);
                }
                catch { }
            }
            else if (typeof(System.Collections.IEnumerable).IsAssignableFrom(prop.PropertyType) && 
                     prop.PropertyType != typeof(string) && 
                     prop.PropertyType != typeof(byte[]))
            {
                try
                {
                    var collection = prop.GetValue(obj) as System.Collections.IEnumerable;
                    if (collection != null)
                    {
                        foreach (var item in collection)
                            if (item != null && !item.GetType().IsPrimitive && item is not string)
                                CrawlNode(item, positions, indices, visited, depth + 1, offsetPos, offsetRot, includeGeometry);
                    }
                }
                catch { }
            }
        }
    }

    private int ExtractMeshFromVisual(CPlugVisualIndexedTriangles mesh, List<float> positions, List<int> indices, Vec3? offsetPos, Quat? offsetRot)
    {
        int count = 0;
        int indexOffset = positions.Count / 3;

        if (mesh.VertexStreams != null)
        {
            foreach (var stream in mesh.VertexStreams)
            {
                if (stream.Positions != null && stream.Positions.Length > 0)
                {
                    foreach (var p in stream.Positions)
                    {
                        var transformed = TransformVertex(p, offsetPos, offsetRot);
                        positions.Add(transformed.X);
                        positions.Add(transformed.Y);
                        positions.Add(transformed.Z);
                        count++;
                    }

                    if (mesh.IndexBuffer?.Indices != null)
                    {
                        foreach (var idx in mesh.IndexBuffer.Indices)
                            indices.Add(idx + indexOffset);
                    }
                    break;
                }
            }
        }

        if (count == 0 && mesh.Vertices != null && mesh.Vertices.Length > 0)
        {
            foreach (var v in mesh.Vertices)
            {
                var transformed = TransformVertex(v.Position, offsetPos, offsetRot);
                positions.Add(transformed.X);
                positions.Add(transformed.Y);
                positions.Add(transformed.Z);
                count++;
            }

            if (mesh.IndexBuffer?.Indices != null)
            {
                foreach (var idx in mesh.IndexBuffer.Indices)
                    indices.Add(idx + indexOffset);
            }
        }

        return count;
    }

    private Vec3 TransformVertex(Vec3 v, Vec3? pos, Quat? rot)
    {
        Vec3 result = v;

        if (rot.HasValue && (rot.Value.X != 0 || rot.Value.Y != 0 || rot.Value.Z != 0 || rot.Value.W != 0))
        {
            float qx = rot.Value.X, qy = rot.Value.Y, qz = rot.Value.Z, qw = rot.Value.W;
            float tx = 2 * (qy * v.Z - qz * v.Y);
            float ty = 2 * (qz * v.X - qx * v.Z);
            float tz = 2 * (qx * v.Y - qy * v.X);

            result = new Vec3(
                v.X + qw * tx + (qy * tz - qz * ty),
                v.Y + qw * ty + (qz * tx - qx * tz),
                v.Z + qw * tz + (qx * ty - qy * tx)
            );
        }

        if (pos.HasValue)
        {
            result = new Vec3(result.X + pos.Value.X, result.Y + pos.Value.Y, result.Z + pos.Value.Z);
        }

        return result;
    }

