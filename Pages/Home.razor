@code {
    private IEnumerable<(string Label, (ItemVariantSource Source, int Index)[] Entries)> LoadedFiles()
    {
        var files = variantSources.Select((source, index) => (Source: source, Index: index)).GroupBy(v => v.Source.GbxFile).ToArray();
        for (var i = 0; i < files.Length; i++)
        {
            var filename = files[i].First().Source.FileName;
            var label = files.Count(f => string.Equals(f.First().Source.FileName, filename, StringComparison.OrdinalIgnoreCase)) > 1
                ? $"{filename} (file {i + 1})" : filename;
            yield return (label, files[i].ToArray());
        }
    }

    private IReadOnlyList<(int SourceIndex, ItemVariantSource Source, int DocumentOrdinal)> CompositeViewportSources()
    {
        var grouped = variantSources.Select((source, index) => (source, index)).GroupBy(item => item.source.GbxFile).ToArray();
        var selected = new List<(int SourceIndex, ItemVariantSource Source, int DocumentOrdinal)>(grouped.Length);
        var doc = 0;
        foreach (var fileGroup in grouped)
        {
            var file = fileGroup.Key;
            var sourceIndex = compositeVariantSelection.TryGetValue(file, out var mapped)
                && mapped >= 0 && mapped < variantSources.Count
                && ReferenceEquals(variantSources[mapped].GbxFile, file)
                ? mapped
                : fileGroup.First().index;
            _ = GetCompositeWorldOffset(sourceIndex);
            selected.Add((sourceIndex, variantSources[sourceIndex], doc));
            doc++;
        }
        return selected;
    }

    private CompositeWorldTransform GetCompositeWorldOffset(int sourceIndex)
    {
        if (!compositeWorldOffsets.TryGetValue(sourceIndex, out var offset))
        {
            offset = new CompositeWorldTransform();
            compositeWorldOffsets[sourceIndex] = offset;
        }
        return offset;
    }

    private static Matrix4x4 MatrixFromPacked(float[] packed)
        => new(packed[0], packed[1], packed[2], packed[3],
            packed[4], packed[5], packed[6], packed[7],
            packed[8], packed[9], packed[10], packed[11],
            packed[12], packed[13], packed[14], packed[15]);

    private static float[] PackMatrix(Matrix4x4 matrix)
        => [matrix.M11, matrix.M12, matrix.M13, matrix.M14, matrix.M21, matrix.M22, matrix.M23, matrix.M24,
            matrix.M31, matrix.M32, matrix.M33, matrix.M34, matrix.M41, matrix.M42, matrix.M43, matrix.M44];

    private Vector3 GetSourcePivotPosition(int sourceIndex)
    {
        if (sourceIndex < 0 || sourceIndex >= variantSources.Count)
            return Vector3.Zero;
        var pivots = variantSources[sourceIndex].Model.DefaultPlacement?.PivotPositions;
        if (pivots is null || pivots.Length == 0)
            return Vector3.Zero;
        var pivot = pivots[0];
        return new Vector3(pivot.X, pivot.Y, pivot.Z);
    }

    private static Quaternion QuaternionFromDegrees(float x, float y, float z)
        => Quaternion.CreateFromYawPitchRoll(
            MathF.PI * y / 180f,
            MathF.PI * x / 180f,
            MathF.PI * z / 180f);

    private Matrix4x4 BuildCompositeRigidTransform(int sourceIndex)
    {
        var offset = GetCompositeWorldOffset(sourceIndex);
        var pivot = GetSourcePivotPosition(sourceIndex);
        var rotation = QuaternionFromDegrees(offset.RotX, offset.RotY, offset.RotZ);
        var rotate = Matrix4x4.CreateFromQuaternion(rotation);
        var rotatedPivot = Vector3.Transform(pivot, rotation);
        var translation = new Vector3(offset.X, offset.Y, offset.Z) + pivot - rotatedPivot;
        rotate.M41 = translation.X;
        rotate.M42 = translation.Y;
        rotate.M43 = translation.Z;
        return rotate;
    }

    private CompositeWorldTransform GetCompositeGroupTransform(int groupId)
    {
        if (!compositeGroupTransforms.TryGetValue(groupId, out var transform))
        {
            transform = new CompositeWorldTransform();
            compositeGroupTransforms[groupId] = transform;
        }
        return transform;
    }

    private CompositeGroupMotion GetCompositeGroupMotion(int groupId)
    {
        if (!compositeGroupMotions.TryGetValue(groupId, out var motion))
        {
            motion = new CompositeGroupMotion();
            compositeGroupMotions[groupId] = motion;
        }
        return motion;
    }

    private Matrix4x4 BuildCompositeGroupRigidTransform(int groupId)
    {
        var offset = GetCompositeGroupTransform(groupId);
        var rotation = QuaternionFromDegrees(offset.RotX, offset.RotY, offset.RotZ);
        var matrix = Matrix4x4.CreateFromQuaternion(rotation);
        var pivot = new Vector3(offset.PivotX, offset.PivotY, offset.PivotZ);
        var rotatedPivot = Vector3.Transform(pivot, rotation);
        var translation = new Vector3(offset.X, offset.Y, offset.Z) + pivot - rotatedPivot;
        matrix.M41 = translation.X;
        matrix.M42 = translation.Y;
        matrix.M43 = translation.Z;
        return matrix;
    }

    private Matrix4x4 BuildCompositeEffectiveRigidTransform(int sourceIndex)
    {
        var sourceRigid = BuildCompositeRigidTransform(sourceIndex);
        if (!compositeGroupBySourceIndex.TryGetValue(sourceIndex, out var groupId))
            return sourceRigid;
        var groupRigid = BuildCompositeGroupRigidTransform(groupId);
        return sourceRigid * groupRigid;
    }

    private void UpdateCompositeTransformFromRigid(int sourceIndex, Matrix4x4 rigid)
    {
        var offset = GetCompositeWorldOffset(sourceIndex);
        var rotation = Quaternion.CreateFromRotationMatrix(rigid);
        var euler = ToEulerDegrees(rotation);
        var pivot = GetSourcePivotPosition(sourceIndex);
        var rotatedPivot = Vector3.Transform(pivot, rotation);
        var translation = new Vector3(rigid.M41, rigid.M42, rigid.M43);
        var worldOffset = translation - pivot + rotatedPivot;
        offset.X = worldOffset.X;
        offset.Y = worldOffset.Y;
        offset.Z = worldOffset.Z;
        offset.RotX = euler.X;
        offset.RotY = euler.Y;
        offset.RotZ = euler.Z;
    }

    private static Vector3 ToEulerDegrees(Quaternion quaternion)
    {
        quaternion = Quaternion.Normalize(quaternion);
        var sinrCosp = 2f * (quaternion.W * quaternion.X + quaternion.Y * quaternion.Z);
        var cosrCosp = 1f - 2f * (quaternion.X * quaternion.X + quaternion.Y * quaternion.Y);
        var pitch = MathF.Atan2(sinrCosp, cosrCosp);

        var sinp = 2f * (quaternion.W * quaternion.Y - quaternion.Z * quaternion.X);
        var yaw = MathF.Abs(sinp) >= 1f ? MathF.CopySign(MathF.PI / 2f, sinp) : MathF.Asin(sinp);

        var sinyCosp = 2f * (quaternion.W * quaternion.Z + quaternion.X * quaternion.Y);
        var cosyCosp = 1f - 2f * (quaternion.Y * quaternion.Y + quaternion.Z * quaternion.Z);
        var roll = MathF.Atan2(sinyCosp, cosyCosp);
        return new Vector3(
            pitch * 180f / MathF.PI,
            yaw * 180f / MathF.PI,
            roll * 180f / MathF.PI);
    }

    private void ApplyCompositePivotLinks()
    {
        var pending = compositePivotLeaderByFollower.Keys.ToHashSet();
        var guard = 0;
        while (pending.Count > 0 && guard++ < 64)
        {
            var progressed = false;
            foreach (var follower in pending.ToArray())
            {
                if (!compositePivotLeaderByFollower.TryGetValue(follower, out var leader)
                    || !compositePivotRelativeByFollower.TryGetValue(follower, out var relative))
                {
                    pending.Remove(follower);
                    progressed = true;
                    continue;
                }
                if (pending.Contains(leader))
                    continue;
                var leaderRigid = BuildCompositeRigidTransform(leader);
                var followerRigid = leaderRigid * relative;
                UpdateCompositeTransformFromRigid(follower, followerRigid);
                pending.Remove(follower);
                progressed = true;
            }
            if (!progressed)
                break;
        }
    }

    private float[]? ApplyCompositeWorldOffset(float[]? worldTransform, int sourceIndex, bool useComposite)
    {
        if (!useComposite || worldTransform is null || worldTransform.Length != 16)
            return worldTransform;
        var local = MatrixFromPacked(worldTransform);
        var global = BuildCompositeEffectiveRigidTransform(sourceIndex);
        return PackMatrix(local * global);
    }

    private float[]? ApplyCompositeOffsetToMotionRest(float[]? restTransform, int sourceIndex, bool useComposite)
    {
        if (!useComposite || restTransform is null || restTransform.Length != 16)
            return restTransform;
        var local = MatrixFromPacked(restTransform);
        var global = BuildCompositeEffectiveRigidTransform(sourceIndex);
        return PackMatrix(local * global);
    }

    private async Task OnCompositeWorldOffsetChanged()
    {
        ApplyCompositePivotLinks();
        if (isViewerInitialized)
            await UpdateScenePayload(authoredMotionScene);
    }

    private CGameItemModel? itemModel;
    private Gbx<CGameItemModel>? gbxFile;
    private bool isLoading = false;
    private string? errorMessage;
    private string? statusMessage;
    private bool hasMesh = false;
    private bool isMovingItem = false;
    private bool isPlaying = true;
    private int vertexCount = 0;
    private bool isSelectingVariant;
    private bool isViewerInitialized = false;
    private string activeTab = "general";
    private DotNetObjectReference<Home>? dotNetHelper;
    private readonly List<ItemVariantSource> variantSources = new();
    private readonly Dictionary<Gbx<CGameItemModel>, int> compositeVariantSelection = new(ReferenceEqualityComparer.Instance);
    private readonly Dictionary<int, int> compositeDocToSourceIndex = new();
    private bool compositeViewportMode;
    private bool CanCombineFiles => variantSources.Select(source => source.GbxFile).Distinct().Take(2).Count() > 1;
    private int activeVariantIndex;
    private ItemVariantSource? SelectedSource => activeVariantIndex >= 0 && activeVariantIndex < variantSources.Count ? variantSources[activeVariantIndex] : null;
    private bool CanExportSelectedFile => SelectedSource is not null;
    private bool CanExportCombinedFiles => CanCombineFiles;
