                                        <input class="form-check-input" type="checkbox" id="@($"group-motion-composite-tab-{group.GroupId}")" aria-label="@($"Group {group.GroupId + 1} Enabled")" data-help-key="active" @bind="motion.Enabled" @bind:after="OnCompositeWorldOffsetChanged" />
                                        <label class="form-check-label" for="@($"group-motion-composite-tab-{group.GroupId}")" data-help-key="active">Active</label>
                                    </div>
                                </div>
                                <div class="motion-channel">
                                    <h6>Translation m</h6>
                                    <div class="motion-range">
                                        <label class="small text-muted mb-0" data-help-key="axis">Axis</label>
