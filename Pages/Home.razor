@page "/"
@implements IAsyncDisposable
@using GBX.NET
@using GBX.NET.Engines.Game
@using GBX.NET.Engines.GameData
@using GBX.NET.Engines.Plug
@using GBX.NET.Engines.MwFoundations
@using GBX.NET.Engines.Meta
@using GBX.NET.Engines.MetaNotPersistent
@using System.IO
@using System.Text
@using System.Globalization
@using System.Reflection
@using System.Numerics
@using System.Security.Cryptography
@using TM_Item_Studio.Models
@using KC = GBX.NET.Engines.Meta.NPlugDyna_SKinematicConstraint
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Trackmania 2020 Item Studio</PageTitle>

<header class="studio-header">
    <h3>Trackmania 2020 Item Studio</h3>
    <div class="studio-documents" aria-label="Loaded files">
        @foreach (var file in LoadedFiles())
        {
            <strong class="studio-variant-filename" title="@file.Label">@file.Label</strong>
        }
    </div>
    <div class="studio-header-tools">
        @if (itemModel is not null)
        {
            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="ReturnToHome" aria-label="Return to home screen">Home</button>
        }
        <details class="studio-diagnostics">
            <summary class="btn btn-sm btn-outline-secondary">Diagnostics (@modelDiagnostics.Count)</summary>
            <div class="studio-diagnostics-panel">
                <button class="btn btn-sm btn-outline-secondary mb-2" @onclick="DownloadDebugReport">Download debug report</button>
                <p class="small text-muted">Reports contain model names, authors and referenced filenames. Review before sharing; nothing is uploaded.</p>
                <ul class="small">
                    @foreach (var diagnostic in modelDiagnostics)
                    {
                        <li><code>@diagnostic.Code</code>: @diagnostic.Message</li>
                    }
                </ul>
            </div>
        </details>
        <div class="studio-upload">
            <label for="item-upload" class="btn btn-sm btn-outline-secondary" data-helper="Open one or more .Item.Gbx files. Multiple files can be inspected together in Composite viewport mode.">Open item files</label>
            <InputFile id="item-upload" OnChange="LoadFiles" multiple accept=".gbx" class="visually-hidden" />
            <label for="vanilla-folder-upload" class="btn btn-sm btn-outline-primary" data-helper="After opening a vanilla .Item.Gbx, choose the extracted GameData folder (or Stadium for Stadium assets). Item Studio follows the item's Media GBX references so its real mesh can be shown.">Load GameData dependencies</label>
            <InputFile id="vanilla-folder-upload" OnChange="LoadVanillaFolder" multiple webkitdirectory directory class="visually-hidden" />
        </div>
        <button class="btn btn-sm @(helperMode ? "btn-primary" : "btn-outline-secondary")" type="button" aria-pressed="@helperMode.ToString().ToLowerInvariant()" @onclick="ToggleHelperMode" data-helper="Turn on Getting Started help. Hover settings to see what they change and how to use them.">@(helperMode ? "Helper on" : "Helper")</button>
        <button class="btn btn-sm btn-outline-secondary" type="button" onclick="studioTheme.toggle()" aria-label="Switch light or dark theme">Light / dark</button>
    </div>
</header>

@if (helperMode)
{
    <section class="studio-helper-banner" role="note" aria-label="Getting Started">
        <strong>Getting Started</strong>
        <span>1. Load an item. 2. Use the viewport buttons or numpad keys to inspect it. 3. Open an inspector section to edit a setting. 4. Export when ready.</span>
        <span class="studio-helper-banner-hint">Hover a highlighted control for details. Turn Helper off to return to the normal interface.</span>
    </section>
}
@if (isLoading)
{
    <div class="alert alert-info py-2">
        <em>Loading item, analysing geometry, PivotPositions, lights and metadata...</em>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger py-2">
        <strong>Error:</strong> @errorMessage
    </div>
}

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-info py-2" role="status">
        <strong>Note:</strong> @statusMessage
    </div>
}

@if (itemModel != null)
{
    <div class="studio-workspace">
        
        <!-- ================= 3D VIEWPORT ================= -->
        <div class="studio-viewport-column">
            <div class="studio-viewport">
                
                <!-- Viewport Toolbar -->
                <div class="studio-viewport-toolbar">
                    <!-- Layer toggles -->
                    <div class="btn-group btn-group-sm">
                        <button class="btn @(showMeshes ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleLayer("meshes"))" data-helper="Show or hide renderable mesh geometry in the viewport. Use this to focus on pivots, lights or paths.">
                            Meshes
                        </button>
                        <button class="btn @(showPivots ? "btn-warning text-dark" : "btn-outline-secondary")" @onclick="@(() => ToggleLayer("pivots"))" data-helper="Show or hide PivotPositions. These are the editable placement anchors stored by the item.">
                            Pivots (@detectedPivots.Count)
                        </button>
                        <button class="btn @(showLights ? "btn-info text-dark" : "btn-outline-secondary")" @onclick="@(() => ToggleLayer("lights"))" data-helper="Show or hide authored light markers. Light color, intensity and radius can be edited when present.">
                            Lights (@detectedLights.Count)
                        </button>
                        @if (authoredConstraints.Count > 0)
                        {
                            <button class="btn @(showWaypoints ? "btn-success text-white" : "btn-outline-secondary")" @onclick="@(() => ToggleLayer("waypoints"))" title="Show/hide interactive 3D waypoints (A/B points)">
                                Paths (@authoredConstraints.Count)
                            </button>
                        }
                    </div>

                    <div class="studio-variants" role="group" aria-label="Loaded items and variants" aria-busy="@isSelectingVariant.ToString().ToLowerInvariant()">
                        <div class="studio-variants-heading">
                            <span>Loaded items</span>
                            <span class="studio-variants-count">@LoadedFiles().Count()</span>
                        </div>
                        <div class="studio-item-switcher">
                            @foreach (var file in LoadedFiles())
                            {
                                var fileActive = file.Entries.Any(entry => entry.Index == activeVariantIndex);
                                var firstEntry = file.Entries[0];
                                <div class="studio-item-switcher-row @(fileActive ? "studio-item-switcher-row-active" : "")">
                                    <button class="studio-item-tab @(fileActive ? "studio-item-tab-active" : "")"
                                            aria-label="Select @file.Label"
                                            aria-pressed="@fileActive.ToString().ToLowerInvariant()"
                                            title="@file.Label"
                                            aria-disabled="@isSelectingVariant.ToString().ToLowerInvariant()"
                                            @onclick="@(() => SelectVariant(firstEntry.Index))">
                                        <span class="studio-item-tab-name">@file.Label</span>
                                        <span class="studio-item-tab-count">@file.Entries.Length</span>
                                    </button>
                                    @if (file.Entries.Length > 1)
                                    {
                                        <div class="studio-item-variants" aria-label="Variants for @file.Label">
                                            @foreach (var entry in file.Entries)
                                            {
                                                var variantIndex = entry.Index;
                                                <button class="studio-item-variant @(variantIndex == activeVariantIndex ? "studio-item-variant-active" : "")"
                                                        aria-label="@($"{file.Label}, variant {entry.Source.VariantNumber}")"
                                                        aria-pressed="@((variantIndex == activeVariantIndex).ToString().ToLowerInvariant())"
                                                        aria-disabled="@isSelectingVariant.ToString().ToLowerInvariant()"
                                                        @onclick="@(() => SelectVariant(variantIndex))">
                                                    @entry.Source.VariantNumber
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <span class="visually-hidden" role="status">@(isSelectingVariant ? "Loading item…" : "Select an item to make it active.")</span>
                    </div>
                    @if (CanCombineFiles)
                    {
                        <div class="form-check form-switch ms-2">
                            <input class="form-check-input" id="compositeViewportMode" type="checkbox" @bind="compositeViewportMode" @bind:after="OnCompositeModeChanged" data-helper="When multiple files are loaded, show their selected variants together in one viewport. Original item transforms are preserved.">
                            <label class="form-check-label small" for="compositeViewportMode">Composite viewport (multi-item)</label>
                        </div>
                    }
                    @if (compositeViewportMode && SelectedSource is not null)
                    {
                        <span class="studio-active-item small text-info" title="@SelectedSource.Name">Active item: <strong>@SelectedSource.Name</strong></span>
                    }

                    <!-- Animation and general controls -->
                    <div class="studio-view-controls">
                        @if (isMovingItem || hasBakedAnimation)
                        {
                            <button class="btn btn-sm @(isPlaying ? "btn-warning" : "btn-success")" aria-label="Play or pause viewport animation" data-helper="Pause or resume the viewport animation without changing its serialized motion timeline." @onclick="ToggleAnimation">
                                @(isPlaying ? "⏸" : "▶")
                            </button>
                            @if (isMovingItem && authoredConstraints.Count == 0)
                            {
                                <select class="form-select form-select-sm" style="width: auto;" aria-label="Legacy preview axis" data-help-key="axis" value="@detectedAxis" @onchange="OnAxisChanged">
                                    <option value="y">Y Axis</option>
                                    <option value="x">X Axis</option>
                                    <option value="z">Z Axis</option>
                                </select>
                            }
                        }
                        <button class="btn btn-sm btn-outline-light" @onclick="ToggleWireframe">Wire</button>
                        <div class="studio-view-presets" role="group" aria-label="Viewport views">
                            <button class="btn btn-sm btn-outline-secondary" title="Perspective view (Numpad 5)" data-helper="Perspective orbit view. Keyboard shortcut: Numpad 5." @onclick="@(() => SetViewportView("perspective"))">Persp</button>
                            <button class="btn btn-sm btn-outline-secondary" title="Top view (Numpad 7)" data-helper="World top view looking down the Y axis. Keyboard shortcut: Numpad 7." @onclick="@(() => SetViewportView("top"))">Top</button>
                            <button class="btn btn-sm btn-outline-secondary" title="Front view (Numpad 1)" data-helper="Front view along the Z axis. Keyboard shortcut: Numpad 1." @onclick="@(() => SetViewportView("front"))">Front</button>
                            <button class="btn btn-sm btn-outline-secondary" title="Right view (Numpad 3)" data-helper="Right-side view along the X axis. Keyboard shortcut: Numpad 3." @onclick="@(() => SetViewportView("right"))">Right</button>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetCamera">Reset Camera</button>
                        @if (hasMesh)
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="DownloadObj">.OBJ</button>
                        }
                    </div>
                </div>
                
                <!-- 3D Canvas container -->
                <div class="studio-mood-controls p-2 d-flex gap-1 flex-wrap" role="group" aria-label="Trackmania viewport mood">
                    <span class="small align-self-center me-1">World mood</span>
                    @foreach (var mood in new[] { "neutral", "morning", "day", "evening", "night" })
                    {
                        <button class="btn btn-sm @(viewportMood == mood ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@((viewportMood == mood).ToString().ToLowerInvariant())" @onclick="@(() => SetViewportMood(mood))">@CultureInfo.InvariantCulture.TextInfo.ToTitleCase(mood)</button>
                    }
                </div>
                <div id="threeContainer">
                </div>
            </div>
            @if (!hasMesh)
            {
                <p class="small mt-2" role="status">No mesh geometry available. See Model diagnostics for external or unsupported references.</p>
            }
            
            <div class="studio-viewport-caption text-muted small">
                <div>
                    <span><span style="color: #b8bdc6;">■</span> Mesh</span>
                    <span class="ms-2"><span style="color: #facc15;">●</span> Pivot</span>
                    <span class="ms-2"><span style="color: #fffbeb;">💡</span> Light</span>
                    @if (authoredConstraints.Count > 0)
                    {
                        <span class="ms-2"><span style="color: #22c55e;">●</span> Point A (Start)</span>
                        <span class="ms-2"><span style="color: #f97316;">●</span> Point B (End)</span>
                        <span class="ms-2"><span style="color: #00ffff;">➔</span> Motion path</span>
                    }
                </div>
                <div>
                    @if (authoredConstraints.Count > 0)
                    {
                        <em>Tip: Click a constraint or the 3D waypoints (A/B) to move the path directly in 3D with the transform gizmo.</em>
                    }
                    else
                    {
                        <em>Tip: Select a pivot gizmo and move it with the transform arrows. Lights can be selected but not moved.</em>
                    }
                </div>
            </div>
            @if (hasMesh)
            {
                <p class="small text-muted mt-2">@(gameDataIndexed ? "GameData textures loaded locally. Grid: 1 m / 8 m / 32 m." : "Choose GameData or a local texture folder in Materials & LOD to load matching Trackmania textures.")</p>
            }
            @if (moodStatus is not null) { <p class="small text-muted" role="status">@moodStatus</p> }
        </div>

        <!-- ================= RECHTERKOLOM: TABBED INSPECTOR ================= -->
        <div class="studio-inspector">
            
            <div class="studio-inspector-tabs p-2 bg-light border-bottom">
                <div>
                    <button aria-label="Item Identification & Collector Metadata" aria-expanded="@((activeTab == "general").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "general" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("general"))">
                        <span>Identity</span><span>@(activeTab == "general" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="Placement Parameters & PivotPositions" aria-expanded="@((activeTab == "placement").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "placement" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("placement"))">
                        <span>Placement & pivots</span><span>@(activeTab == "placement" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="WaypointType, Gameplay & Kinematics" aria-expanded="@((activeTab == "gameplay").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "gameplay" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("gameplay"))">
                        <span>Kinematics</span><span>@(activeTab == "gameplay" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="@($"Dynamic Real-Time Lights ({detectedLights.Count})")" aria-expanded="@((activeTab == "lights").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "lights" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("lights"))">
                        <span>Lights (@detectedLights.Count)</span><span>@(activeTab == "lights" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="Socket authoring capability (read-only)" aria-expanded="@((activeTab == "sockets").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "sockets" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("sockets"))">
                        <span>Sockets</span><span>@(activeTab == "sockets" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="PhyModel, CPlugSurface & Collision" aria-expanded="@((activeTab == "physics").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "physics" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("physics"))">
                        <span>Collision</span><span>@(activeTab == "physics" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="VisModel, Materials & LOD" aria-expanded="@((activeTab == "visual").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "visual" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("visual"))">
                        <span>Materials & LOD</span><span>@(activeTab == "visual" ? "−" : "+")</span>
                    </button>
                </div>
                @if (CanCombineFiles)
                {
                    <div>
                        <button aria-label="Composite world transforms and group motion"
                                aria-expanded="@((activeTab == "composite").ToString().ToLowerInvariant())"
                                class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "composite" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="@(() => ToggleTab("composite"))">
                            <span>Composite transforms</span><span>@(activeTab == "composite" ? "−" : "+")</span>
                        </button>
                    </div>
                }
                <div>
                    <button aria-label="Audio, CPlugFx & MediaTracker Triggers" aria-expanded="@((activeTab == "extras").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "extras" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("extras"))">
                        <span>Audio & effects</span><span>@(activeTab == "extras" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="Macroblock export and item instancing" aria-expanded="@((activeTab == "macroblock").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "macroblock" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("macroblock"))">
                        <span>Macroblock & instances (@macroblockInstances.Count)</span><span>@(activeTab == "macroblock" ? "−" : "+")</span>
                    </button>
                </div>
                <div>
                    <button aria-label="Flag item conversion" aria-expanded="@((activeTab == "flag").ToString().ToLowerInvariant())" class="btn btn-sm text-start d-flex justify-content-between align-items-center @(activeTab == "flag" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => ToggleTab("flag"))">
                        <span>Flag item</span><span>@(activeTab == "flag" ? "−" : "+")</span>
                    </button>
                </div>
            </div>

            <div class="studio-inspector-content p-3" style="overflow-y: auto; flex-grow: 1; font-size: 0.9em;">
                @if (SelectedSource?.IsReadOnly == true)
                {
                    <div class="alert alert-info small" role="status"><strong>Vanilla asset preview</strong><p class="mb-0 text-break">@SelectedSource.PreviewDescription</p><p class="mb-0">Mesh parts: @modelParts.Count · Materials: @detectedMaterials.Count. Original file retained unchanged.</p></div>
                }
                @if (IsOpaqueFxCarrier && SelectedSource?.PreviewOverride is CPlugPrefab)
                {
                    <div class="alert alert-info small" role="status"><strong>Embedded FX mesh</strong><p class="mb-0">Showing this item's actual embedded mesh. FX origin and identity changes are exported; mesh and material controls affect the preview only.</p></div>
                }
                
                @if (activeTab == "general" && SelectedSource?.IsReadOnly != true)
                {
                    <h6 class="border-bottom pb-1 text-primary">1. Ident (Id, Author, Collection) <span class="text-muted" title="Defines the item's internal ID, author and context collection.">?</span></h6>
                    <div class="mb-2">
                        <label for="ident-id" class="form-label mb-0 fw-bold" data-help-key="identidfilename">Ident.Id / File name</label>
                        <input id="ident-id" type="text" class="form-control form-control-sm" @bind="identId" @bind:after="UpdateIdent" />
                    </div>
                    <div class="mb-2">
                        <label for="ident-author" class="form-label mb-0 fw-bold" data-help-key="identauthor">Ident.Author</label>
                        <input id="ident-author" type="text" class="form-control form-control-sm" @bind="identAuthor" @bind:after="UpdateIdent" />
                    </div>
                    <div class="mb-2">
                        <label for="ident-collection" class="form-label mb-0 fw-bold" data-help-key="identcollection">Ident.Collection</label>
                        <input id="ident-collection" type="text" class="form-control form-control-sm" aria-describedby="ident-collection-help" @bind="identCollection" @bind:after="UpdateIdent" />
                        <small id="ident-collection-help" class="text-muted">Unchanged values keep their encoding. Numeric edits use IDs 0–1073741823 (26 for TM2020); other edits stay strings.</small>
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-0 fw-bold" data-help-key="itemtypeeitemtype">ItemType (EItemType)</label>
                        <select class="form-select form-select-sm" @bind="itemModel.ItemType">
                            @foreach (var type in Enum.GetValues<CGameItemModel.EItemType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-0 fw-bold" data-help-key="archetypeinventorypath">Archetype / Inventory Path</label>
                        <input type="text" class="form-control form-control-sm" value="@(itemModel.ArchetypeRef ?? "None")" readonly />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-8">
                            <label class="form-label mb-0 fw-bold" data-help-key="internalitemname">Internal item name</label>
                            <input type="text" class="form-control form-control-sm" @bind="itemModel.Name" />
                            <div class="form-text">Exports with an Ident.Id use that ID as the internal item name to avoid Trackmania catalog collisions.</div>
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 fw-bold" data-help-key="copperprice">CopperPrice</label>
                            <input type="number" min="0" class="form-control form-control-sm" @bind="itemModel.CopperPrice" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-0 fw-bold" data-help-key="description">Description</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="itemModel.Description"></textarea>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label mb-0 small fw-bold" data-help-key="pagename">PageName</label>
                            <input type="text" class="form-control form-control-sm" @bind="itemModel.PageName" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-0 small fw-bold" data-help-key="catalogposition">CatalogPosition</label>
                            <input type="number" class="form-control form-control-sm" @bind="itemModel.CatalogPosition" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label mb-0 small fw-bold" data-help-key="nbavailablemin">NbAvailableMin</label>
                            <input type="number" min="0" class="form-control form-control-sm" @bind="itemModel.NbAvailableMin" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-0 small fw-bold" data-help-key="nbavailablemax">NbAvailableMax</label>
                            <input type="number" min="0" class="form-control form-control-sm" @bind="itemModel.NbAvailableMax" />
                        </div>
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="internalItem" @bind="itemModel.IsInternal" />
                        <label class="form-check-label small" for="internalItem" data-help-key="isinternal">IsInternal</label>
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="needUnlock" @bind="itemModel.NeedUnlock" />
                        <label class="form-check-label small" for="needUnlock" data-help-key="needunlock">NeedUnlock</label>
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="advancedItem" @bind="itemModel.IsAdvanced" />
                        <label class="form-check-label small" for="advancedItem" data-help-key="isadvanced">IsAdvanced</label>
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="autoIcon" @bind="itemModel.IconUseAutoRender" />
                        <label class="form-check-label small" for="autoIcon" data-help-key="iconuseautorender">IconUseAutoRender</label>
                    </div>
                    <div class="row g-2 mb-2 mt-1">
                        <div class="col-8">
                            <label class="form-label mb-0 small fw-bold" data-help-key="skindirectory">SkinDirectory</label>
                            <input type="text" class="form-control form-control-sm" @bind="itemModel.SkinDirectory" />
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 small fw-bold" data-help-key="iconquarterrotationy">IconQuarterRotationY</label>
                            <input type="number" min="0" max="3" class="form-control form-control-sm" @bind="itemModel.IconQuarterRotationY" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-8">
                            <label class="form-label mb-0 small fw-bold" data-help-key="defaultweaponname">DefaultWeaponName</label>
                            <input type="text" class="form-control form-control-sm" @bind="itemModel.DefaultWeaponName" />
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 small fw-bold" data-help-key="defaultcamindex">DefaultCamIndex</label>
                            <input type="number" min="0" class="form-control form-control-sm" @bind="itemModel.DefaultCamIndex" />
                        </div>
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="disableLightmap" @bind="itemModel.DisableLightmap" />
                        <label class="form-check-label small" for="disableLightmap" data-help-key="disablelightmap">DisableLightmap</label>
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-0 fw-bold" data-help-key="iconcplugbitmapdxtbuffer">Stored inventory icon</label>
                        <div id="icon-dropzone" class="icon-dropzone mb-2 p-2 bg-dark rounded text-center" data-helper="Drop an image here to replace the item icon. The image is center-cropped and normalized to 64×64 RGBA pixels.">
                            <canvas id="iconPreviewCanvas" width="128" height="128" aria-label="Stored item icon preview" style="width:128px;height:128px;image-rendering:auto;border:1px solid #495057;"></canvas>
                            <span class="icon-dropzone-hint">Drop an image here</span>
                        </div>
                        <div class="input-group input-group-sm">
                            <InputFile id="icon-upload" aria-label="Replace item icon" data-help-key="iconcplugbitmapdxtbuffer" OnChange="UploadIcon" accept="image/jpeg,image/png,image/webp" class="form-control" />
                            <span class="input-group-text" title="The image is center-cropped and resized to the 64x64 RGBA Icon format used by the item model.">?</span>
                        </div>
                        <small class="text-muted">JPG, PNG or WebP. The image is normalized to 64x64. @iconFileName</small>
                        @if (!string.IsNullOrWhiteSpace(iconStatus))
                        {
                            <small class="d-block text-info" role="status">@iconStatus</small>
                        }
                        <small class="d-block text-muted" role="status">@iconPreviewStatus</small>
                    </div>
                }

                @if (activeTab == "placement")
                {
                    <h6 class="border-bottom pb-1 text-primary">2. CGameItemPlacementParam <span class="text-muted" title="Controls placement, snapping and PivotPositions in the Trackmania editor.">?</span></h6>
                    @if (itemModel.DefaultPlacement != null)
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <label class="form-label mb-0 small fw-bold" data-help-key="groundpointx">GroundPoint X</label>
                                <input type="number" step="0.1" class="form-control form-control-sm" value="@itemModel.GroundPoint.X" @onchange="@(e => UpdateGroundPoint(0, e.Value))" />
                            </div>
                            <div class="col-4">
                                <label class="form-label mb-0 small fw-bold" data-help-key="groundpointy">GroundPoint Y</label>
                                <input type="number" step="0.1" class="form-control form-control-sm" value="@itemModel.GroundPoint.Y" @onchange="@(e => UpdateGroundPoint(1, e.Value))" />
                            </div>
                            <div class="col-4">
                                <label class="form-label mb-0 small fw-bold" data-help-key="groundpointz">GroundPoint Z</label>
                                <input type="number" step="0.1" class="form-control form-control-sm" value="@itemModel.GroundPoint.Z" @onchange="@(e => UpdateGroundPoint(2, e.Value))" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold" data-help-key="paintergroundmarginm">PainterGroundMargin (m)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="itemModel.PainterGroundMargin" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold" data-help-key="orbitalcenterheightfromgroundm">OrbitalCenterHeightFromGround (m)</label>
                                <input type="number" step="0.1" class="form-control form-control-sm" @bind="itemModel.OrbitalCenterHeightFromGround" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold" data-help-key="orbitalradiusbasem">OrbitalRadiusBase (m)</label>
                                <input type="number" step="0.1" class="form-control form-control-sm" @bind="itemModel.OrbitalRadiusBase" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold" data-help-key="orbitalpreviewangle">OrbitalPreviewAngle</label>
                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="itemModel.OrbitalPreviewAngle" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold" data-help-key="gridsnaphstepm">GridSnap H Step (m)</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="itemModel.DefaultPlacement.GridSnapHStep" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold" data-help-key="gridsnapvstepm">GridSnap V Step (m)</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="itemModel.DefaultPlacement.GridSnapVStep" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold" data-help-key="gridsnaphoffset">GridSnap H Offset</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="itemModel.DefaultPlacement.GridSnapHOffset" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold" data-help-key="gridsnapvoffset">GridSnap V Offset</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="itemModel.DefaultPlacement.GridSnapVOffset" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold" data-help-key="flyvstep">Fly V Step</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="itemModel.DefaultPlacement.FlyVStep" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small fw-bold" data-help-key="flyvoffset">Fly V Offset</label>
                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="itemModel.DefaultPlacement.FlyVOffset" />
                            </div>
                        </div>

                        <h6 class="border-bottom pb-1 mt-3 text-primary">Rotation placement flags</h6>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="yawOnly" @bind="itemModel.DefaultPlacement.YawOnly" />
                            <label class="form-check-label small" for="yawOnly" data-help-key="yawonly">YawOnly</label>
                        </div>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="notOnObject" @bind="itemModel.DefaultPlacement.NotOnObject" />
                            <label class="form-check-label small" for="notOnObject" data-help-key="notonobject">NotOnObject</label>
                        </div>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="autoRot" @bind="itemModel.DefaultPlacement.AutoRotation" />
                            <label class="form-check-label small" for="autoRot" data-help-key="autorotation">AutoRotation</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="switchPivot" @bind="itemModel.DefaultPlacement.SwitchPivotManually" />
                            <label class="form-check-label small" for="switchPivot" data-help-key="switchpivotmanually">SwitchPivotManually</label>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                            <h6 class="mb-0 text-primary">Pivots (@detectedPivots.Count)</h6>
                            <button class="btn btn-xs btn-outline-primary" style="font-size:0.75em; padding: 2px 6px;" @onclick="AddPivot">
                                + PivotPosition
                            </button>
                        </div>

                        @for (int i = 0; i < detectedPivots.Count; i++)
                        {
                            var p = detectedPivots[i];
                            int pIdx = i;
                            <div class="card p-2 bg-light mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small">PivotPosition @p.Index @(pIdx == 0 ? "(Default)" : "")</strong>
                                    <div>
                                        <button class="btn btn-xs btn-outline-secondary" style="font-size:0.7em;" @onclick="@(() => SelectGizmoIn3D("pivot", pIdx))">
                                            Select in 3D
                                        </button>
                                        @if (pIdx > 0)
                                        {
                                            <button class="btn btn-xs btn-outline-danger ms-1" style="font-size:0.7em;" aria-label="@($"Remove pivot {pIdx + 1}")" data-helper="Remove this placement pivot from the exported item. Other pivots and the mesh remain; select a replacement pivot before removing an anchor you use." @onclick="@(() => RemovePivot(pIdx))">✕</button>
                                        }
                                    </div>
                                </div>
                                <div class="row g-1">
                                    <div class="col-4">
                                        <input type="number" step="0.1" class="form-control form-control-sm" aria-label="@($"p {pIdx + 1} X")" data-help-key="pivotposition" @bind="p.X" @bind:after="@(() => OnPivotChanged(pIdx))" />
                                    </div>
                                    <div class="col-4">
                                        <input type="number" step="0.1" class="form-control form-control-sm" aria-label="@($"p {pIdx + 1} Y")" data-help-key="pivotposition" @bind="p.Y" @bind:after="@(() => OnPivotChanged(pIdx))" />
                                    </div>
                                    <div class="col-4">
                                        <input type="number" step="0.1" class="form-control form-control-sm" aria-label="@($"p {pIdx + 1} Z")" data-help-key="pivotposition" @bind="p.Z" @bind:after="@(() => OnPivotChanged(pIdx))" />
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2 mt-3">
                            <h6 class="mb-0 text-primary">Placement alternatives (@detectedPlacementAlternatives.Count)</h6>
                            <button class="btn btn-xs btn-outline-primary" style="font-size:0.75em; padding: 2px 6px;" @onclick="AddPlacementAlternative">
                                + Alternative
                            </button>
                        </div>
                        <p class="small text-muted mb-1">
                            Extra placement slots from chunk <code>2E020004</code>: position in metres, rotation in degrees.
                            Game-authored gate items carry two.
                        </p>
                        @if (!string.IsNullOrWhiteSpace(placementAlternativeStatus))
                        {
                            <small class="d-block text-info mb-1">@placementAlternativeStatus</small>
                        }
                        @for (int i = 0; i < detectedPlacementAlternatives.Count; i++)
                        {
                            var alternative = detectedPlacementAlternatives[i];
                            int aIdx = i;
                            <div class="card p-2 bg-light mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small">Alternative @(aIdx + 1)</strong>
                                    <button class="btn btn-xs btn-outline-danger" style="font-size:0.7em;" aria-label="@($"Remove placement alternative {aIdx + 1}")" data-helper="Remove this alternative placement transform from the exported item. It does not remove geometry or other placement alternatives." @onclick="@(() => RemovePlacementAlternative(aIdx))">✕</button>
                                </div>
                                <div class="row g-1 mb-1">
                                    <div class="col-4">
                                        <input type="number" step="0.1" class="form-control form-control-sm" aria-label="@($"alternative {aIdx + 1} X")" data-help-key="alternative" @bind="alternative.X" @bind:after="@(() => OnPlacementAlternativeChanged(aIdx))" />
                                    </div>
                                    <div class="col-4">
                                        <input type="number" step="0.1" class="form-control form-control-sm" aria-label="@($"alternative {aIdx + 1} Y")" data-help-key="alternative" @bind="alternative.Y" @bind:after="@(() => OnPlacementAlternativeChanged(aIdx))" />
                                    </div>
                                    <div class="col-4">
                                        <input type="number" step="0.1" class="form-control form-control-sm" aria-label="@($"alternative {aIdx + 1} Z")" data-help-key="alternative" @bind="alternative.Z" @bind:after="@(() => OnPlacementAlternativeChanged(aIdx))" />
                                    </div>
                                </div>
                                <div class="row g-1">
                                    <div class="col-4">
                                        <input type="number" step="1" class="form-control form-control-sm" aria-label="@($"alternative {aIdx + 1} RotX")" data-help-key="alternative" @bind="alternative.RotX" @bind:after="@(() => OnPlacementAlternativeChanged(aIdx))" />
                                    </div>
                                    <div class="col-4">
                                        <input type="number" step="1" class="form-control form-control-sm" aria-label="@($"alternative {aIdx + 1} RotY")" data-help-key="alternative" @bind="alternative.RotY" @bind:after="@(() => OnPlacementAlternativeChanged(aIdx))" />
                                    </div>
                                    <div class="col-4">
                                        <input type="number" step="1" class="form-control form-control-sm" aria-label="@($"alternative {aIdx + 1} RotZ")" data-help-key="alternative" @bind="alternative.RotZ" @bind:after="@(() => OnPlacementAlternativeChanged(aIdx))" />
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }

                @if (activeTab == "flag")
                {
                    <WavingFlagPanel Source="@(variantSources.Count > activeVariantIndex ? variantSources[activeVariantIndex].GbxFile : gbxFile)" PreferredId="@identId" PrepareSource="PrepareWavingFlagSource" SelectedPartPath="@selectedMeshPartPath" ClearSelectionRequested="ClearFlagViewportSelection" Anchor="@flagConversionAnchor" />

                    <h6 class="border-bottom pb-1 text-primary">Classification and placement only <span class="text-muted" title="A flag is an item whose model variant carries the tag Type=Flag and whose placement class keeps it upright and aligned to the world direction.">?</span></h6>
                    <small class="d-block text-muted mb-2">
                        Measured on <code>Stadium/Items/Flag16m.Item.Gbx</code>, <code>Flag8m.Item.Gbx</code> and
                        <code>Stadium/Media/PlaceParam/Flag.PlaceParam.Gbx</code>. Conversion writes the variant tag
                        and the placement class only: it cannot create the flag's cloth, pole or textures.
                    </small>

                    @if (CurrentFlagReport is { } flagReport)
                    {
                        @if (flagReport.IsFlag)
                        {
                            <div class="alert alert-success py-1 px-2 mb-2"><small>This item carries the measured flag signature.</small></div>
                        }
                        else
                        {
                            <div class="alert alert-secondary py-1 px-2 mb-2">
                                <small class="d-block fw-bold">@flagReport.Deviations.Count deviation(s) from the flag signature</small>
                                @foreach (var deviation in flagReport.Deviations)
                                {
                                    <small class="d-block">• <code>@deviation.Field</code>: @deviation.Actual instead of @deviation.Expected</small>
                                }
                            </div>
                        }

                        @foreach (var note in flagReport.Notes)
                        {
                            <small class="d-block text-info mb-1">@note</small>
                        }

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="flagNormalizePlacement" @bind="normalizeFlagPlacement" />
                            <label class="form-check-label small" for="flagNormalizePlacement" data-help-key="flagnormalizeplacement">
                                Also write the measured placement values (flags, cube, snapping, fly steps)
                            </label>
                        </div>

                        <button class="btn btn-sm btn-primary" @onclick="ExportFlagItem" disabled="@isExportingFlag">
                            @(isExportingFlag ? "Converting…" : "Convert to flag item (.Item.Gbx)")
                        </button>
                    }
                    else
                    {
                        <small class="d-block text-muted">No item is loaded.</small>
                    }

                    @if (!string.IsNullOrWhiteSpace(flagExportStatus))
                    {
                        <small class="d-block text-info mt-2">@flagExportStatus</small>
                    }
                    @foreach (var warning in flagExportWarnings)
                    {
                        <small class="d-block text-warning mt-1">@warning</small>
                    }
                }

                @if (activeTab == "gameplay")
                {
                    <div class="mb-2">
                        <label class="form-label mb-0 fw-bold" data-help-key="waypointtype">Waypoint Type</label>
                        <select class="form-select form-select-sm" @bind="itemModel.WaypointType">
                            @foreach (var wp in Enum.GetValues<CGameItemModel.EWaypointType>())
                            {
                                <option value="@wp">@wp</option>
                            }
                        </select>
                    </div>

                    <h6 class="border-bottom pb-1 text-primary">@(authoredConstraints.Count > 0 ? "Kinematic controls" : "Motion capability")</h6>
                    <div class="@(authoredConstraints.Count > 0 ? "authored-motion-shell" : "card p-3 bg-light mb-3")">
                        <details class="card p-2 mb-3" data-testid="draw-motion-path">
                            <summary class="fw-bold">Draw motion path</summary>
                            <p class="small text-muted mt-2">Click points on the selected drawing plane, or enter their coordinates. Preview the route before applying it. Choose whether the mesh centre or body origin follows the points. Right-drag to orbit the camera.</p>
                            <div class="row g-2 small">
                                <div class="col-12"><label class="form-label" for="pathUse">Use</label>
                                    <select id="pathUse" aria-label="Path use" title="Choose a straight obstacle with driven collision or a scenery polyline." class="form-select form-select-sm" @bind="drawPathUse" @bind:after="RefreshDrawPathPreview">
                                        <option value="@MotionPathUse.Obstacle">Obstacle / platform — straight line</option>
                                        <option value="@MotionPathUse.Scenery">Scenery — polyline, no usable collision</option>
                                    </select>
                                </div>
                                <div class="col-6"><label class="form-label" for="pathRepeat">Repeat</label>
                                    <select id="pathRepeat" aria-label="Path repeat" title="Return along the route, close the loop, or jump to its start." class="form-select form-select-sm" @bind="drawPathRepeat" @bind:after="RefreshDrawPathPreview">
                                        <option value="@MotionPathRepeat.PingPong">Return along path</option>
                                        <option value="@MotionPathRepeat.Closed">Close loop</option>
                                        <option value="@MotionPathRepeat.Reset">Jump to start</option>
                                    </select>
                                </div>
                                <div class="col-6"><label class="form-label" for="pathEase">Movement</label>
                                    <select id="pathEase" aria-label="Path movement" title="Choose the speed profile used separately on each leg." class="form-select form-select-sm" @bind="drawPathEase" @bind:after="RefreshDrawPathPreview">
                                        <option value="@KC.AnimEase.Linear">Constant speed</option>
                                        <option value="@KC.AnimEase.QuadInOut">Ease in and out</option>
                                        <option value="@KC.AnimEase.QuadIn">Ease in</option>
                                        <option value="@KC.AnimEase.QuadOut">Ease out</option>
                                    </select>
                                </div>
                                <div class="col-6"><label class="form-label" for="pathSpeed">Average speed (m/s)</label><input id="pathSpeed" aria-label="Path average speed" title="Average speed during each moving leg in metres per second." type="number" min="0.1" max="1000" step="0.1" class="form-control form-control-sm" @bind="drawPathMetersPerSecond" @bind:after="RefreshDrawPathPreview" /></div>
                                <div class="col-6"><label class="form-label" for="pathPause">Pause at points (ms)</label><input id="pathPause" aria-label="Path waypoint pause" title="Wait at each waypoint in milliseconds." type="number" min="0" max="60000" step="100" class="form-control form-control-sm" @bind="drawPathPauseMs" @bind:after="RefreshDrawPathPreview" /></div>
                                <div class="col-6"><label class="form-label" for="pathPlane">Drawing plane</label>
                                    <select id="pathPlane" aria-label="Drawing plane" title="Choose the plane on which mouse clicks place route points." class="form-select form-select-sm" @bind="drawPathPlane" @bind:after="UpdateDrawPlane">
                                        <option value="XZ">XZ — horizontal</option><option value="XY">XY — vertical</option><option value="YZ">YZ — vertical</option>
                                    </select>
                                </div>
                                <div class="col-6"><label class="form-label" for="pathPlaneOffset">Plane offset (m)</label><input id="pathPlaneOffset" aria-label="Drawing plane offset" title="Offset the drawing plane along its perpendicular axis, in metres." type="number" step="0.5" class="form-control form-control-sm" @bind="drawPathPlaneOffset" @bind:after="UpdateDrawPlane" /></div>
                            </div>
                            <p class="small text-warning mt-2 mb-2">@(drawPathUse == MotionPathUse.Obstacle
                                ? "Exactly two points. Aligns the model's local X axis with the line; this can rotate the model. Collision stays directly driven. Test your exported geometry in Trackmania."
                                : "Keeps the model orientation. Up to eight legs including the return. Removes the moving body's full-size collider; static parts remain: parent-driven collision does not follow this path in Trackmania.")</p>
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <button class="btn btn-sm btn-outline-primary" @onclick="ToggleDrawPathCapture" aria-label="@(drawPathCaptureEnabled ? "Stop drawing" : "Start drawing")" title="Place points by clicking the selected plane. Right-drag orbits the camera.">@(drawPathCaptureEnabled ? "Stop drawing" : "Start drawing")</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="UndoDrawPath" aria-label="Undo point" title="Remove the last drawn point without changing applied motion.">Undo point</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearDrawPath" aria-label="Clear points" title="Clear route points without changing applied motion.">Clear points</button>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <select class="form-select form-select-sm" aria-label="Path anchor" title="Choose the point of the moving mesh that follows the route." @bind="drawPathAnchorMode" @bind:after="RefreshDrawPathPreview">
                                    <option value="centre">Mesh centre follows path</option><option value="origin">Body origin follows path</option>
                                </select>
                                <button class="btn btn-sm btn-success" aria-label="Preview path" title="Play the route without modifying or converting the item." @onclick="PreviewDrawPath">Preview path</button>
                                <button class="btn btn-sm btn-outline-secondary" aria-label="Stop path preview" title="Stop the draft animation and restore the item's own motion." @onclick="StopDrawPathPreview">Stop preview</button>
                                <button class="btn btn-sm btn-outline-secondary" aria-label="Fit path in view" title="Frame the entire drawn route and moving mesh." @onclick="FitDrawPath">Fit path</button>
                            </div>
                            <small class="d-block text-muted mb-2">While drawing, drag an orange point to move it. Preview updates when a point or setting changes. The draft does not change the exported item until Apply path.</small>
                            <label class="form-label small" for="pathCoordinates">Points: one X Y Z per line (metres, decimal point)</label>
                            <textarea id="pathCoordinates" aria-label="Path coordinates" title="Enter one X Y Z position per line, then choose Use coordinates." class="form-control form-control-sm font-monospace" rows="4" @bind="drawPathCoordinates" placeholder="X Y Z (one point per line)"></textarea>
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ApplyPathCoordinates" aria-label="Use coordinates" title="Validate coordinates and replace the drawn points.">Use coordinates</button>
                                <button class="btn btn-sm btn-primary" @onclick="ConvertDrawnPathToMotion" aria-label="Apply path" title="Compile the route into native item movement." disabled="@compositeViewportMode">Apply path</button>
                                @if (drawPathOriginal is not null) { <button class="btn btn-sm btn-outline-secondary" @onclick="RestoreMotionBeforePath" aria-label="Restore previous motion" title="Restore the item from before this session's generated path.">Restore previous motion</button> }
                            </div>
                            <small class="text-muted mt-1">Apply replaces the previous generated path. Manual coordinates need “Use coordinates” first. Combined-file view is not editable here.</small>
                            @if (!string.IsNullOrWhiteSpace(drawPathStatusMessage)) { <div class="small text-info mt-2">@drawPathStatusMessage</div> }
                        </details>
                        @if (!isMovingItem)
                        {
                            <p class="small text-muted mb-2">
                                This item is a <strong>static object</strong>. Convert it to a <strong>KinematicObject</strong> to add motion.
                                A collision surface is derived from supported visual geometry. Verify moving-body contact in the native game before relying on it.
                            </p>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <button class="btn btn-sm btn-primary" @onclick="ConvertStaticItemToKinematic"
                                        title="Creates a moving body and constraint, deriving collision from supported visual geometry. Native motion and vehicle contact require testing.">
                                    ⚙️ Convert to KinematicObject (one-click)
                                </button>
                                <span class="badge text-bg-success">Includes auto-collision</span>
                            </div>

                            <details class="text-muted small mt-2">
                                <summary class="cursor-pointer">Optional: upload custom templates (advanced)</summary>
                                <div class="mt-2">
                                    <label class="form-label mb-1 small fw-bold" data-help-key="movingitemtemplateitemgbx">Moving item template (.Item.Gbx)</label>
                                    <InputFile OnChange="UploadMovingTemplate" accept=".gbx" class="form-control form-control-sm" />
                                    @if (!string.IsNullOrWhiteSpace(movingTemplateStatus))
                                    {
                                        <div class="small text-muted mt-1">@movingTemplateStatus</div>
                                    }
                                </div>
                                <div class="mt-2">
                                    <label class="form-label mb-1 small fw-bold" data-help-key="constrainttemplateconstraintgbx">Constraint template (.Constraint.Gbx)</label>
                                    <InputFile OnChange="UploadConstraintTemplate" accept=".gbx" class="form-control form-control-sm" />
                                    @if (!string.IsNullOrWhiteSpace(constraintTemplateStatus))
                                    {
                                        <div class="small text-muted mt-1">@constraintTemplateStatus</div>
                                    }
                                </div>
                            </details>
                        }
                        else if (authoredConstraints.Count > 0)
                        {
                            <!-- Path & Collision Generator Card -->
                            <div class="card border-primary mb-3 shadow-sm">
                                <div class="card-header bg-primary text-white py-1 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold"><i class="bi bi-bezier2"></i> Motion & Path Assistant (A ➔ B ➔ C)</span>
                                    <span class="badge bg-light text-primary">One-click Generation</span>
                                </div>
                                <div class="card-body p-2 small">
                                    <div class="mb-2">
                                        <label class="form-label fw-bold mb-1" data-help-key="choosemotiontypepreset">Choose motion type / preset</label>
                                        <select class="form-select form-select-sm" aria-label="Motion preset" @bind="pathPresetMode">
                                            <option value="single_axis">Straight motion / lift / door</option>
                                            <option value="rotation">Rotation / spinner</option>
                                            <option value="relay">Two-body relay (both bodies remain present)</option>
                                        </select>
                                        <small class="text-muted">For a drawn polyline use Scenery above. A relay uses two separate bodies; it does not hide or park either body.</small>
                                    </div>

                                    @if (pathPresetMode is "relay")
                                    {
                                        <div class="row g-2 border-top pt-2 mb-2">
                                            <div class="col-12 fw-bold text-secondary">Segment 1 (A ➔ B)</div>
                                            <div class="col-4">
                                                <label class="form-label mb-0" style="font-size: 0.8em;" data-help-key="axis">Axis</label>
                                                <select class="form-select form-select-sm" @bind="pathSegment1Axis">
                                                    <option value="x">X Axis</option>
                                                    <option value="y">Y Axis</option>
                                                    <option value="z">Z Axis</option>
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label mb-0" style="font-size: 0.8em;" data-help-key="distancem">Distance (m)</label>
                                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="pathSegment1Distance" />
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label mb-0" style="font-size: 0.8em;" data-help-key="durationsec">Duration (sec)</label>
                                                <input type="number" step="0.5" min="0.1" class="form-control form-control-sm" @bind="pathSegment1Duration" />
                                            </div>
                                        </div>

                                        <div class="row g-2 border-top pt-2 mb-2">
                                            <div class="col-12 fw-bold text-secondary">Segment 2 (B ➔ C)</div>
                                            <div class="col-4">
                                                <label class="form-label mb-0" style="font-size: 0.8em;" data-help-key="axis">Axis</label>
                                                <select class="form-select form-select-sm" @bind="pathSegment2Axis">
                                                    <option value="x">X Axis</option>
                                                    <option value="y">Y Axis</option>
                                                    <option value="z">Z Axis</option>
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label mb-0" style="font-size: 0.8em;" data-help-key="distancem">Distance (m)</label>
                                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="pathSegment2Distance" />
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label mb-0" style="font-size: 0.8em;" data-help-key="durationsec">Duration (sec)</label>
                                                <input type="number" step="0.5" min="0.1" class="form-control form-control-sm" @bind="pathSegment2Duration" />
                                            </div>
                                        </div>

                                    }
                                    else if (pathPresetMode == "single_axis")
                                    {
                                        <div class="row g-2 border-top pt-2 mb-2">
                                            <div class="col-4">
                                                <label class="form-label mb-0" style="font-size: 0.8em;" data-help-key="axis">Axis</label>
                                                <select class="form-select form-select-sm" @bind="pathSegment1Axis">
                                                    <option value="x">X Axis</option>
                                                    <option value="y">Y Axis</option>
                                                    <option value="z">Z Axis</option>
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label mb-0" style="font-size: 0.8em;" data-help-key="distancem">Distance (m)</label>
                                                <input type="number" step="0.5" class="form-control form-control-sm" @bind="pathSegment1Distance" />
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label mb-0" style="font-size: 0.8em;" data-help-key="durationsec">Duration (sec)</label>
                                                <input type="number" step="0.5" min="0.1" class="form-control form-control-sm" @bind="pathSegment1Duration" />
                                            </div>
                                            <div class="col-12 mt-1">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="singlePingPong" @bind="pathIsPingPong" />
                                                    <label class="form-check-label" for="singlePingPong" data-help-key="singlepingpong">
                                                        @(pathIsPingPong ? "Back-and-forth (Ping-Pong)" : "One-way (Loop)")
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (pathPresetMode == "rotation")
                                    {
                                        <div class="row g-2 border-top pt-2 mb-2">
                                            <div class="col-6">
                                                <label class="form-label mb-0" style="font-size: 0.8em;" data-help-key="rotationaxis">Rotation axis</label>
                                                <select class="form-select form-select-sm" @bind="pathSegment1Axis">
                                                    <option value="y">Y Axis (horizontal spin)</option>
                                                    <option value="x">X Axis (wheel/roll)</option>
                                                    <option value="z">Z Axis (windmill)</option>
                                                </select>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label mb-0" style="font-size: 0.8em;" data-help-key="durationperloopsec">Duration per loop (sec)</label>
                                                <input type="number" step="0.5" min="0.1" class="form-control form-control-sm" @bind="pathSegment1Duration" />
                                            </div>
                                        </div>
                                    }

                                    <button class="btn btn-sm btn-primary w-100 mt-2" @onclick="ApplyPathPreset">
                                        🚀 Generate & apply to item
                                    </button>

                                    @if (!string.IsNullOrWhiteSpace(pathStatusMessage))
                                    {
                                        <div class="alert alert-success py-1 mt-2 mb-0 small">@pathStatusMessage</div>
                                    }

                                    <div class="alert alert-light border mt-2 mb-0 text-muted" style="font-size: 0.8em;">
                                        <strong>💡 Havok collision notes (Trackmania 2020):</strong>
                                        <ul class="mb-0 ps-3">
                                            <li><strong>Root Constraints (<code>Ent1 = -1</code>):</strong> Bind the body directly to the world. Studio validates the serialized layout; vehicle contact still needs a native test.</li>
                                            <li><strong>Chained Constraints (<code>Ent1 &ge; 0</code>):</strong> Follow a parent body. Browser playback does not establish that native child collision follows the same path; compare the exported layout in game.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <p role="status" class="small text-muted mb-2" title="Only explicit edits change the file. A shared constraint affects all its instances.">Detailed constraints & timeline edits</p>
                            @if (!string.IsNullOrWhiteSpace(kinematicTemplateStatus))
                            {
                                <p role="status" class="small text-info">@kinematicTemplateStatus</p>
                            }
                            @foreach (var diagnostic in motionDiagnostics)
                            {
                                <p role="status" class="small text-warning">Preview unavailable: @diagnostic</p>
                            }
                            @for (var i = 0; i < authoredConstraints.Count; i++)
                            {
                                var constraint = authoredConstraints[i];
                                var cIdx = i;
                                <AuthoredMotionEditor @key="constraint" Name="@($"Constraint {i + 1}")" Source="constraint"
                                                      ConstraintIndex="cIdx"
                                                      IsSelected="@(selectedConstraintIndex == cIdx)"
                                                      SelectedWaypointIsPointB="@(selectedConstraintIndex == cIdx ? selectedWaypointIsPointB : (bool?)null)"
                                                      OnSelectConstraint="@(idx => SelectConstraint(idx))"
                                                      OnSelectWaypoint="@(isB => SelectWaypoint(cIdx, isB))"
                                                      IsInvisibleDriver="@IsInvisibleDriverConstraint(constraint)"
                                                      IsVisualPathProxy="@IsVisiblePathProxyConstraint(constraint)"
                                                      IsRootConstraint="@IsRootConstraint(constraint)"
                                                      BindingDescription="@GetBindingDescription(constraint)"
                                                      ConstraintParams="@GetConstraintParameters(constraint)"
                                                      CanRemove="@(authoredConstraints.Count > 1)"
                                                      OnRemoveConstraint="@(c => RemoveConstraint(c))"
                                                      Changed="UpdateScenePayload" />
                                <button class="btn btn-sm btn-outline-warning mb-3" disabled="@(!acknowledgeKinematicTemplate)"
                                        @onclick="@(() => AddKinematicEntity(constraint))">
                                    Add kinematic entity from Constraint @(i + 1)
                                </button>
                                <button class="btn btn-sm btn-outline-primary mb-3 ms-2" disabled="@(!acknowledgeKinematicTemplate)"
                                        title="Adds a complete, visible proxy body before this constraint to test a native parent-child path safely."
                                        @onclick="@(() => InsertVisiblePathProxy(constraint))">
                                    Add visible path proxy before Constraint @(i + 1)
                                </button>
                                <button class="btn btn-sm btn-outline-secondary mb-3 ms-2" disabled="@(!acknowledgeKinematicTemplate)"
                                        title="Adds a mesh-hidden carrier parent before this constraint so one visible body can follow chained segments."
                                        @onclick="@(() => InsertHiddenCarrierParent(constraint))">
                                    Add hidden carrier parent before Constraint @(i + 1)
                                </button>
                            }
                        }
                        else
                        {
                            <p class="small text-muted mb-2">
                                This item is currently <strong>KinematicObject / DynamicalObject</strong>.
                            </p>
                            <button class="btn btn-sm @(showOriginalMotion ? "btn-info" : "btn-outline-info") mb-2" @onclick="ToggleOriginalMotion">
                                @(showOriginalMotion ? "Original motion active" : "Show original motion in viewport")
                            </button>
                            @if (showOriginalMotion)
                            {
                                <div class="card border-info bg-white mb-3">
                                    <div class="card-header py-1 text-info fw-bold">Original engine settings</div>
                                    <div class="card-body p-2">
                                        <div class="small text-muted mb-2">Constraint: @originalConstraintType</div>
                                        @if (originalMotionSettings.Count == 0)
                                        {
                                            <div class="small text-muted">No readable kinematic properties found.</div>
                                        }
                                        else
                                        {
                                            @foreach (var setting in originalMotionSettings)
                                            {
                                                <div class="d-flex justify-content-between gap-2 border-bottom py-1 small">
                                                    <span class="fw-bold">@setting.Name</span>
                                                    <span class="text-break text-end">@setting.Value</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label mb-0 small fw-bold" data-help-key="animationtype">Animation type</label>
                                    <select class="form-select form-select-sm" value="@(isOscillating ? "osc" : "spin")" @onchange="OnAnimTypeChanged">
                                        <option value="spin">Continuous rotation</option>
                                        <option value="osc">PingPong / oscillation</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label mb-0 small fw-bold" data-help-key="rotaxis">RotAxis</label>
                                    <select class="form-select form-select-sm" aria-label="Legacy preview axis" data-help-key="axis" value="@detectedAxis" @onchange="OnAxisChanged">
                                        <option value="y">Y Axis</option>
                                        <option value="x">X Axis</option>
                                        <option value="z">Z Axis</option>
                                    </select>
                                </div>
                            </div>
                            @if (isOscillating)
                            {
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label mb-0 small" data-help-key="anglemindeg">AngleMinDeg (°)</label>
                                        <input type="number" step="5" class="form-control form-control-sm" @bind="minAngle" @bind:after="OnKinematicChanged" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label mb-0 small" data-help-key="anglemaxdeg">AngleMaxDeg (°)</label>
                                        <input type="number" step="5" class="form-control form-control-sm" @bind="maxAngle" @bind:after="OnKinematicChanged" />
                                    </div>
                                </div>
                            }
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label mb-0 small" data-help-key="perioddurationsec">Period / Duration (sec)</label>
                                    <input type="number" min="0.01" step="0.05" class="form-control form-control-sm" @bind="animationPeriodSeconds" @bind:after="OnKinematicChanged" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label mb-0 small" data-help-key="phaseoffsetsec">Phase offset (sec)</label>
                                    <input type="number" step="0.05" class="form-control form-control-sm" @bind="animationPhaseSeconds" @bind:after="OnKinematicChanged" />
                                </div>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label mb-0 small" data-help-key="transaxis">TransAxis</label>
                                    <select class="form-select form-select-sm" @bind="translationAxis" @bind:after="OnKinematicChanged">
                                        <option value="x">X Axis</option>
                                        <option value="y">Y Axis</option>
                                        <option value="z">Z Axis</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label mb-0 small" data-help-key="translationdistancem">Translation distance (m)</label>
                                    <input type="number" step="0.05" class="form-control form-control-sm" @bind="translationDistance" @bind:after="OnKinematicChanged" />
                                </div>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="harmonicMotion" @bind="harmonicEasing" @bind:after="OnKinematicChanged" />
                                <label class="form-check-label small" for="harmonicMotion" data-help-key="harmoniceasing">Harmonic easing</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="invertMotion" @bind="invertMotion" @bind:after="OnKinematicChanged" />
                                <label class="form-check-label small" for="invertMotion" data-help-key="invertdirection">Invert direction</label>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-4">
                                    <label class="form-label mb-0 small" data-help-key="pivotoffsetx">Pivot offset X</label>
                                    <input type="number" step="0.05" class="form-control form-control-sm" @bind="pivotOffsetX" @bind:after="OnKinematicChanged" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label mb-0 small" data-help-key="pivotoffsety">Pivot offset Y</label>
                                    <input type="number" step="0.05" class="form-control form-control-sm" @bind="pivotOffsetY" @bind:after="OnKinematicChanged" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label mb-0 small" data-help-key="pivotoffsetz">Pivot offset Z</label>
                                    <input type="number" step="0.05" class="form-control form-control-sm" @bind="pivotOffsetZ" @bind:after="OnKinematicChanged" />
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary mt-2" disabled aria-disabled="true"
                                    title="Conversion is unsupported: removing the dynamic object/constraint graph is not implemented.">
                                ⏹ Convert to StaticObject (unsupported)
                            </button>
                            <p class="small text-muted mt-2 mb-0">
                                Removing the dynamic graph is not supported; export keeps the item's kinematic data unchanged.
                            </p>
                        }
                    </div>
                }

                @if (activeTab == "lights")
                {
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                            <h6 class="mb-0 text-primary">Lights (@detectedLights.Count) <span class="text-muted" title="Color, intensity and radius are written to each existing CPlugLightUserModel on export. Light position is not serialized by this editor.">?</span></h6>
                        <span class="small text-muted">Existing serialized lights only</span>
                    </div>
                    <p class="small text-muted">
                        Color, intensity and radius are saved to the light's own GBX data on export.
                        Position is owned by skeleton socket data the bundled GBX.NET parser does not expose, so it is read-only here.
                        This editor cannot add or remove lights.
                    </p>

                    @if (detectedLights.Count > 0)
                    {
                        @for (int i = 0; i < detectedLights.Count; i++)
                        {
                            var light = detectedLights[i];
                            int lIdx = i;
                            <div class="card p-2 mb-2 bg-light small">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong>Light @(lIdx + 1) (@light.Type)</strong>
                                    <button class="btn btn-xs btn-outline-secondary" style="font-size:0.7em;" @onclick="@(() => SelectGizmoIn3D("light", lIdx))">
                                        Select in 3D
                                    </button>
                                </div>

                                <div class="row g-1 mb-1">
                                    <div class="col-4">
                                        <label class="form-label mb-0" style="font-size: 0.75em;" data-help-key="readonlyposition">X (read-only)</label>
                                        <input type="number" step="0.2" class="form-control form-control-sm" value="@light.X.ToString(CultureInfo.InvariantCulture)" readonly aria-readonly="true" aria-label="@($"Light {lIdx + 1} X (read-only)")" title="Light position is not serialized by this editor." />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label mb-0" style="font-size: 0.75em;" data-help-key="readonlyposition">Y (read-only)</label>
                                        <input type="number" step="0.2" class="form-control form-control-sm" value="@light.Y.ToString(CultureInfo.InvariantCulture)" readonly aria-readonly="true" aria-label="@($"Light {lIdx + 1} Y (read-only)")" title="Light position is not serialized by this editor." />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label mb-0" style="font-size: 0.75em;" data-help-key="readonlyposition">Z (read-only)</label>
                                        <input type="number" step="0.2" class="form-control form-control-sm" value="@light.Z.ToString(CultureInfo.InvariantCulture)" readonly aria-readonly="true" aria-label="@($"Light {lIdx + 1} Z (read-only)")" title="Light position is not serialized by this editor." />
                                    </div>
                                </div>

                                <div class="row g-1 align-items-center">
                                    <div class="col-4">
                                        <label class="form-label mb-0" style="font-size: 0.75em;" data-help-key="color">Color</label>
                                        <input type="color" class="form-control form-control-color w-100 p-0" style="height: 28px;" aria-label="@($"Light {lIdx + 1} color")" @bind="light.ColorHtml" @bind:after="@(() => OnLightColorChanged(lIdx))" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label mb-0" style="font-size: 0.75em;" data-help-key="intensity">Intensity</label>
                                        <input type="number" step="0.5" class="form-control form-control-sm" aria-label="@($"Light {lIdx + 1} intensity")" @bind="light.Intensity" @bind:after="@(() => OnLightChanged(lIdx))" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label mb-0" style="font-size: 0.75em;" data-help-key="radiusm">Radius (m)</label>
                                        <input type="number" step="1.0" class="form-control form-control-sm" aria-label="@($"Light {lIdx + 1} radius")" @bind="light.Radius" @bind:after="@(() => OnLightChanged(lIdx))" />
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small">No light emitters found. Adding lights is not supported by this editor.</p>
                    }
                }

                @if (activeTab == "sockets")
                {
                    <h6 class="border-bottom pb-1 text-primary">Sockets</h6>
                    <div class="alert alert-secondary small">
                        <strong>Socket authoring is not supported.</strong>
                        Item sockets are owned by skeleton data inside the model; the bundled GBX.NET parser does not
                        expose them (<code>DefaultPlacement.Sockets</code> does not exist in this build), so socket
                        positions and tags cannot be listed, added, removed or moved here.
                    </div>
                    <p class="small text-muted mb-0">
                        This panel is a read-only capability note. Author sockets with an external item-authoring tool.
                        Nothing in this editor claims to change socket behavior in the game.
                    </p>
                }

                @if (activeTab == "physics")
                {
                    <h6 class="border-bottom pb-1 text-primary">PhyModel, CPlugSurface & Collision <span class="text-muted" title="These nodes define collision, physics surfaces and vehicle interaction.">?</span></h6>
                    <div class="alert @(CollisionInventory.Count > 0 ? "alert-success" : "alert-secondary") small">
                        @(CollisionInventory.Count > 0
                            ? $"Collision inventory: {CollisionInventory.Count} entr{(CollisionInventory.Count == 1 ? "y" : "ies")} found in this item."
                            : "No collision entries were found in this item.")
                    </div>
                    @if (CollisionInventory.Count > 0)
                    {
                        <div class="list-group small mb-2">
                            @foreach (var collision in CollisionInventory)
                            {
                                <div class="list-group-item">
                                    <strong>@collision.Representation</strong>
                                    <span class="badge bg-secondary ms-1">@collision.State</span>
                                    <div class="text-muted text-break">@collision.Path</div>
                                </div>
                            }
                        </div>
                    }
                    <p class="small text-muted mb-0">
                        Read-only diagnostic. Enabling or disabling collision is not supported: that would require
                        authoring or removing native collision shapes, which this editor does not do. No claim is made
                        about how the game treats these entries.
                    </p>
                }

                @if (activeTab == "visual")
                {
                    <h6 class="border-bottom pb-1 text-primary">VisModel, Materials & LOD <span class="text-muted" title="Visual geometry, materials, UV data and LOD nodes belong to the visual model.">?</span></h6>
                    <div class="row g-2 mb-2">
                        <div class="col-6"><div class="card bg-light p-2 small"><strong>Visual geometry</strong><br />@vertexCount vertices</div></div>
                        <div class="col-6"><div class="card bg-light p-2 small"><strong>LOD</strong><br />@(HasNode("LOD", "Lod") ? "Present" : "Not found")</div></div>
                    </div>
                    <div class="card mb-2">
                        <div class="card-header py-1 fw-bold">Mesh configuration (@modelParts.Count)</div>
                        <div class="card-body p-2">
                            @if (modelParts.Count == 0)
                            {
                                <p class="small text-muted mb-0">No mesh parts found.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0 mesh-config-table">
                                        <thead>
                                        <tr>
                                            <th class="mesh-col-part">Part</th>
                                            <th>Type</th>
                                            <th class="text-end">Verts</th>
                                            <th class="text-end">Tris</th>
                                            <th class="text-center">En</th>
                                            <th class="text-center">Vis</th>
                                            <th class="text-center">Col</th>
                                            <th class="text-center">Eff</th>
                                            <th class="text-center">Way</th>
                                            <th class="text-center">Mov</th>
                                            <th class="mesh-col-materials">Materials</th>
                                            <th style="min-width: 160px;">Motion</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var part in modelParts)
                                        {
                                            var selected = selectedMeshPartPath == part.Path;
                                            var cfg = GetMeshPartConfig(part.Path);
                                            <tr class="@(selected ? "table-primary" : "")"
                                                style="cursor:pointer"
                                                @onclick="@(() => SelectMeshPart(part.Path))">
                                                <td>
                                                    <div class="fw-semibold">@part.Name</div>
                                                    <div class="text-muted small text-break">@part.Path</div>
                                                </td>
                                                <td class="small">Mesh</td>
                                                <td class="text-end">@part.VertexCount</td>
                                                <td class="text-end">@part.TriangleCount</td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" aria-label="@($"Enabled preview for {part.Path}")" data-help-key="meshenabled" @bind="cfg.Enabled" @bind:after="() => OnMeshPartFlagChanged(part.Path)" @onclick:stopPropagation="true" />
                                                </td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" aria-label="@($"Visible preview for {part.Path}")" data-help-key="meshvisible" @bind="cfg.Visible" @bind:after="() => OnMeshPartFlagChanged(part.Path)" @onclick:stopPropagation="true" />
                                                </td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" aria-label="@($"Collidable preview for {part.Path}")" data-help-key="meshcollidable" @bind="cfg.Collidable" @bind:after="() => OnMeshPartFlagChanged(part.Path)" @onclick:stopPropagation="true" />
                                                </td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" aria-label="@($"Effect preview for {part.Path}")" data-help-key="mesheffect" @bind="cfg.Effect" @bind:after="() => OnMeshPartFlagChanged(part.Path)" @onclick:stopPropagation="true" />
                                                </td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" aria-label="@($"Waypoint preview for {part.Path}")" data-help-key="meshwaypoint" @bind="cfg.Waypoint" @bind:after="() => OnMeshPartFlagChanged(part.Path)" @onclick:stopPropagation="true" />
                                                </td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" aria-label="@($"Movable preview for {part.Path}")" data-help-key="meshmovable" @bind="cfg.Movable" @bind:after="() => OnMeshPartFlagChanged(part.Path)" @onclick:stopPropagation="true" />
                                                </td>
                                                <td class="small">@part.MaterialSummary</td>
                                                <td>
                                                    <select class="form-select form-select-sm"
                                                            aria-label="@($"Motion mode for {part.Path}")" data-help-key="meshmotion" value="@GetMeshPartMode(part.Path)"
                                                            @onclick:stopPropagation="true"
                                                            @onchange="@(e => OnMeshPartModeChanged(part.Path, e))">
                                                        <option value="auto">Auto</option>
                                                        <option value="static">Static</option>
                                                        <option value="kinematic">Kinematic</option>
                                                    </select>
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                                @if (selectedMeshPartPath is not null)
                                {
                                    var selectedPart = modelParts.FirstOrDefault(part => part.Path == selectedMeshPartPath);
                                    if (selectedPart is not null)
                                    {
                                        var selectedCfg = GetMeshPartConfig(selectedPart.Path);
                                        <div class="alert alert-info py-2 mt-2 mb-0 small mesh-selection-summary">
                                            <div class="fw-bold mb-1">Selected part</div>
                                            <div class="mb-1"><code>@selectedPart.Name</code></div>
                                            <div class="mb-1 text-break">@selectedPart.Path</div>
                                            <div><strong>Function:</strong> @DescribeMeshFunction(selectedPart, selectedCfg)</div>
                                        </div>
                                    }
                                }
                                <p class="small text-muted mb-0 mt-2">Click in the list or viewport to select a part. En/Vis/Col/Eff/Way/Mov update the preview immediately. Motion also affects export when it maps unambiguously per entity; mixed modes within one entity stay read-only.</p>
                            }
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <strong class="small d-block">Authored materials (@detectedMaterials.Count)</strong>
                            @if (!string.IsNullOrWhiteSpace(materialLibraryStatus))
                            {
                                <small class="text-muted">@materialLibraryStatus</small>
                            }
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="SelectTextureDirectory">Choose local texture folder</button>
                    </div>
                    <label for="texture-folder-upload" class="btn btn-sm btn-outline-secondary mb-2" data-help-key="loadtexturefolder">Load texture folder</label>
                    <InputFile id="texture-folder-upload" OnChange="LoadTextureFolder" multiple webkitdirectory directory class="visually-hidden" />
                    <p class="small text-muted mb-2">For the complete game library, choose <code>C:\Users\PC\Documents\Trackmania\Items\_BlenderAssets\Trackmania2020_Textures</code>. This curated folder contains only textures referenced by extracted <code>*.Material.Gbx</code> files and uses its manifest for exact full-link matching.</p>
                    @if (!string.IsNullOrEmpty(textureDirectoryStatus))
                    {
                        <p class="small text-muted">@textureDirectoryStatus</p>
                    }
                    @if (detectedMaterials.Count > 0)
                    {
                        <div class="list-group small mb-2">
                            @foreach (var material in detectedMaterials)
                            {
                                <div class="list-group-item material-slot-editor">
                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                                        <strong>Slot @material.Index:</strong>
                                        <span class="text-muted text-break small">@(material.GameMaterialName ?? material.Name ?? "Unnamed material")</span>
                                    </div>
                                    <div class="text-muted text-break small mb-1">@material.Path</div>
                                    <label class="small text-muted d-block" for="@MaterialEditorId(material.Path)" data-help-key="fullmateriallink">Full material link</label>
                                    <input id="@MaterialEditorId(material.Path)" class="form-control form-control-sm mb-1"
                                           disabled="@(SelectedSource?.IsReadOnly == true || !CanEditMaterial(material))" value="@MaterialLinkValue(material)"
                                           @onchange="@(e => OnMaterialLinkChanged(material.Path, e))" />
                                    <SearchableSelect @key="material.Path" Disabled="@(SelectedSource?.IsReadOnly == true || !CanEditMaterial(material))"
                                        Value="@MaterialLinkValue(material)" Options="@MaterialOptionsFor(material)"
                                        Label="@($"Game material for {material.Path}")" Placeholder="Choose a material from the game library"
                                        ValueChanged="@(e => OnMaterialLinkChanged(material.Path, e))" />
                                </div>
                            }
                        </div>
                        <p class="small text-muted">Texture indexing and preview are local and read-only. Studio maps Trackmania PBR sets by native material link: <code>_D</code> base color, <code>_N</code> normal, <code>_R</code> roughness/metallic, <code>_I</code> self-illumination, <code>_H</code> height, <code>_L</code> light and <code>_T</code> glass color. It also indexes auxiliary <code>_O</code>, <code>_M</code>, <code>_X2</code> and hue-mask maps. Texture preview does not modify UV, collision, or export data; the full-link editor above is the separate authored-material export edit.</p>
                    }
                    else
                    {
                        <p class="small text-muted">No authored material slots were found.</p>
                    }
                }

                @if (activeTab == "composite" && CanCombineFiles)
                {
                    <h6 class="border-bottom pb-1 text-primary">Composite world transforms & group motion <span class="text-muted" title="Configure world offsets, grouping and group motion for merged multi-item exports.">?</span></h6>
                    <div class="d-flex align-items-center gap-2 fw-semibold small mb-2 flex-wrap">
                        <span>Merged source world transforms</span>
                        <button class="btn btn-xs @(compositeTransformMode == "translate" ? "btn-primary" : "btn-outline-secondary")"
                                style="font-size:0.7em;" @onclick="@(() => SetCompositeTransformMode("translate"))">Move</button>
                        <button class="btn btn-xs @(compositeTransformMode == "rotate" ? "btn-primary" : "btn-outline-secondary")"
                                style="font-size:0.7em;" @onclick="@(() => SetCompositeTransformMode("rotate"))">Rotate</button>
                        <button class="btn btn-xs btn-outline-success" style="font-size:0.7em;"
                                disabled="@(compositeSelectionOrder.Count < 2)" @onclick="ConnectCompositePivotSelection">Connect pivots</button>
                        <button class="btn btn-xs btn-outline-info" style="font-size:0.7em;"
                                disabled="@(compositeSelectionOrder.Count < 2)" @onclick="CreateCompositeGroupFromSelection">Create group</button>
                        <button class="btn btn-xs btn-outline-warning" style="font-size:0.7em;"
                                disabled="@(compositeSelectionOrder.Count == 0)" @onclick="UngroupCompositeSelection">Ungroup selection</button>
                        <button class="btn btn-xs btn-outline-secondary" style="font-size:0.7em;"
                                disabled="@(compositeSelectionOrder.Count == 0)" @onclick="ClearCompositePivotSelection">Clear selection</button>
                    </div>
                    <small class="text-muted d-block mb-2">Select item(s) here or in the viewport. First click sets leader. Ctrl/Shift click adds followers.</small>
                    <div class="studio-composite-selector-grid mb-2">
                        @foreach (var part in CompositeViewportSources())
                        {
                            var selected = compositeSelectionOrder.Contains(part.SourceIndex);
                            var isLeader = compositeSelectionOrder.Count > 0 && compositeSelectionOrder[0] == part.SourceIndex;
                            var hasGroup = compositeGroupBySourceIndex.TryGetValue(part.SourceIndex, out var sourceGroupId);
                            var sourceGroupColor = hasGroup ? CompositeGroupColor(sourceGroupId) : "#6b7280";
                            <button class="btn btn-sm text-start @(selected ? "btn-primary" : "btn-outline-secondary")"
                                    title="@part.Source.Name"
                                    @onclick="@(e => SelectCompositeSourceFromSettings(part.SourceIndex, e))">
                                <span class="text-truncate">@part.Source.Name</span>
                                @if (isLeader)
                                {
                                    <span class="badge rounded-pill text-bg-light text-dark ms-1">Leader</span>
                                }
                                @if (hasGroup)
                                {
                                    <span class="badge rounded-pill studio-group-badge ms-1" style="@($"--group-color:{sourceGroupColor}")">G@(sourceGroupId + 1)</span>
                                }
                            </button>
                        }
                    </div>
                    @foreach (var part in CompositeViewportSources())
                    {
                        var offset = GetCompositeWorldOffset(part.SourceIndex);
                        var selected = compositeSelectionOrder.Contains(part.SourceIndex);
                        var isLeader = compositeSelectionOrder.Count > 0 && compositeSelectionOrder[0] == part.SourceIndex;
                        var hasGroup = compositeGroupBySourceIndex.TryGetValue(part.SourceIndex, out var sourceGroupId);
                        var sourceGroupColor = hasGroup ? CompositeGroupColor(sourceGroupId) : "#6b7280";
                        <div class="d-flex align-items-center flex-wrap gap-2 mt-1 small studio-transform-row @(selected ? "studio-transform-row-selected" : "") @(isLeader ? "studio-transform-row-leader" : "")">
                            <span style="min-width: 190px;" class="text-truncate @(selected ? "fw-semibold text-info" : "")">@part.Source.Name</span>
                            @if (isLeader)
                            {
                                <span class="badge rounded-pill text-bg-primary">Leader</span>
                            }
                            @if (selected && !isLeader)
                            {
                                <span class="badge rounded-pill text-bg-info text-dark">Selected</span>
                            }
                            @if (hasGroup)
                            {
                                <span class="badge rounded-pill studio-group-badge" style="@($"--group-color:{sourceGroupColor}")">Group @(sourceGroupId + 1)</span>
                            }
                            <button class="btn btn-xs btn-outline-secondary" style="font-size:0.7em;" title="Select world offset gizmo in viewport"
                                    @onclick="@(() => SelectCompositeOffsetGizmo(part.SourceIndex))">🎯</button>
                            <label class="mb-0" data-help-key="x">X</label>
                            <input type="number" class="form-control form-control-sm studio-transform-input" step="0.1"
                                   aria-label="@($"offset X {part.SourceIndex}")" @bind="offset.X" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                            <label class="mb-0" data-help-key="y">Y</label>
                            <input type="number" class="form-control form-control-sm studio-transform-input" step="0.1"
                                   aria-label="@($"offset Y {part.SourceIndex}")" @bind="offset.Y" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                            <label class="mb-0" data-help-key="z">Z</label>
                            <input type="number" class="form-control form-control-sm studio-transform-input" step="0.1"
                                   aria-label="@($"offset Z {part.SourceIndex}")" @bind="offset.Z" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                            <label class="mb-0" data-help-key="rx">RX</label>
                            <input type="number" class="form-control form-control-sm studio-transform-input" step="1"
                                   aria-label="@($"offset RotX {part.SourceIndex}")" @bind="offset.RotX" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                            <label class="mb-0" data-help-key="ry">RY</label>
                            <input type="number" class="form-control form-control-sm studio-transform-input" step="1"
                                   aria-label="@($"offset RotY {part.SourceIndex}")" @bind="offset.RotY" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                            <label class="mb-0" data-help-key="rz">RZ</label>
                            <input type="number" class="form-control form-control-sm studio-transform-input" step="1"
                                   aria-label="@($"offset RotZ {part.SourceIndex}")" @bind="offset.RotZ" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                        </div>
                    }
                    @if (compositeGroupTransforms.Count > 0)
                    {
                        <div class="fw-semibold small mt-2">Group transforms</div>
                        @foreach (var group in CompositeGroups())
                        {
                            var transform = group.Transform;
                            var motion = GetCompositeGroupMotion(group.GroupId);
                            var groupColor = CompositeGroupColor(group.GroupId);
