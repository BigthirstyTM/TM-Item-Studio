    private bool HasNode(params string[] names)
    {
        if (detectedNodeTypes.Any(found => names.Any(name => found.Contains(name, StringComparison.OrdinalIgnoreCase))))
            return true;
        return names.Any(name => name.Contains("particle", StringComparison.OrdinalIgnoreCase)
                || name.Contains("cplugfx", StringComparison.OrdinalIgnoreCase))
            && EffectReferences().Any(effect => effect.Kind is "CPlugFxSystem" or "ParticleModel");
    }

    private async Task UploadIcon(InputFileChangeEventArgs e)
    {
        if (itemModel == null || e.File == null) return;

        var extension = Path.GetExtension(e.File.Name).ToLowerInvariant();
        if (extension is not ".jpg" and not ".jpeg" and not ".png" and not ".webp")
        {
            iconStatus = "Use a JPG, PNG or WebP image.";
            return;
        }

        if (e.File.Size > 2 * 1024 * 1024)
        {
            iconStatus = "The icon must be no larger than 2 MB.";
            return;
        }

        var target = itemModel;
        try
        {
            using var stream = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024).CopyToAsync(stream);
            var normalized = await JS.InvokeAsync<NormalizedIcon>("normalizeIcon", stream.ToArray(), 64);
            var webp = Convert.FromBase64String(normalized.WebPBase64);
            if (!ReferenceEquals(target, itemModel)) return;
            ItemIcon.Replace(target, normalized.Pixels, 64, 64, webp);
            iconFileName = e.File.Name;
            iconStatus = "Icon normalized to 64x64 and stored in the item model.";
            iconPreviewPending = true;
        }
        catch (Exception)
        {
            if (ReferenceEquals(target, itemModel))
                iconStatus = "Could not decode this image. Choose a valid JPG, PNG or WebP; the previous icon is unchanged.";
        }
    }

    private async Task<bool> RenderIconPreview()
    {
        var target = itemModel;
        string result;
        try
        {
            // The serialized WebP is authoritative when both representations exist.
            if (target?.IconWebP is { Length: > 0 } webp)
                result = await JS.InvokeAsync<string>("renderIconPreviewFromBytes", "iconPreviewCanvas", webp);
            else if (target?.Icon is { } icon)
            {
                var raw = ItemIcon.ReadRaw(icon);
                result = await JS.InvokeAsync<string>("renderIconPreview", "iconPreviewCanvas", raw.Pixels, raw.Width, raw.Height);
            }
            else result = await JS.InvokeAsync<string>("clearIconPreview", "iconPreviewCanvas");
        }
        catch (Exception)
        {
            await JS.InvokeVoidAsync("clearIconPreview", "iconPreviewCanvas");
            result = "decode-failed";
        }
        if (!ReferenceEquals(target, itemModel) || result == "superseded") return true;
        var message = result switch
        {
            "missing" => target?.IconFid is not null
                ? "This item references an external bitmap icon; no embedded preview is available. Drop an image to replace it."
                : "No stored icon. The game may generate one automatically; drop an image to supply one.",
            "decode-failed" => "The stored icon could not be decoded. Drop a JPG, PNG or WebP to replace it.",
            "transparent" => "The stored icon is fully transparent.",
            "black" => "The stored icon contains only black visible pixels.",
            _ => null
        };
        if (message != iconPreviewStatus)
        {
            iconPreviewStatus = message;
            StateHasChanged();
        }
        return result != "pending";
    }

