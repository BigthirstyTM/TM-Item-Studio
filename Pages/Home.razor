    private void UpdateIdent()
    {
        if (itemModel is null) return;
        // ToString resolves numeric collection IDs to display names. Preserve the
        // original typed value unless the user deliberately changes this field.
        var collection = itemModel.Ident?.Collection ?? Id.Empty;
        if (identCollection != collection.ToString())
        {
            // The upper two bits are reserved for GBX lookback markers.
            collection = int.TryParse(identCollection, NumberStyles.None, CultureInfo.InvariantCulture, out var number)
                && number < 0x40000000
                ? new Id(number)
                : new Id(identCollection);
        }
        itemModel.Ident = new Ident(identId, collection, identAuthor);
    }

