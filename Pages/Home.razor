    private async Task PreviewDrawPath()
    {
        if (itemModel is null || compositeViewportMode) return;
        var points = await JS.InvokeAsync<DrawPathPointDto[]>("getDrawnPathPoints");
        var planned = ItemMotionPath.Plan(points.Select(p => new Vector3(p.X,p.Y,p.Z)).ToArray(), drawPathUse, drawPathRepeat,
            drawPathMetersPerSecond, drawPathEase, drawPathPauseMs);
        if (!planned.Success) { await StopDrawPathPreview(); errorMessage = planned.Reason; return; }
        var plan = planned.Value!;
        await JS.InvokeVoidAsync("previewDrawPath", new {
            start = new { x=plan.Start.X, y=plan.Start.Y, z=plan.Start.Z },
            legs = plan.Legs.Select(l => new { delta = new { x=l.Delta.X,y=l.Delta.Y,z=l.Delta.Z }, l.StartMs,l.MoveMs }),
            plan.DurationMs, ease=(int)plan.Ease, obstacle=plan.Use == MotionPathUse.Obstacle
        }, drawPathAnchorMode == "centre");
        drawPathPreviewActive = true;
        errorMessage = null;
        drawPathStatusMessage = $"Draft preview: {plan.Legs.Count} legs, {plan.DurationMs/1000d:0.###} s. Item unchanged until Apply path.";
    }
    private async Task ConvertDrawnPathToMotion()
    {
        if (itemModel is null || compositeViewportMode) return;
        var points = await JS.InvokeAsync<DrawPathPointDto[]>("getDrawnPathPoints");
        var planned = ItemMotionPath.Plan(points.Select(p => new Vector3(p.X,p.Y,p.Z)).ToArray(), drawPathUse, drawPathRepeat,
            drawPathMetersPerSecond, drawPathEase, drawPathPauseMs);
        if (!planned.Success) { errorMessage = planned.Reason; return; }
        // Prepare conversion without installing it. All validation completes before the live item changes.
        CPlugPrefab? candidate = itemModel.EntityModel as CPlugPrefab;
        if (ReferenceEquals(candidate, drawPathGenerated) && drawPathOriginal is not null) candidate = drawPathOriginal;
        if (candidate is null || !isMovingItem)
        {
            var converted = ItemKinematicEntityTemplate.ConvertStaticToKinematic(itemModel,
                uploadedMovingTemplate ?? FindMovingTemplateVariant() ?? ItemKinematicEntityTemplate.GetDefaultMovingTemplate(), uploadedConstraintTemplate);
            if (!converted.Success) { errorMessage = converted.Reason; return; }
            candidate = converted.Value!.EntityModel as CPlugPrefab;
        }
        if (candidate is null) { errorMessage = "This item does not expose a supported root prefab."; return; }
        var anchor = await JS.InvokeAsync<DrawPathPointDto>("getDrawPathAnchor", drawPathAnchorMode == "centre");
        var built = ItemMotionPath.Build(candidate, planned.Value!, new Vector3(anchor.X,anchor.Y,anchor.Z));
        if (!built.Success) { errorMessage = built.Reason; return; }
        await StopDrawPathPreview();
        if (!ReferenceEquals(itemModel.EntityModel, drawPathGenerated)) drawPathBefore = itemModel.EntityModel;
        drawPathOriginal = candidate;
        drawPathGenerated = built.Value;
        itemModel.EntityModel = built.Value;
        drawPathCaptureEnabled = false;
        await UpdateDrawPlane();
        drawPathStatusMessage = $"Applied {planned.Value!.Legs.Count} leg(s), {planned.Value.DurationMs / 1000d:0.###} s per cycle. "
            + (drawPathUse == MotionPathUse.Scenery ? "Scenery: moving body collision removed; static parts preserved." : "Obstacle: model X axis aligned to path.")
            + (drawPathRepeat == MotionPathRepeat.Reset ? " Jumps back to the start each cycle." : "");
        await RefreshPathMotion();
    }
    private async Task RestoreMotionBeforePath()
