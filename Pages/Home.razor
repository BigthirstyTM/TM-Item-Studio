    private async Task OnLightChanged(int idx)
    {
        if (idx >= 0 && idx < detectedLights.Count)
        {
            var l = detectedLights[idx];
            SyncLightsToGbx(idx);
            await JS.InvokeVoidAsync("updateLightRealtime", idx, l.ColorHex, l.Intensity, l.Radius, l.X, l.Y, l.Z);
        }
    }

    private async Task OnLightColorChanged(int idx)
    {
        if (idx >= 0 && idx < detectedLights.Count)
        {
            var l = detectedLights[idx];
            if (l.ColorHtml.StartsWith("#") && l.ColorHtml.Length == 7)
            {
                l.ColorHex = int.Parse(l.ColorHtml.Substring(1), NumberStyles.HexNumber);
                SyncLightsToGbx(idx);
                await JS.InvokeVoidAsync("updateLightRealtime", idx, l.ColorHex, l.Intensity, l.Radius);
            }
        }
    }

