                                       aria-label="@($"transform PivotZ {group.GroupId}")" @bind="transform.PivotZ" @bind:event="oninput" @bind:after="OnCompositeWorldOffsetChanged" />
                            </div>
                            <div class="motion-constraint mt-2 mb-2">
                                <div class="d-flex align-items-center justify-content-between mb-2">
