    private List<Vector3> BuildDrawPolyline(IReadOnlyList<Vector3> drawnPoints)
    {
        if (drawnPoints.Count < 2)
            return [.. drawnPoints];

        var detail = Math.Clamp(drawPathDetail, 1, 16);
        var points = drawnPoints.ToList();
        if (drawPathClosedLoop && Vector3.Distance(points[0], points[^1]) > 0.01f)
            points.Add(points[0]);

        if (detail <= 1)
            return points;

        var expanded = new List<Vector3>(points.Count * detail);
        for (var i = 0; i < points.Count - 1; i++)
        {
            var start = points[i];
            var end = points[i + 1];
            expanded.Add(start);
            for (var step = 1; step < detail; step++)
            {
                var t = step / (float)detail;
                expanded.Add(Vector3.Lerp(start, end, t));
            }
        }
        expanded.Add(points[^1]);
        return expanded;
    }

    private static float ComputeYawDeg(Vector3 horizontalDirection)
    {
        return MathF.Atan2(horizontalDirection.Z, horizontalDirection.X) * (180f / MathF.PI);
    }

    private List<DrawPathSegment> BuildDrawPathSegments(IReadOnlyList<Vector3> polyline)
    {
        var speed = Math.Max(0.1f, drawPathMetersPerSecond);
        var minHorizontal = 0.01f;
        var raw = new List<DrawPathSegment>();
        for (var i = 1; i < polyline.Count; i++)
        {
            var delta = polyline[i] - polyline[i - 1];
            var horizontalLength = MathF.Sqrt(delta.X * delta.X + delta.Z * delta.Z);
            if (horizontalLength < minHorizontal) continue;
            var yaw = ComputeYawDeg(new Vector3(delta.X, 0f, delta.Z));
            var duration = Math.Max(80, (int)MathF.Round(horizontalLength / speed * 1000f));
            raw.Add(new DrawPathSegment(KC.EAxis.X, horizontalLength, duration, yaw, yaw));
        }

        var maxSegments = Math.Clamp(drawPathMaxSegments, 2, ItemKinematicEntityTemplate.MaxSafeDrawPathSegments);
        if (raw.Count > maxSegments)
            throw new InvalidOperationException($"The drawn polyline produced {raw.Count} line segments. Reduce points to {maxSegments} or fewer. This path mode is only stable up to {maxSegments} chained segments in Trackmania.");
        return raw;
    }

    private async Task ConvertDrawnPathToMotion()
    {
        var points = await JS.InvokeAsync<DrawPathPointDto[]>("getDrawnPathPoints");
        if (points.Length < 2)
        {
            errorMessage = "Draw at least two points in the viewport before converting the path.";
            return;
        }

        var control = points.Select(static point => new Vector3(point.X, point.Y, point.Z)).ToList();
        var sampled = BuildDrawPolyline(control);
        List<DrawPathSegment> segments;
        try
        {
            segments = BuildDrawPathSegments(sampled);
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            return;
        }
        if (segments.Count == 0)
        {
            errorMessage = "The drawn path is too small; increase path size or detail and try again.";
            return;
        }

        if (!isMovingItem)
            await ConvertStaticItemToKinematic();

        if (!isMovingItem || authoredConstraints.Count == 0 || authoredMotionScene is null)
        {
            errorMessage ??= "Could not prepare kinematic constraints for the drawn path conversion.";
            return;
        }

        var firstConstraint = authoredConstraints[0];
        var entry = authoredMotionScene.Handles.Entries.FirstOrDefault(handle => ReferenceEquals(handle.Entry.Model, firstConstraint));
        if (entry is null)
        {
            errorMessage = "Could not find the active constraint entry for path conversion.";
            return;
        }

        var authoredSegments = segments
            .Select(static segment => new ItemKinematicEntityTemplate.DrawPathSegment(
                segment.Axis,
                segment.Distance,
                segment.DurationMs,
                KC.EAxis.Y,
                segment.StartYawDeg,
                segment.EndYawDeg))
            .ToArray();
        var result = ItemKinematicEntityTemplate.ConfigureDrawnPathBestEffort(entry.Prefab, firstConstraint, entry.PrefabPath, authoredSegments);
        if (!result.Success)
        {
            errorMessage = "Could not convert drawn path to motion: " + result.Reason;
            return;
        }

        drawPathCaptureEnabled = false;
        await JS.InvokeVoidAsync("setDrawPathMode", false, 0f);
        errorMessage = null;
        drawPathStatusMessage = $"Converted drawn path to {result.Value} chained segment(s) using translation + yaw rotation for tighter curve tracking.";

        geometryCache.Clear();
        uploadedGeometry.Clear();
        authoredMotionScene = ReadSelectedScene();
        authoredConstraints.Clear();
        authoredConstraints.AddRange(authoredMotionScene.Handles.Sources.Values.OfType<KC>());
        await UpdateScenePayload(authoredMotionScene);
        await RefreshDebugDiagnostics();
        StateHasChanged();
    }

    private async Task ApplyPathPreset()
    {
        if (authoredConstraints.Count == 0 || authoredMotionScene is null)
            return;

        var firstConstraint = authoredConstraints[0];
        var entry = authoredMotionScene.Handles.Entries.FirstOrDefault(handle => ReferenceEquals(handle.Entry.Model, firstConstraint));
        if (entry is null) return;

        var axis1 = pathSegment1Axis.ToLowerInvariant() switch
        {
            "x" => KC.EAxis.X,
            "y" => KC.EAxis.Y,
            "z" => KC.EAxis.Z,
            _ => KC.EAxis.X
        };
        var axis2 = pathSegment2Axis.ToLowerInvariant() switch
        {
            "x" => KC.EAxis.X,
            "y" => KC.EAxis.Y,
            "z" => KC.EAxis.Z,
            _ => KC.EAxis.Y
        };
        var dur1Ms = Math.Max(50, (int)(pathSegment1Duration * 1000));
        var dur2Ms = Math.Max(50, (int)(pathSegment2Duration * 1000));

        switch (pathPresetMode)
        {
            case "relay":
            {
                var result = ItemKinematicEntityTemplate.ConfigureRelayCollisionPath(
                    entry.Prefab, firstConstraint, entry.PrefabPath,
                    axis1, pathSegment1Distance, dur1Ms,
                    axis2, pathSegment2Distance, dur2Ms);
                if (result.Success)
                    pathStatusMessage = "A ➔ B ➔ C relay path generated with 100% Havok collision!";
                else
                    errorMessage = "Error generating relay path: " + result.Reason;
                break;
            }
            case "handover":
            {
                var result = ItemKinematicEntityTemplate.ConfigureParkedHandoverCollisionPath(
                    entry.Prefab, firstConstraint, entry.PrefabPath,
                    axis1, pathSegment1Distance, dur1Ms,
                    axis2, pathSegment2Distance, dur2Ms);
                if (result.Success)
                    pathStatusMessage = "Occluder / parked handover L-path generated with 100% Havok collision!";
                else
                    errorMessage = "Error generating handover path: " + result.Reason;
                break;
            }
            case "chained":
            {
                var result = ItemKinematicEntityTemplate.ConfigureChainedLPath(
                    entry.Prefab, firstConstraint, entry.PrefabPath,
                    axis1, pathSegment1Distance, dur1Ms,
                    axis2, pathSegment2Distance, dur2Ms, pathIsPingPong);
                if (result.Success)
                    pathStatusMessage = "Smooth L-path generated (visually smooth, collision on main axis).";
                else
                    errorMessage = "Error generating chained path: " + result.Reason;
                break;
            }
            case "single_axis":
            {
                var result = ItemKinematicEntityTemplate.ConfigureSingleAxisMotion(
                    firstConstraint, axis1, pathSegment1Distance, dur1Ms, pathIsPingPong);
                if (result.Success)
                    pathStatusMessage = "1-axis linear motion configured with 100% Havok collision!";
                break;
            }
            case "rotation":
            {
                var result = ItemKinematicEntityTemplate.ConfigureRotationMotion(
                    firstConstraint, axis1, 0, 360, dur1Ms, isOscillating: false);
                if (result.Success)
                    pathStatusMessage = "Rotation motion configured with 100% Havok collision!";
                break;
            }
        }

        geometryCache.Clear();
        uploadedGeometry.Clear();
        authoredMotionScene = ReadSelectedScene();
        authoredConstraints.Clear();
        authoredConstraints.AddRange(authoredMotionScene.Handles.Sources.Values.OfType<KC>());
        await UpdateScenePayload(authoredMotionScene);
        await RefreshDebugDiagnostics();
        StateHasChanged();
    }

